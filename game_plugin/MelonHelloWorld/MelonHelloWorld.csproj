<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MiniMotorwaysMelonHelloWorld</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Mini Motorways</GameDir>
    <MelonNet472Dir>$(GameDir)\MelonLoader\net472</MelonNet472Dir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonNet472Dir)\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonNet472Dir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AssetRipper.Primitives">
      <HintPath>$(MelonNet472Dir)\AssetRipper.Primitives.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
