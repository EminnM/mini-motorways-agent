using System;
using System.Collections;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Runtime.InteropServices;
using System.Text;
using UnityEngine;
using UnityEngine.SceneManagement;
using Motorways;
using Motorways.Models;
using Motorways.Views;
using Motorways.Commands;
using Client;
using Server;
using FixMath;

// Doorstop's contract (Phase 0/3 TOOLCHAIN.md): any managed assembly with a
// `static void Doorstop.Entrypoint.Start()` method can be pointed to directly via
// doorstop_config.ini's `target_assembly`. This deliberately bypasses BepInEx (and
// therefore Harmony/MonoMod) entirely -- no BepInEx, Harmony, or MonoMod assembly
// is referenced by this project at all. This is Phase 3D's minimal-bootstrap test.
namespace Doorstop
{
    public static class Entrypoint
    {
        // System.Diagnostics.Process.Id's getter is missing from this stripped
        // mscorlib (confirmed live: MissingMethodException on first attempt). Per
        // Phase 3D's hard constraint against further mscorlib patching, this is
        // worked around in our OWN code instead, via a direct kernel32 P/Invoke.
        [DllImport("kernel32.dll")]
        private static extern int GetCurrentProcessId();

        // Same MINI_MOTORWAYS_IPC_DIR-style override for the log file itself --
        // running two game processes at once (per explicit user request, to debug
        // one while training continues on the other) would otherwise interleave
        // both processes' log lines into one file, confusing in exactly these
        // "search the log for X" diagnostic workflows.
        private static readonly string LogPath =
            Environment.GetEnvironmentVariable("MINI_MOTORWAYS_LOG_PATH")
            ?? @"C:\Users\TKA\Desktop\mini moto\logs\instrumentation.log";

        private static void WriteLine(string message)
        {
            try
            {
                Directory.CreateDirectory(Path.GetDirectoryName(LogPath));
                string line = $"[{DateTime.Now:yyyy-MM-dd HH:mm:ss.fff}] {message}";
                File.WriteAllText(LogPath, ReadExistingOrEmpty() + line + Environment.NewLine);
            }
            catch
            {
                // Never let logging failures affect the game itself.
            }
        }

        private static string ReadExistingOrEmpty()
        {
            try
            {
                return File.Exists(LogPath) ? File.ReadAllText(LogPath) : string.Empty;
            }
            catch
            {
                return string.Empty;
            }
        }

        public static void Start()
        {
            try
            {
                int pid = GetCurrentProcessId();

                WriteLine("=== MiniMotorwaysBootstrap: Doorstop.Entrypoint.Start() invoked directly (no BepInEx, no Harmony, no MonoMod) ===");
                WriteLine("[MiniMotorwaysAI] bootstrap executed");
                WriteLine($"Process ID: {pid}");
                WriteLine($"Executing assembly: {Assembly.GetExecutingAssembly().FullName}");
                WriteLine($"Executing assembly location: {Assembly.GetExecutingAssembly().Location}");

                // Read-only, informational only: confirm the game's own App.dll is
                // reachable from this bootstrap context, without touching it.
                try
                {
                    Assembly appAssembly = Assembly.Load("App");
                    WriteLine($"App.dll assembly identity: {appAssembly.FullName}");
                }
                catch (Exception ex)
                {
                    WriteLine($"App.dll load attempt failed (informational only): {ex.Message}");
                }

                // Phase 4: Doorstop.Entrypoint.Start() runs far too early (before
                // Unity's scene system is ready) to call FindObjectOfType directly.
                // SceneManager.sceneLoaded is a standard public .NET event -- not a
                // patch of any existing method -- subscribing to it is a completely
                // safe, well-known way to defer our read-only probe until Unity's
                // engine and at least one scene are actually ready.
                SceneManager.sceneLoaded += OnSceneLoaded;
                WriteLine("Subscribed to SceneManager.sceneLoaded (standard public event, no patching) to defer live object probe.");

                WriteLine("=== MiniMotorwaysBootstrap: Start() completed without throwing ===");
            }
            catch (Exception ex)
            {
                WriteLine($"EXCEPTION in Start(): {ex}");
            }
        }

        private static bool _simulationFound = false;

        // Phase 4 read-only probe: walk AppRuntime -> IApp -> Game -> ISimulation,
        // the exact chain identified by decompiling AppRuntime.cs, IApp.cs, and
        // Game.cs (see research/PHASE_4.md). Every member accessed below is a public
        // property already exposed by the game's own code -- nothing is patched,
        // no private field is reached via reflection, and no method that mutates
        // state (Step(), ScheduleCommand(), etc.) is ever called.
        private static void OnSceneLoaded(Scene scene, LoadSceneMode mode)
        {
            if (_simulationFound)
            {
                return;
            }

            try
            {
                WriteLine($"SceneManager.sceneLoaded fired: mode={mode}");

                AppRuntime appRuntime = UnityEngine.Object.FindObjectOfType<AppRuntime>();
                if (appRuntime == null)
                {
                    WriteLine("AppRuntime not found in this scene yet.");
                    return;
                }
                WriteLine($"AppRuntime found: {appRuntime.GetType().FullName}");

                // AppRuntime exists as soon as its GameObject is created, but its
                // own Unity Start() (which calls _container.CreateApp(), setting the
                // App property) may not have run yet in the same frame this
                // sceneLoaded event fires. Rather than patch anything to detect
                // that, hand off to a plain MonoBehaviour polling on Update() --
                // completely standard Unity object composition, not a hook of any
                // existing method.
                _simulationFound = true; // stop retrying via further scene loads; the poller takes over
                SceneManager.sceneLoaded -= OnSceneLoaded;

                GameObject pollerObject = new GameObject("MiniMotorwaysAI_Phase4Poller");
                UnityEngine.Object.DontDestroyOnLoad(pollerObject);
                SimulationPoller poller = pollerObject.AddComponent<SimulationPoller>();
                poller.AppRuntimeRef = appRuntime;
                WriteLine("Created polling MonoBehaviour (standard AddComponent, no patching) to wait for App/Game/Simulation to become available.");

                // Phase 5B: runs independently of the Phase 4B poller above. Does not
                // require a manually-started session -- it constructs its own
                // isolated MotorwaysGame via the game's own DI container, never
                // touching GameContainerScreen/ScreenStack, so whatever (if
                // anything) the Phase 4B poller observes is left completely
                // undisturbed.
                GameObject phase7aObject = new GameObject("MiniMotorwaysAI_Phase9A");
                UnityEngine.Object.DontDestroyOnLoad(phase7aObject);
                Phase9ARunner runner = phase7aObject.AddComponent<Phase9ARunner>();
                runner.AppRuntimeRef = appRuntime;
                WriteLine("Created Phase9ARunner MonoBehaviour to attempt process init + one native road-add/remove smoke test + a reset-leak check episode.");
            }
            catch (Exception ex)
            {
                WriteLine($"EXCEPTION in OnSceneLoaded probe: {ex}");
            }
        }

        // Plain MonoBehaviour, added to a new GameObject via the standard public
        // AddComponent<T>() API. Its Update() is invoked by Unity's own engine loop
        // like any other script's -- this is not a hook or patch of any existing
        // type or method.
        //
        // Phase 4B: waits (with a generous real-time budget, since a human now needs
        // to manually start/resume a city through the normal menu) for
        // Game.Simulation to become non-null, then switches to a sampling mode that
        // reads ONE scalar (ClockModel.Time, via the game's own public Scope.Get<T>()
        // resolver -- not a new object, the same DI-scope-shared instance documented
        // in ARCHITECTURE.md) several times over real time, to demonstrate the value
        // actually advancing as the real game runs. No method that mutates state is
        // ever called: only property/field reads (Simulation, Scope, Get<T>(), Time).
        private class SimulationPoller : MonoBehaviour
        {
            public AppRuntime AppRuntimeRef;

            private const float WaitBudgetSeconds = 300f; // 5 minutes of real time to manually start/resume a city
            private const int SampleCount = 12;
            private const float SampleIntervalSeconds = 2f;

            private float _waitStartTime;
            private float _lastProgressLogTime;
            private bool _simulationFound;
            private object _firstSimulationRef;
            private int _samplesTaken;
            private float _lastSampleTime;

            private void Start()
            {
                _waitStartTime = Time.realtimeSinceStartup;
                _lastProgressLogTime = _waitStartTime;
            }

            private void Update()
            {
                try
                {
                    if (!_simulationFound)
                    {
                        WaitForSimulation();
                    }
                    else
                    {
                        TakeSamples();
                    }
                }
                catch (Exception ex)
                {
                    WriteLine($"EXCEPTION in SimulationPoller.Update(): {ex}");
                    Destroy(gameObject);
                }
            }

            private void WaitForSimulation()
            {
                float now = Time.realtimeSinceStartup;
                IApp app = AppRuntimeRef != null ? AppRuntimeRef.App : null;
                Game game = app?.Game;
                Server.ISimulation simulation = game?.Simulation;

                if (simulation != null)
                {
                    _simulationFound = true;
                    _firstSimulationRef = simulation;
                    _lastSampleTime = now;

                    WriteLine("[MiniMotorwaysAI] simulation reference obtained");
                    WriteLine($"Real seconds waited for an active city session: {now - _waitStartTime:F1}");
                    WriteLine($"IApp resolved: {app.GetType().FullName}");
                    WriteLine($"Game resolved: {game.GetType().FullName}");
                    WriteLine($"ISimulation concrete type: {simulation.GetType().FullName}");
                    WriteLine($"ISimulation runtime hash (identity check across future samples): {System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(simulation)}");
                    WriteLine($"Simulation.Timestep: {simulation.Timestep}");
                    WriteLine($"Simulation.IsPaused: {simulation.IsPaused}");
                    WriteLine($"Simulation.HasAnyScheduledCommands: {simulation.HasAnyScheduledCommands}");
                    WriteLine($"Game.Scope resolved type: {game.Scope?.GetType().FullName ?? "null"}");

                    try
                    {
                        ClockModel clock = game.Scope?.Get<ClockModel>();
                        WriteLine($"ClockModel resolved via Game.Scope.Get<ClockModel>(): {(clock != null ? clock.GetType().FullName : "null")}");
                        if (clock != null)
                        {
                            WriteLine($"Sample #0 @ realtime+{now - _waitStartTime:F1}s: ClockModel.Time = {clock.Time}");
                        }
                    }
                    catch (Exception ex)
                    {
                        WriteLine($"ClockModel read failed (informational only): {ex.Message}");
                    }

                    WriteLine("Switching to sampling mode to demonstrate the value changes as the real game runs...");
                    return;
                }

                if (now - _lastProgressLogTime >= 10f)
                {
                    _lastProgressLogTime = now;
                    WriteLine($"Still waiting for a city session (elapsed {now - _waitStartTime:F0}s / budget {WaitBudgetSeconds:F0}s): App={(app != null)}, Game={(game != null)}");
                }

                if (now - _waitStartTime >= WaitBudgetSeconds)
                {
                    WriteLine($"Gave up waiting for Game.Simulation after {now - _waitStartTime:F0}s. App={(app != null)}, Game={(game != null)}.");
                    Destroy(gameObject);
                }
            }

            private void TakeSamples()
            {
                float now = Time.realtimeSinceStartup;
                if (now - _lastSampleTime < SampleIntervalSeconds)
                {
                    return;
                }
                _lastSampleTime = now;

                IApp app = AppRuntimeRef != null ? AppRuntimeRef.App : null;
                Game game = app?.Game;
                Server.ISimulation simulation = game?.Simulation;

                _samplesTaken++;

                if (simulation == null)
                {
                    WriteLine($"Sample #{_samplesTaken}: Game.Simulation became null (city session ended?). Stopping.");
                    Destroy(gameObject);
                    return;
                }

                bool sameInstance = ReferenceEquals(simulation, _firstSimulationRef);
                object clockValue = null;
                try
                {
                    ClockModel clock = game.Scope?.Get<ClockModel>();
                    clockValue = clock?.Time;
                }
                catch (Exception ex)
                {
                    WriteLine($"Sample #{_samplesTaken}: ClockModel read failed: {ex.Message}");
                }

                WriteLine($"Sample #{_samplesTaken} @ realtime+{now - _waitStartTime:F1}s: sameInstanceAsFirst={sameInstance}, IsPaused={simulation.IsPaused}, ClockModel.Time={clockValue}");

                if (_samplesTaken >= SampleCount)
                {
                    WriteLine("[MiniMotorwaysAI] sampling complete");
                    Destroy(gameObject);
                }
            }
        }

        // Phase 5C: native session lifecycle / reset proof, continuing Phase 5B.
        // Constructs an ISOLATED MotorwaysGame via the exact same DI call the game
        // itself uses (_appScope.Get<MotorwaysGame>(), confirmed in
        // GameContainerScreen.TransitionIn -- see research/PHASE_5A.md), repeated
        // with controlled seeds, each one torn down via the exact stock release
        // sequence from GameContainerScreen.ReleaseGame() before the next is
        // constructed. Never touches GameContainerScreen, ScreenStack, or whatever
        // (if anything) the Phase 4B poller is separately observing.
        //
        // Phase 5C changes from Phase 5B, per research/PHASE_5B.md's findings:
        //  (A) GameMode.Background instead of GameMode.Normal, to test whether this
        //      avoids the CameraView NullReferenceException (BackgroundGameRules.
        //      ShowsUI() -> false -> GameRules.UseCamera() -> false). NOTE: a
        //      GameRules diff (see research/PHASE_5C.md) found Background mode
        //      changes real gameplay semantics (demand caps, upgrade pacing,
        //      CanInteract, playable-area bounds, spawn variation) -- this is a
        //      mechanism proof only, NOT a mode suitable for actual RL training.
        //  (B) Explicitly call the existing public, idempotent
        //      CityDefinition.CompileTilemap() right after instantiating the
        //      prefab, instead of guessing at a frame-count wait -- confirmed via
        //      decompilation that CompileTilemap() is exactly what City.Definition's
        //      setter calls internally, and it is safe to call early since it's
        //      idempotent (guarded by a private _isCompiled flag).
        private class Phase9ARunner : MonoBehaviour
        {
            public AppRuntime AppRuntimeRef;

            private void Start()
            {
                StartCoroutine(RunLifecycleProof());
            }

            // Phase 10: poll for one new IPC request file per real Unity frame, on
            // the MAIN THREAD. File-based IPC (not TCP) by deliberate choice: an
            // earlier TCP-socket version of this bridge caused the game process to
            // stall for several minutes before even reaching its first
            // SceneManager.sceneLoaded event, reproducibly, only on builds that
            // referenced System.Net.Sockets -- consistent with antivirus/real-time
            // protection doing deep inspection of a freshly-built, unsigned DLL
            // that opens a network listener. Plain file read/write (the SAME
            // System.IO this bootstrap already uses for its own log file, with no
            // new APIs introduced) does not trigger that, and sidesteps the need
            // for a Windows Defender exclusion entirely. See PollIpcRequestFile
            // below for the request/response file protocol.
            private int _ipcPauseReassertions;
            private int _muteFrameCounter;
            private static readonly bool _allowSound = Environment.GetEnvironmentVariable("MINI_MOTORWAYS_UNMUTE") == "1";

            // Global mute (user request: the game is too loud). AudioListener lives in
            // UnityEngine.AudioModule, which this bootstrap does not reference at
            // compile time -- set the static property reflectively. The game's own
            // audio system / settings can write the volume back, so re-assert it
            // about twice a second. MINI_MOTORWAYS_UNMUTE=1 keeps sound (e.g. for a
            // stream that should have audio).
            private int _ipcVisibleTickFailures;
            private float _ipcLastUpgradeAutoClose = -100f;
            private string _overlayEnvLine = "";
            private string _overlayTrainerLines = "";
            private GUIStyle _overlayStyle;

            // Training HUD (top-left): env line from the last STEP + trainer lines pushed by Python.
            private void OnGUI()
            {
                try
                {
                    if (!_ipcVisibleActive) return;
                    if (_overlayStyle == null)
                    {
                        _overlayStyle = new GUIStyle(GUI.skin.label);
                        _overlayStyle.fontSize = 16;
                        _overlayStyle.richText = false;
                        _overlayStyle.normal.textColor = Color.white;
                    }
                    string text = _overlayEnvLine + (string.IsNullOrEmpty(_overlayTrainerLines) ? "" : System.Environment.NewLine + _overlayTrainerLines);
                    if (string.IsNullOrEmpty(text)) return;
                    var shadow = new GUIStyle(_overlayStyle);
                    shadow.normal.textColor = Color.black;
                    GUI.Label(new Rect(11, 11, 900, 200), text, shadow);
                    GUI.Label(new Rect(10, 10, 900, 200), text, _overlayStyle);
                }
                catch (Exception) { }
            }

            private bool _muteLogged;
            private Type _gatTrackType;
            private System.Reflection.MethodInfo _findAll;
            private System.Reflection.PropertyInfo _gatMute;
            private int _muteTrackCount = -1;
            // The game mixes its own audio (G-Audio GATTrack.OnAudioFilterRead); Unity's
            // AudioListener is stripped in this build. Mute every GATTrack directly.
            private void EnforceMute()
            {
                if (_allowSound) return;
                if (++_muteFrameCounter % 15 != 0) return;
                try
                {
                    if (_gatTrackType == null)
                    {
                        foreach (var asm in AppDomain.CurrentDomain.GetAssemblies())
                        {
                            _gatTrackType = asm.GetType("GATTrack");
                            if (_gatTrackType != null) break;
                        }
                        if (_gatTrackType == null) { if (!_muteLogged) { _muteLogged = true; WriteLine("[Mute] GATTrack type NOT FOUND"); } return; }
                        _gatMute = _gatTrackType.GetProperty("Mute", BindingFlags.Public | BindingFlags.Instance);
                        _findAll = typeof(Resources).GetMethod("FindObjectsOfTypeAll", new Type[] { typeof(Type) });
                    }
                    if (_findAll == null || _gatMute == null) { if (!_muteLogged) { _muteLogged = true; WriteLine("[Mute] missing findAll/Mute"); } return; }
                    var objs = _findAll.Invoke(null, new object[] { _gatTrackType }) as Array;
                    int n = objs != null ? objs.Length : 0;
                    for (int i = 0; i < n; i++) _gatMute.SetValue(objs.GetValue(i), true, null);
                    if (n != _muteTrackCount) { _muteTrackCount = n; WriteLine("[Mute] GATTracks muted: " + n); }
                }
                catch (Exception ex) { if (!_muteLogged) { _muteLogged = true; WriteLine("[Mute] EXCEPTION " + ex.Message); } }
            }

            private void Update()
            {
                EnforceMute();
                // Continuous clock-ownership enforcement for visible mode. Setting
                // Simulation.IsPaused=true once at attach is NOT enough: stock flows
                // queue their own unpause commands (confirmed live: the week-end
                // GameUpgradeScreen's close path resumed the game after the model's
                // upgrade claim, the sim then FREE-RAN in real time with no one
                // managing the city, destinations overcrowded, and the native game
                // over fired). Any such leak is re-asserted away here every frame.
                // AdvanceSimulation's unpause window is synchronous within one
                // main-thread slice, so this can never interleave with it. Worst
                // case a leaked unpause survives part of one frame (~0.1s once),
                // never free-running.
                try
                {
                    if (!_ipcFreePlay && !_ipcRealtimeWindow && _ipcVisibleActive && _ipcGame != null && _ipcGame.Simulation != null && !_ipcGame.Simulation.IsPaused)
                    {
                        _ipcGame.Simulation.IsPaused = true;
                        _ipcPauseReassertions++;
                        if (_ipcPauseReassertions <= 5 || _ipcPauseReassertions % 100 == 0)
                        {
                            WriteLine($"[Phase10] Re-asserted Simulation.IsPaused=true (a stock flow unpaused the attached game outside our stepping window; occurrence #{_ipcPauseReassertions}).");
                        }
                    }
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase10] EXCEPTION re-asserting pause ownership: {ex}");
                }

                // Stray-screen guard (trainer mode): the stack is parked at
                // MainMenu by design; anything else on top (confirmed live: the
                // stock GameOver screen when the old 1-tick pre-emption leaked) only
                // blocks the VIEW -- gameplay and training continue underneath.
                // Hide it.
                if (_ipcVisibleActive && !_ipcFreePlay)
                {
                    try
                    {
                        ScreenStack ssStray = _ipcApp.Scope.Get<ScreenStack>();
                        IScreen strayTop = ssStray.HasVisibleScreens() ? ssStray.GetTopVisibleScreen() : null;
                        if (strayTop != null && !(strayTop is MainMenuScreen) && strayTop is MonoBehaviour strayMb && strayMb.gameObject.activeSelf)
                        {
                            strayMb.gameObject.SetActive(false);
                            WriteLine($"[Phase10] Stray screen hidden in trainer mode: {strayTop.GetType().Name} (stack stays parked; training unaffected).");
                        }
                    }
                    catch (Exception) { }
                }

                // Screen-free visible driver: WE tick the game with real frame
                // time (no GameContainerScreen hosts it any more). Paused Steps
                // advance simulated time by zero, so this drives ONLY views, HUD
                // timers and animation pacing -- and, in free play (sim unpaused),
                // full native real-time gameplay.
                if (_ipcVisibleActive && _ipcGame != null)
                {
                    try { _ipcGame.Tick(Time.deltaTime); }
                    catch (Exception ex)
                    {
                        _ipcVisibleTickFailures++;
                        if (_ipcVisibleTickFailures <= 3 || _ipcVisibleTickFailures % 300 == 0)
                            WriteLine($"[Phase10] EXCEPTION in visible per-frame game Tick (#{_ipcVisibleTickFailures}): {ex.Message}");
                    }

                    // Native camera framing, reasserted after the game tick: position
                    // and zoom come from the SAME native schedule the stock camera
                    // uses (City.GetCameraSizeAtTime + client playable-area center),
                    // so the view starts tight on the young city and expands over
                    // in-game time exactly like stock map growth. CameraView's own
                    // framing is bypassed only because it additionally offsets by the
                    // GameUIScreen letterbox rect, which has no laid-out size in
                    // screen-free mode and skews the center off-map (seen live as a
                    // mostly-black viewport). Free play keeps full native control.
                    if (!_ipcFreePlay)
                    {
                        try
                        {
                            City camCity = _ipcGame.Scope.Get<City>();
                            Fix64 expT = _ipcGame.Simulation.GetModel<ClockModel>().ExpansionTime;
                            Fix64 zoom = camCity.GetCameraSizeAtTime(expT);
                            RectFixed clientArea = camCity.GetClientPlayableAreaAtZoom(zoom);
                            GameCamera cam = _ipcApp.Scope.Get<GameCamera>();
                            var tp = cam.transform.position;
                            cam.transform.position = new Vector3((float)clientArea.Center.x, (float)clientArea.Center.y, tp.z);
                            cam.OrthographicSize = (float)zoom;
                        }
                        catch (Exception) { }
                    }
                }

                // Trainer-mode guard: close the stock week-end GameUpgradeScreen the
                // moment it opens, via its own stock close path. The model claims
                // choices through the action space (screen not needed), and leaving
                // it open is actively dangerous: our stepping does not pause for it
                // (stock does), so a native game over can land ON TOP of it -- a
                // stack state stock play can never produce -- and the inter-episode
                // unwind then transitions back INTO the dead session's upgrade
                // screen (user-observed: the previous session's option screen
                // lingering), poisoning the pooled screens and killing the next
                // episode. Free play keeps the screen for the human.
                try
                {
                    if (!_ipcFreePlay && _ipcVisibleActive && _ipcGame != null)
                    {
                        // Suppress the stock week-end screen PUSH entirely in trainer
                        // mode by pre-marking pending grants as "being handled":
                        // GameplayEventHandler only pushes the GameUpgradeScreen while
                        // pendingUpgradeChoices.Count > numChoicesMade, and that push
                        // condition is the counter's ONLY reader (verified across the
                        // decompiled sources). Necessary because the week-1 grant and
                        // an overcrowding game over can land on the SAME decision
                        // (confirmed live): the GameOver screen then stacks on top of
                        // the fresh upgrade screen before any claim or close can run,
                        // and that buried screen wedges every subsequent transition.
                        // The model still sees and claims choices through the action
                        // mask; SelectUpgradeCommand semantics are untouched.
                        try
                        {
                            UpgradeDatabaseModel upGuardModel = _ipcGame.Simulation.GetModel<UpgradeDatabaseModel>();
                            if (upGuardModel != null && upGuardModel.pendingUpgradeChoices != null
                                && upGuardModel.pendingUpgradeChoices.Count > upGuardModel.numChoicesMade)
                            {
                                WriteLine($"[Phase10] Suppressing stock GameUpgradeScreen push: numChoicesMade {upGuardModel.numChoicesMade} -> {upGuardModel.pendingUpgradeChoices.Count} (pending choices stay claimable via the action mask).");
                                upGuardModel.numChoicesMade = upGuardModel.pendingUpgradeChoices.Count;
                            }
                        }
                        catch (Exception) { }

                        ScreenStack ssGuard = _ipcApp.Scope.Get<ScreenStack>();
                        if (ssGuard.HasVisibleScreens() && ssGuard.GetTopVisibleScreen() is GameUpgradeScreen upGuard && !upGuard.IsTransitioningIn()
                            && Time.realtimeSinceStartup - _ipcLastUpgradeAutoClose > 1f)
                        {
                            _ipcLastUpgradeAutoClose = Time.realtimeSinceStartup;
                            upGuard.CloseScreenAfterSelection();
                            ssGuard.GetActiveScreen<GameContainerScreen>()?.SkipNextTransition();
                            WriteLine("[Phase10] Auto-closed the stock GameUpgradeScreen (trainer mode; the model claims upgrade choices via the action space).");
                        }
                    }
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase10] EXCEPTION auto-closing GameUpgradeScreen: {ex}");
                }

                try
                {
                    // Drain a few requests per frame: a synchronous STEP responds in
                    // ~15-20 ms and Python polls at 10 ms, so the next request often
                    // arrives within the same frame. Budgeted to stay responsive.
                    var swDrain = System.Diagnostics.Stopwatch.StartNew();
                    for (int drain = 0; drain < 8 && swDrain.ElapsedMilliseconds < 50; drain++)
                    {
                        long before = _ipcLastProcessedId;
                        PollIpcRequestFile();
                        if (_ipcLastProcessedId == before) break; // nothing new (or op went async)
                        if (_ipcOpInFlight) break;                // async op started; wait for frames
                        System.Threading.Thread.Sleep(4);         // give Python time to send the next one
                    }
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase10] EXCEPTION in PollIpcRequestFile: {ex}");
                }
            }

            // Phase 5F: process-lifetime atlas initialization, the second of the two
            // stock StartupScreen prerequisites identified so far (the first,
            // ActivePlayer/profile restore, was fixed in Phase 5E -- see
            // RestoreExistingPlayerProfile below). A background subagent decompiled
            // StartupScreen.cs end-to-end and confirmed: of everything that screen
            // does, only three objects are both (a) empty-by-default DI singletons and
            // (b) load-bearing for GameMode.Normal simulation/view correctness --
            // RoadTileAtlas, RailTileAtlas, BoatPathTileAtlas. Everything else
            // StartupScreen does (splash fade, resolution, theme/menu-background
            // cosmetics, analytics consent, the separate GameMode.Background menu-city,
            // screen-stack pushes) is frontend-only and specific to the normal
            // screen-stack boot flow this bypass does not go through anyway.
            //
            // RoadTileAtlas (Motorways/RoadTileAtlas.cs) is [Factory.Serializable(1)],
            // registered Binding.Scope/HeapAllocator (an empty POCO by default) --
            // confirmed via decompiling StartupScreen.cs's LoadAtlas/WaitForAtlasToLoad
            // stages that the ONLY real population path is importing serialized bytes
            // from the "roadtileatlas" asset bundle; RoadTileAtlas.Initialize() itself
            // is a non-functional editor-only stub (Log.Error(...), populates
            // nothing) and must not be relied on. AssetBundleUtility.LoadAsset<T> is
            // the existing PUBLIC, fully SYNCHRONOUS sibling of LoadAssetAsync (same
            // underlying AssetBundle.LoadFromFile, just blocking) -- confirmed via
            // decompiling AssetBundleUtility.cs -- so no coroutine host is needed here,
            // unlike the CityDefinition prefab load. IScope.Import<T>(BinaryReader) is
            // confirmed (by reading Factory/Assembler.cs's ImportUnsafe) to resolve the
            // object to deserialize into via the SAME context.Scope.Get(type) call
            // every other DI resolution uses -- for a Binding.Scope singleton like
            // RoadTileAtlas, that is the exact same instance app.Scope.Get<RoadTileAtlas>()
            // returns elsewhere, so Import populates the real singleton in place, not a
            // detached copy.
            //
            // RailTileAtlas and BoatPathTileAtlas are also empty Binding.Scope/
            // HeapAllocator singletons, but unlike RoadTileAtlas their Initialize() is
            // NOT a stub -- confirmed via full decompilation, it synchronously,
            // procedurally generates every RailTileDefinition/BoatPathTileDefinition
            // from the atlas's own [Dependency] IScope, with no asset bundle involved
            // at all. StartupScreen calls both unconditionally right after the
            // RoadTileAtlas import (StartupScreen.cs, WaitForAtlasToLoad stage) --
            // mirrored here in the same order.
            // Phase 9A (second correction): we no longer import/initialize these
            // atlases ourselves. StartupScreen's own stock LoadAtlas/WaitForAtlasToLoad
            // stage already does this exact work during a genuinely stock boot: by the
            // time WaitForStockFrontendBootComplete has confirmed a stable
            // MainMenuScreen, StartupScreen's full MainMenuSequence (StartFade ->
            // WaitForFadeToComplete -> LoadAtlas -> WaitForAtlasToLoad -> LoadMenuCity
            // -> Hold -> TransitionToMainMenu -> SimulateMenuCity) has already run to
            // completion, including this exact atlas-import step. Doing it again
            // ourselves would be exactly the kind of redundant/competing
            // re-initialization the user told us to stop doing. This is now a
            // READ-ONLY verification probe only.
            private bool VerifyAtlasesPopulatedByStock(IApp app)
            {
                WriteLine("[Phase9A] Verifying RoadTileAtlas/RailTileAtlas/BoatPathTileAtlas are already populated by StartupScreen's own stock boot sequence (read-only probes only -- no Import()/Initialize() calls of our own).");
                try
                {
                    RoadTileAtlas roadTileAtlas = app.Scope.Get<RoadTileAtlas>();
                    using (RoadTileSignature probeSignature = app.Scope.Get<RoadTileSignature>())
                    {
                        probeSignature.AddConnection(new RoadTileConnection(new RoadTileNode(TileDirection.South), new RoadTileNode(TileDirection.South)));
                        RoadTileDefinition probeDefinition = roadTileAtlas.GetDefinitionForSignature(probeSignature);
                        WriteLine($"[Phase9A] Readiness probe: RoadTileAtlas.GetDefinitionForSignature(south-south) = {(probeDefinition == null ? "NULL -- stock StartupScreen has not populated this atlas" : "non-null (populated by the stock boot)")}.");
                        if (probeDefinition == null)
                        {
                            return false;
                        }
                    }

                    RailTileAtlas railAtlas = app.Scope.Get<RailTileAtlas>();
                    RailTileDefinition railDefinition = railAtlas.GetDefinition(new RailTileConnection(TileDirection.North, TileUtilities.GetOppositeDirection(TileDirection.North)));
                    WriteLine($"[Phase9A] Readiness probe: RailTileAtlas.GetDefinition(North-South) = {(railDefinition == null ? "NULL" : "non-null")}.");
                    if (railDefinition == null)
                    {
                        return false;
                    }

                    BoatPathTileAtlas boatAtlas = app.Scope.Get<BoatPathTileAtlas>();
                    BoatPathTileDefinition boatDefinition = boatAtlas.GetDefinition(new BoatPathTileConnection(TileDirection.North, TileUtilities.GetOppositeDirection(TileDirection.North)));
                    WriteLine($"[Phase9A] Readiness probe: BoatPathTileAtlas.GetDefinition(North-South) = {(boatDefinition == null ? "NULL" : "non-null")}.");
                    if (boatDefinition == null)
                    {
                        return false;
                    }
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] Atlas readiness probe threw: {ex}");
                    return false;
                }

                WriteLine("[Phase9A] All three atlases confirmed populated entirely by the stock boot sequence.");
                return true;
            }

            // Phase 9A (second correction): wait for a COMPLETELY stock frontend boot
            // -- LoadingScreen -> StartupScreen -> MainMenuScreen -- with zero
            // intervention of our own, before doing anything (no manual atlas init, no
            // test-player creation). The two prior attachment failures were both
            // caused by intervening while StartupScreen's own stage machine was still
            // mid-flight (its _menuGame/atlas-load/audio state only partially
            // initialized). Rather than diagnosing or repairing any individual
            // StartupScreen prerequisite, we now simply wait for the strongest
            // available stock ScreenStack signal that the ENTIRE sequence has finished
            // naturally: a stable (non-transitioning) MainMenuScreen is active, and
            // both StartupScreen and LoadingScreen have left the active screen stack.
            // Per StartupScreen's own MainMenuSequence array (LoadAtlas ->
            // WaitForAtlasToLoad -> LoadMenuCity -> Hold -> TransitionToMainMenu ->
            // SimulateMenuCity, confirmed by decompilation), MainMenuScreen can only
            // ever be pushed AFTER LoadMenuCity has already constructed _menuGame --
            // so this signal is also sufficient proof that _menuGame exists, without
            // reflecting into it directly.
            // The human's actual profile id (stable on this machine -- the same id the
            // persistence-isolation hash checks verify: extendedUserProfile_<id>.json
            // etc.). Used ONLY to detect and undo a boot hijack where
            // PlayerDatabase.MostRecentPlayer resolves to a leftover disposable test
            // profile; never written to, never activated for gameplay by us beyond
            // restoring the stock boot's intended state.
            private const string RealPlayerId = "451e710aba7246fdb57170f197f21b1e";

            private IEnumerator WaitForStockFrontendBootComplete(IApp app, Action<bool> onResult)
            {
                ScreenStack screenStack;
                try
                {
                    screenStack = app.Scope.Get<ScreenStack>();
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] Failed to resolve ScreenStack while waiting for stock boot: {ex}");
                    onResult(false);
                    yield break;
                }

                // CORRECTION (live evidence from the first attempt at this wait):
                // GetActiveScreen<T>() searches ScreenStack's internal _activeScreens
                // list, which holds every screen instance that has EVER been enabled
                // (screens are pooled/reused) -- StartupScreen and LoadingScreen never
                // leave it, so "GetActiveScreen<StartupScreen>() == null" never becomes
                // true and that compound signal timed out even though the real boot
                // had already finished. The correct, stock signal for "what the player
                // actually sees right now" is ScreenStack's separate _visibleScreens
                // list (exposed via the public GetTopVisibleScreen()/HasVisibleScreens()),
                // which StartScreenTransitions removes the outgoing screen from
                // IMMEDIATELY when a non-additive PushScreen happens (confirmed by
                // decompiling ScreenStack.StartScreenTransitions). TransitionToMainMenu
                // pushes MainMenuScreen non-additively, so the topmost visible screen
                // becoming MainMenuScreen is itself proof StartupScreen already handed
                // off -- no need to separately require StartupScreen/LoadingScreen to
                // vanish from the pooled _activeScreens list.
                WriteLine("[Phase9A] Waiting for a COMPLETELY STOCK frontend boot to finish on its own (LoadingScreen -> StartupScreen -> MainMenuScreen), with zero intervention from us. Signal: ScreenStack.GetTopVisibleScreen() is MainMenuScreen && !IsTransitioningIn().");

                float waitStart = Time.realtimeSinceStartup;
                float lastLog = waitStart;
                const float timeoutSeconds = 60f;
                bool stockBootComplete = false;
                bool bootHijackRescueAttempted = false;
                while (!stockBootComplete && Time.realtimeSinceStartup - waitStart < timeoutSeconds)
                {
                    IScreen topVisible = screenStack.HasVisibleScreens() ? screenStack.GetTopVisibleScreen() : null;
                    MainMenuScreen mainMenu = topVisible as MainMenuScreen;
                    stockBootComplete = mainMenu != null && !mainMenu.IsTransitioningIn();

                    // Boot-hijack rescue (root-caused live): LoadingScreen activates
                    // PlayerDatabase.MostRecentPlayer. A LEFTOVER bootstrap test
                    // profile becomes most-recent once a human plays on it (one manual
                    // tutorial session was enough), and a fresh-state profile routes
                    // the boot into the FTUX tutorial instead of the main menu --
                    // permanently, every boot, so this wait can never succeed again
                    // without intervention. Rescue: as soon as LoadingScreen's
                    // activation lands on a profile that is NOT the real player while
                    // the real player exists in the database, re-activate the real
                    // player via the SAME stock ActivatePlayer call, before
                    // StartupScreen routes to the tutorial. Isolation is unaffected:
                    // our own init still switches to a brand-new disposable test
                    // profile after the menu settles, and the real player's files are
                    // hash-verified as always.
                    if (!stockBootComplete && !bootHijackRescueAttempted)
                    {
                        try
                        {
                            ActivePlayer apNow = app.Scope.Get<ActivePlayer>();
                            if (apNow.HasActivePlayer && apNow.Player != null && apNow.Player.Id != RealPlayerId)
                            {
                                bootHijackRescueAttempted = true;
                                PlayerDatabase pdb = app.Scope.Get<PlayerDatabase>();
                                Player realPlayer = null;
                                foreach (Player p in pdb.Players)
                                {
                                    if (p != null && p.Id == RealPlayerId) { realPlayer = p; break; }
                                }
                                if (realPlayer != null)
                                {
                                    WriteLine($"[Phase9A] BOOT HIJACK DETECTED: LoadingScreen activated leftover profile Id={apNow.Player.Id} (MostRecentPlayer) instead of the real player. Re-activating the real player (Id={RealPlayerId}) via stock ActivatePlayer before StartupScreen routes into the FTUX tutorial.");
                                    apNow.ActivatePlayer(realPlayer);
                                }
                                else
                                {
                                    WriteLine($"[Phase9A] Boot activated profile Id={apNow.Player.Id}, and the real player Id={RealPlayerId} was NOT found in PlayerDatabase -- not intervening.");
                                }
                            }
                        }
                        catch (Exception ex) { WriteLine($"[Phase9A] EXCEPTION during boot-hijack check: {ex}"); }
                    }

                    // Second rescue arm (confirmed live): a session left in-progress by
                    // a crashed previous process AUTO-RESUMES at boot -- the stock
                    // flow goes straight into GameContainerScreen, so MainMenu never
                    // arrives. Exit via the stock quit-to-menu path (the same calls
                    // the pause menu's exit button makes): StopAudio, hide game UI,
                    // OnGameEnd(Exit), pop to MainMenu. The session's save persists
                    // exactly as with a normal player quit.
                    if (!stockBootComplete && topVisible is GameContainerScreen resumedScreen
                        && !resumedScreen.IsTransitioningIn() && Time.realtimeSinceStartup - waitStart > 8f
                        && !screenStack.AreAnyScreensTransitioning)
                    {
                        WriteLine("[Phase9A] BOOT AUTO-RESUME DETECTED: the stock boot resumed an in-progress session (left by a previous process) straight into GameContainerScreen. Exiting to the main menu via the stock quit-to-menu path.");
                        try
                        {
                            Game resumedGame = resumedScreen.GetActiveGame();
                            if (resumedGame != null)
                            {
                                try { resumedGame.StopAudio(); } catch (Exception) { }
                                try { resumedGame.Scope.Get<GameUIScreen>().SetUIVisible(visible: false, instantly: false, forceHide: true); } catch (Exception) { }
                                try { if (!(resumedGame is MotorwaysGame mg) || !mg.HasGameEnded) resumedGame.OnGameEnd(GameEndReason.Exit); } catch (Exception ex2) { WriteLine($"[Phase9A] EXCEPTION in boot-resume OnGameEnd: {ex2.Message}"); }
                            }
                            screenStack.PopToScreenOfType(ScreenStack.MotorwaysScreen.MainMenu, false);
                        }
                        catch (Exception ex)
                        {
                            WriteLine($"[Phase9A] EXCEPTION exiting auto-resumed session: {ex}");
                        }
                        // give the exit transition time before re-checking
                        float exitWait = Time.realtimeSinceStartup;
                        while (Time.realtimeSinceStartup - exitWait < 5f) yield return null;
                        continue;
                    }

                    if (!stockBootComplete)
                    {
                        if (Time.realtimeSinceStartup - lastLog > 5f)
                        {
                            lastLog = Time.realtimeSinceStartup;
                            WriteLine($"[Phase9A] Still waiting for stock boot completion (elapsed {Time.realtimeSinceStartup - waitStart:F1}s/{timeoutSeconds}s): topVisibleScreen={(topVisible != null ? topVisible.GetType().Name : "none")}" + (mainMenu != null ? $" (IsTransitioningIn={mainMenu.IsTransitioningIn()})" : "") + ".");
                        }
                        yield return null;
                    }
                }

                if (!stockBootComplete)
                {
                    WriteLine($"[Phase9A] Stock frontend boot did not reach a stable MainMenuScreen within {timeoutSeconds}s. Aborting -- we will not intervene before the stock lifecycle has genuinely completed.");
                    onResult(false);
                    yield break;
                }

                WriteLine($"[Phase9A] Stock frontend boot confirmed complete (MainMenuScreen is the topmost VISIBLE screen and has finished transitioning in) after {Time.realtimeSinceStartup - waitStart:F2}s. Safe to begin our own initialization now.");
                onResult(true);
            }

            // Phase 5F Task 4: process-lifetime initialization, performed ONCE per
            // process, never repeated per episode (profile/assets must not be
            // reloaded on every future Gym reset unless the stock architecture
            // requires it -- it doesn't: both the profile and the three atlases are
            // app-scope singletons, populated once, read many times).
            // Phase 8 persistence-isolation fix, root-caused via a live
            // PlayerChanged-event stack-trace diagnostic (not inferred): the earlier
            // approach of (1) doing our OWN "restore the real player" call, then (2)
            // immediately switching to a disposable test player, raced against the
            // STOCK game's own LoadingScreen, which is ticking concurrently on
            // Unity's normal per-frame loop regardless of what our bootstrap does.
            // LoadingScreen.Tick's one-shot player-activation block (gated by a
            // permanent-once-consumed `_hasActivatedPlayer` flag) INTENTIONALLY prunes
            // any player with no chosen avatar and either DateTime.MinValue last-
            // played time or zero recorded play time -- exactly what a freshly
            // CreatePlayer()'d test profile looks like -- via
            // `PlayerDatabase.DeletePlayer`, then reactivates `MostRecentPlayer`.
            // Confirmed live: this is a genuine, intentional stock invariant, not a
            // bug or an ordering artifact exclusive to our bootstrap.
            //
            // Fix: stop doing our own redundant "restore the real player" call
            // entirely (LoadingScreen already does the exact same restore on every
            // boot, unconditionally). Instead, passively wait for LoadingScreen's
            // one-shot activation to fire NATURALLY, confirmed via a STRONG signal
            // (the ActivePlayer.PlayerChanged event's own call stack containing
            // "LoadingScreen", not merely HasActivePlayer==true, which could in
            // principle be satisfied by some other activation). Only once that
            // one-shot gate has fired (and can therefore never prune anything again)
            // do we create+activate the disposable test player.
            private IEnumerator InitializeProcessContext(IApp app, Action<bool> onResult)
            {
                ActivePlayer activePlayer;
                try
                {
                    activePlayer = app.Scope.Get<ActivePlayer>();
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] Failed to resolve ActivePlayer from app.Scope: {ex}");
                    onResult(false);
                    yield break;
                }

                SubscribePlayerChangedDiagnostic(activePlayer);
                _expectedActivePlayerHash = System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(activePlayer);
                LogPlayerCheckpoint(app, "A-1 (before anything -- subscribed for diagnostics only, no restore/switch call of our own)");

                // Phase 9A (second correction): do NOT act on the LoadingScreen
                // PlayerChanged signal alone anymore. Wait for the ENTIRE stock
                // frontend boot (LoadingScreen -> StartupScreen -> MainMenuScreen) to
                // finish naturally first. The PlayerChanged subscription above is
                // still live throughout this wait, so LoadingScreen's one-shot
                // activation (which fires early, well before MainMenuScreen) will
                // still be captured into _lastPlayerChangedStackTrace for the
                // redundant confirmation below.
                bool stockBootComplete = false;
                yield return WaitForStockFrontendBootComplete(app, success => stockBootComplete = success);
                if (!stockBootComplete)
                {
                    onResult(false);
                    yield break;
                }

                bool stockActivationConfirmed = _sawLoadingScreenActivation
                    || (_lastPlayerChangedStackTrace != null && _lastPlayerChangedStackTrace.Contains("LoadingScreen"));
                if (!stockActivationConfirmed)
                {
                    WriteLine("[Phase9A] Stock boot reached a stable MainMenuScreen, but the LoadingScreen one-shot player-activation signal was never observed in the PlayerChanged stack trace. This should not be possible if the boot is genuinely stock. Aborting -- will not create a test profile without this confirmation.");
                    onResult(false);
                    yield break;
                }

                WriteLine($"[Phase9A] Both signals confirmed: stock LoadingScreen one-shot player activation fired (real player was active: Id={activePlayer.Player?.Id}), AND the full stock frontend boot reached a stable MainMenuScreen. Its pruning pass has already run and is permanently one-shot-consumed, and StartupScreen's own stage machine has fully completed -- safe to create the test player now.");
                LogPlayerCheckpoint(app, "A1 (after the COMPLETE stock frontend boot, before our test-player creation)");

                Player testPlayer;
                bool testProfileReady = SwitchToIsolatedTestProfile(app, out testPlayer);
                _isolationDiagnosticTestPlayer = testPlayer;
                if (!testProfileReady)
                {
                    WriteLine("[Phase9A] Could not create/activate an isolated test profile. STOPPING here rather than running any action-performing episode against the real profile.");
                    onResult(false);
                    yield break;
                }

                bool atlasesReady = VerifyAtlasesPopulatedByStock(app);
                onResult(atlasesReady);
            }

            // Stashed by InitializeProcessContext for the isolation canary (and for
            // the permanent AssertPersistenceIsolated gate for action-performing
            // episodes).
            private Player _isolationDiagnosticTestPlayer;
            private int _expectedActivePlayerHash;
            private string _lastPlayerChangedStackTrace;
            private bool _sawLoadingScreenActivation;
            private ActivePlayer _diagnosticSubscribedActivePlayer;
            private int _playerChangedEventCount;

            // Subscribes to the PUBLIC ActivePlayer.PlayerChanged event exactly once.
            // The handler logs a full managed stack trace at the moment the event
            // fires -- this is the authoritative evidence for WHO called
            // ActivatePlayer, not an inference from checkpoint timing. No game
            // assembly is modified; this is a plain C# event subscription available
            // to any external caller holding a reference to the object, identical in
            // kind to subscribing to a .NET UI control's Click event.
            private void SubscribePlayerChangedDiagnostic(ActivePlayer activePlayer)
            {
                if (activePlayer == null || ReferenceEquals(activePlayer, _diagnosticSubscribedActivePlayer)) return;
                activePlayer.PlayerChanged += OnPlayerChangedDiagnostic;
                _diagnosticSubscribedActivePlayer = activePlayer;
                WriteLine($"[Phase9A] [DIAG] Subscribed to ActivePlayer.PlayerChanged (hash={System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(activePlayer)}).");
            }

            // Trimmed down from the full stack-trace-every-time diagnostic (useful
            // for root-causing the LoadingScreen/pruning bug, now solved and
            // documented) to a permanent, lightweight audit line -- plus a full
            // stack-trace dump ONLY if something unexpected happens (the active
            // player changes to something other than our tracked test player AFTER
            // we've established one), which should never occur once isolation holds.
            private void OnPlayerChangedDiagnostic(Player oldPlayer, Player newPlayer)
            {
                _playerChangedEventCount++;
                string stackTrace;
                try { stackTrace = Environment.StackTrace; }
                catch (Exception ex) { stackTrace = $"(Environment.StackTrace threw: {ex.Message})"; }
                _lastPlayerChangedStackTrace = stackTrace;
                // Sticky: the boot-hijack rescue triggers a SECOND PlayerChanged whose
                // trace (ours) overwrites _lastPlayerChangedStackTrace, so the
                // "LoadingScreen one-shot fired" confirmation must latch at event time.
                if (stackTrace.Contains("LoadingScreen")) _sawLoadingScreenActivation = true;

                WriteLine($"[Phase9A] [DIAG] PlayerChanged #{_playerChangedEventCount}: oldPlayer.Id={oldPlayer?.Id ?? "null"} -> newPlayer.Id={newPlayer?.Id ?? "null"} " +
                    $"(frame={Time.frameCount}, realtime={Time.realtimeSinceStartup:F3}s).");

                bool unexpected = _isolationDiagnosticTestPlayer != null && newPlayer?.Id != _isolationDiagnosticTestPlayer.Id;
                if (unexpected)
                {
                    WriteLine($"[Phase9A] [DIAG] *** UNEXPECTED *** active player changed away from the test player after isolation was established. Full stack trace:\n{stackTrace}");
                }
            }

            // Logs the current ActivePlayer identity/state at a named lifecycle
            // checkpoint -- object hash, Player.Id, Unity frame count, and elapsed
            // real time, so the chronological PlayerChanged event log (authoritative)
            // can be cross-referenced against WHEN each checkpoint believed the
            // active player to be.
            private void LogPlayerCheckpoint(IApp app, string checkpointLabel)
            {
                try
                {
                    ActivePlayer ap = app.Scope.Get<ActivePlayer>();
                    int hash = System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(ap);
                    WriteLine($"[Phase9A] [CHECKPOINT {checkpointLabel}] ActivePlayer hash={hash}, Player.Id={ap?.Player?.Id ?? "null"}, frame={Time.frameCount}, realtime={Time.realtimeSinceStartup:F3}s.");
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] [CHECKPOINT {checkpointLabel}] FAILED to read ActivePlayer: {ex.Message}");
                }
            }

            // ==================== Persistence isolation diagnostic ====================
            // Read-only reflection helpers. Reading a private field via reflection is
            // NOT patching the game assembly -- nothing is modified, no method body is
            // rewritten, no Harmony/MonoMod hook is installed. This is the same kind
            // of introspection a debugger would do.
            private static object GetPrivateField(object obj, string fieldName)
            {
                if (obj == null) return null;
                var field = obj.GetType().GetField(fieldName, BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.Public);
                return field?.GetValue(obj);
            }

            // Diagnostic only (read-only reflection, same justification as every other
            // GetPrivateField use in this file): dumps ScreenStack's three private
            // bookkeeping lists so we can see exactly what differs between a pop that
            // leaves a stable MainMenuScreen visible and one that leaves zero visible
            // screens.
            private void DumpScreenStackState(ScreenStack ss, string label)
            {
                try
                {
                    var screenStack = GetPrivateField(ss, "_screenStack") as System.Collections.IList;
                    var activeScreens = GetPrivateField(ss, "_activeScreens") as System.Collections.IList;
                    var visibleScreens = GetPrivateField(ss, "_visibleScreens") as System.Collections.IList;
                    string Describe(System.Collections.IList list) => list == null ? "null" :
                        $"[{string.Join(",", list.Cast<object>().Select(o => o?.GetType().Name ?? "null"))}]";
                    WriteLine($"[Phase10][DIAG] ScreenStack state ({label}): _screenStack={Describe(screenStack)} _activeScreens={Describe(activeScreens)} _visibleScreens={Describe(visibleScreens)}");
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase10][DIAG] EXCEPTION dumping ScreenStack state ({label}): {ex}");
                }
            }

            private string DescribeActivePlayerIdentity(ActivePlayer ap, string label)
            {
                if (ap == null) return $"{label}: NULL ActivePlayer reference";
                int hash = System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(ap);
                Player p = ap.Player;
                return $"{label}: hash={hash}, HasActivePlayer={ap.HasActivePlayer}, Player.Id={(p != null ? p.Id : "null")}";
            }

            // Finds the live IProcess instance of the given type name inside the
            // running simulation's own process list, via reflection on
            // Server.Simulation's private `_processes` field (confirmed via
            // decompilation: `private readonly List<IProcess> _processes`). This
            // returns the SAME instance Simulation.Step() actually calls -- not a
            // fresh one pulled from the object pool by calling Get<T>() ourselves,
            // which could be a different pooled instance.
            private object FindProcessByTypeName(MotorwaysGame testGame, string typeName)
            {
                try
                {
                    object processesObj = GetPrivateField(testGame.Simulation, "_processes");
                    var list = processesObj as System.Collections.IEnumerable;
                    if (list == null) return null;
                    foreach (object process in list)
                    {
                        if (process != null && process.GetType().Name == typeName) return process;
                    }
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] FindProcessByTypeName({typeName}) threw: {ex.Message}");
                }
                return null;
            }

            // Reusable, permanent pre-action gate (per explicit user direction: this
            // must remain in place even after the isolation bug is solved). Checks,
            // for every simulation component we can reach via reflection, that its
            // `_player` field is REFERENCE-EQUAL to the bootstrap's own ActivePlayer
            // object AND that its current Player.Id matches the test player -- not
            // just "is some player active," but "is it literally the same object and
            // the same id." Logs every component checked; returns false (and must
            // abort any pending action) if anything disagrees.
            private bool AssertPersistenceIsolated(IApp app, Player expectedTestPlayer, MotorwaysGame testGame, string checkpointLabel)
            {
                // Quiet mode (throughput): a null label runs every check but logs
                // only failures -- the full per-checkpoint narration costs several
                // log-file writes per decision. Failure paths always log.
                bool quiet = checkpointLabel == null;
                if (quiet) checkpointLabel = "quiet-step-check";
                Action<string> Note = line => { if (!quiet) WriteLine(line); };
                bool allOk = true;
                ActivePlayer bootstrapAp = app.Scope.Get<ActivePlayer>();
                Note($"[Phase9A] [{checkpointLabel}] bootstrap: {DescribeActivePlayerIdentity(bootstrapAp, "ActivePlayer")}");
                if (bootstrapAp?.Player?.Id != expectedTestPlayer.Id)
                {
                    WriteLine($"[Phase9A] [{checkpointLabel}] ASSERTION FAILED: bootstrap ActivePlayer.Player.Id ({bootstrapAp?.Player?.Id}) != expected test player Id ({expectedTestPlayer.Id}).");
                    allOk = false;
                }

                int actualHash = System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(bootstrapAp);
                if (actualHash != _expectedActivePlayerHash)
                {
                    WriteLine($"[Phase9A] [{checkpointLabel}] ASSERTION FAILED: ActivePlayer hash ({actualHash}) != expected app-scope singleton hash ({_expectedActivePlayerHash}).");
                    allOk = false;
                }

                try
                {
                    PlayerDatabase playerDatabase = app.Scope.Get<PlayerDatabase>();
                    bool stillInDatabase = false;
                    foreach (Player p in playerDatabase.Players)
                    {
                        if (p.Id == expectedTestPlayer.Id) { stillInDatabase = true; break; }
                    }
                    Note($"[Phase9A] [{checkpointLabel}] test player still in PlayerDatabase.Players = {stillInDatabase}.");
                    if (!stillInDatabase)
                    {
                        WriteLine($"[Phase9A] [{checkpointLabel}] ASSERTION FAILED: test player no longer present in PlayerDatabase.Players (may have been pruned/deleted).");
                        allOk = false;
                    }
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] [{checkpointLabel}] PlayerDatabase.Players check threw: {ex.Message}");
                    allOk = false;
                }

                if (testGame != null)
                {
                    // TreeModel is an IModel -- read the REAL live instances via
                    // GetModels<T>(), not a freshly pooled one.
                    try
                    {
                        ModelList<TreeModel> trees = testGame.Simulation.GetModels<TreeModel>();
                        if (trees.Count > 0)
                        {
                            object treePlayerObj = GetPrivateField(trees[0], "_player");
                            ActivePlayer treePlayer = treePlayerObj as ActivePlayer;
                            bool sameInstance = ReferenceEquals(treePlayer, bootstrapAp);
                            Note($"[Phase9A] [{checkpointLabel}] TreeModel[0]._player: {DescribeActivePlayerIdentity(treePlayer, "ActivePlayer")}, ReferenceEquals(bootstrap)={sameInstance}");
                            if (!sameInstance || treePlayer?.Player?.Id != expectedTestPlayer.Id)
                            {
                                WriteLine($"[Phase9A] [{checkpointLabel}] ASSERTION FAILED: TreeModel._player mismatch.");
                                allOk = false;
                            }
                        }
                        else
                        {
                            WriteLine($"[Phase9A] [{checkpointLabel}] TreeModel: no instances exist yet in this simulation (nothing to check).");
                        }
                    }
                    catch (Exception ex)
                    {
                        WriteLine($"[Phase9A] [{checkpointLabel}] TreeModel check threw: {ex.Message}");
                    }

                    foreach (string processTypeName in new[] { "ReleaseMothballedLanesProcess", "AchievementCheckingProcess" })
                    {
                        try
                        {
                            object process = FindProcessByTypeName(testGame, processTypeName);
                            if (process == null)
                            {
                                WriteLine($"[Phase9A] [{checkpointLabel}] {processTypeName}: not found in simulation's process list.");
                                continue;
                            }
                            object playerObj = GetPrivateField(process, "_player");
                            ActivePlayer processPlayer = playerObj as ActivePlayer;
                            bool sameInstance = ReferenceEquals(processPlayer, bootstrapAp);
                            WriteLine($"[Phase9A] [{checkpointLabel}] {processTypeName}._player: {DescribeActivePlayerIdentity(processPlayer, "ActivePlayer")}, ReferenceEquals(bootstrap)={sameInstance}");
                            if (!sameInstance || processPlayer?.Player?.Id != expectedTestPlayer.Id)
                            {
                                WriteLine($"[Phase9A] [{checkpointLabel}] ASSERTION FAILED: {processTypeName}._player mismatch.");
                                allOk = false;
                            }
                        }
                        catch (Exception ex)
                        {
                            WriteLine($"[Phase9A] [{checkpointLabel}] {processTypeName} check threw: {ex.Message}");
                        }
                    }
                }

                WriteLine($"[Phase9A] [{checkpointLabel}] AssertPersistenceIsolated verdict: {(allOk ? "PASS" : "FAIL")}.");
                return allOk;
            }

            // Read-only diagnostic episode: construct -> Start -> warm-up -> a few
            // controlled steps -> teardown. NO ADD_ROAD/REMOVE_ROAD/any edit is
            // submitted. Identity is sampled at every requested lifecycle boundary
            // (C through H; A/B are logged inside SwitchToIsolatedTestProfile above).
            // The single controlled canary: stock boot completes -> test profile
            // created+activated (via the now-corrected InitializeProcessContext
            // ordering) -> construct/start one GameMode.Normal episode -> verify
            // isolation at every lifecycle boundary -> ONE setup ADD_ROAD (precondition
            // -- plain empty-tile adds do not themselves touch AchievementStatistics)
            // -> ONE deliberate, known stat-producing action (REMOVE_ROAD, confirmed in
            // Phase 7A/8 to reliably increment AchievementStatistics.TotalConcreteDeleted
            // via ReleaseMothballedLanesProcess.LogDeletedUpgrade) -> verify the stat
            // landed on the TEST player's in-memory AchievementStatistics -> teardown.
            // AssertPersistenceIsolated is called immediately before the action and
            // gates it: if it fails, the action is skipped entirely (abort-before-action).
            private IEnumerator RunPersistenceCanary(IApp app, CityDefinition cityDefinition, MapDefinition mapDefinition)
            {
                Player testPlayer = _isolationDiagnosticTestPlayer;
                WriteLine("[Phase9A] ===== Persistence isolation canary: ONE GameMode.Normal episode, ONE known stat-producing action =====");

                MotorwaysGame testGame = null;
                bool setupOk = false;
                try
                {
                    testGame = app.Scope.Get<MotorwaysGame>();
                    LogPlayerCheckpoint(app, "C3 (immediately after Get<MotorwaysGame>())");
                    setupOk = AssertPersistenceIsolated(app, testPlayer, null, "C3");

                    testGame.SetMapDefinition(mapDefinition);
                    global::Random.SetSimulationSeed(31337u, app.Scope);
                    LogPlayerCheckpoint(app, "D (after episode initialization, before Start())");
                    setupOk &= AssertPersistenceIsolated(app, testPlayer, testGame, "D");

                    testGame.Start(cityDefinition, GameMode.Normal, null);
                    LogPlayerCheckpoint(app, "E (after Start())");
                    setupOk &= AssertPersistenceIsolated(app, testPlayer, testGame, "E");

                    testGame.SetPaused(false, Plugins.Analytics.AnalyticsTypes.PauseReason.TransitionIn);
                    testGame.Tick(0f);
                    testGame.Tick(0f);
                    testGame.OnGameStarted();
                    LogPlayerCheckpoint(app, "E2 (after warm-up)");
                    setupOk &= AssertPersistenceIsolated(app, testPlayer, testGame, "E2");
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] EXCEPTION during canary construction/start: {ex}");
                    setupOk = false;
                }

                if (testGame != null && setupOk)
                {
                    try
                    {
                        AdvanceSimulation(testGame, 0.3);
                        WriteLine("[Phase9A] [F] After first controlled simulation step:");
                        setupOk &= AssertPersistenceIsolated(app, testPlayer, testGame, "F");
                    }
                    catch (Exception ex)
                    {
                        WriteLine($"[Phase9A] EXCEPTION at checkpoint F: {ex}");
                        setupOk = false;
                    }
                }

                if (testGame != null && setupOk)
                {
                    int totalConcreteDeletedBefore = -1;
                    try { totalConcreteDeletedBefore = app.Scope.Get<ActivePlayer>().AchievementStatistics.TotalConcreteDeleted; }
                    catch (Exception ex) { WriteLine($"[Phase9A] Failed reading TotalConcreteDeleted before action: {ex.Message}"); }

                    // Setup ADD (precondition for the removal -- plain empty-tile
                    // adds do not touch AchievementStatistics per Phase 8's own
                    // ownership-graph investigation; only TreeModel.OnTreeBulldozed
                    // and ReleaseMothballedLanesProcess.LogDeletedUpgrade do, and
                    // only the latter is reliably reachable without depending on
                    // landing on a tree tile).
                    var canaryCoord = new Vector2Int(5, 5);
                    const TileDirection canaryDirection = TileDirection.East;
                    string addInfo;
                    bool addOk = TryAddRoad(testGame, canaryCoord, canaryDirection, out addInfo);
                    WriteLine($"[Phase9A] Canary setup ADD_ROAD({canaryCoord.x},{canaryCoord.y},E): {addInfo}");
                    for (int i = 0; i < 10; i++) { yield return null; }
                    AdvanceSimulation(testGame, 0.3);

                    WriteLine("[Phase9A] [PRE-ACTION] Verifying isolation immediately before the ONE known stat-producing action:");
                    bool preActionOk = AssertPersistenceIsolated(app, testPlayer, testGame, "PRE-ACTION");

                    if (!addOk || !preActionOk)
                    {
                        WriteLine("[Phase9A] ABORTING before action: setup ADD failed or AssertPersistenceIsolated failed. Per the hard pre-action gate, the stat-producing REMOVE_ROAD will NOT be submitted.");
                    }
                    else
                    {
                        string removeInfo;
                        bool removeOk = TryClearTile(testGame, canaryCoord, out removeInfo);
                        WriteLine($"[Phase9A] Canary action REMOVE_ROAD({canaryCoord.x},{canaryCoord.y},E) (the ONE known stat-producing action): {removeInfo}");

                        for (int i = 0; i < 15; i++) { yield return null; }
                        AdvanceSimulation(testGame, 0.5);

                        WriteLine("[Phase9A] [POST-ACTION] Verifying ActivePlayer is still the test player after the action + processing:");
                        AssertPersistenceIsolated(app, testPlayer, testGame, "POST-ACTION");

                        try
                        {
                            int totalConcreteDeletedAfter = app.Scope.Get<ActivePlayer>().AchievementStatistics.TotalConcreteDeleted;
                            WriteLine($"[Phase9A] TEST player's in-memory AchievementStatistics.TotalConcreteDeleted: {totalConcreteDeletedBefore} -> {totalConcreteDeletedAfter} (delta={totalConcreteDeletedAfter - totalConcreteDeletedBefore}). " +
                                "This is read from whichever player is CURRENTLY active -- if isolation held, that is the test player, and this increment never reached the real player's object at all.");
                        }
                        catch (Exception ex)
                        {
                            WriteLine($"[Phase9A] Failed reading TotalConcreteDeleted after action: {ex.Message}");
                        }
                    }
                }
                else if (testGame != null)
                {
                    WriteLine("[Phase9A] Skipping the action entirely: setup/pre-conditions failed AssertPersistenceIsolated before any action was attempted.");
                }

                if (testGame != null)
                {
                    try
                    {
                        testGame.StopAudio();
                        testGame.ClearPathfinder();
                        testGame.Scope.ParentScope.Release(testGame);
                        WriteLine("[Phase9A] Canary episode teardown completed without throwing.");
                    }
                    catch (Exception ex)
                    {
                        WriteLine($"[Phase9A] EXCEPTION during canary teardown: {ex}");
                    }
                }

                WriteLine("[Phase9A] ===== Persistence isolation canary complete. =====");
            }

            // ==================== Phase 9A: Visible Environment ====================
            //
            // Static research (background subagent, independently cross-checked
            // against the decompiled source) established:
            //  - GameContainerScreen.PrepareForNewGame(..., existingGame, ...) ALSO
            //    sets _startGameOnTransition=true, so TransitionIn calls .Start() on
            //    the handed-off game UNCONDITIONALLY, with no guard. For a game we
            //    already .Start()ed ourselves, this is NOT safe: MotorwaysGame.Start's
            //    "already has a CityModel" branch skips re-running InitCityCommand,
            //    but everything below that branch still runs unconditionally --
            //    _simulation.Subscribe(_view) re-announces EVERY existing model to
            //    the view layer (ViewClient.OnModelAdded has no "already has a view"
            //    check), so a second Start() would construct a SECOND view object
            //    for every tile/road/vehicle already in the city. The stock
            //    save-resume flow never exercises this case (it only ever attaches a
            //    game that has never been .Start()ed).
            //  - The clean alternative, used here: let GameContainerScreen itself
            //    call .Start() for the first and only time, via PrepareForMap (the
            //    SAME entry point GameStarter uses for a genuinely fresh new game).
            //    We supply the CityDefinition/MapDefinition/GameMode and set the
            //    deterministic seed BEFORE pushing the screen (Start() internally
            //    calls Random.NextSimulationSeed() when building InitCityCommand,
            //    exactly as in every other phase). The resulting MotorwaysGame is
            //    then fetched back via GameContainerScreen.GetActiveGame() -- the
            //    SAME object the frontend is now rendering -- and handed to the
            //    UNCHANGED Phase 8 environment-core methods (EnumerateLegalActions/
            //    ApplyAction/AdvanceSimulation/BuildPolicyObservation/
            //    AssertPersistenceIsolated) exactly as RunPolicyEpisode already does.
            //  - CONFIRMED CRITICAL via decompilation: once GameContainerScreen is
            //    the active screen, App.Tick -> ScreenStack.Tick ->
            //    GameContainerScreen.Tick(realDeltaTime) -> _game.Tick(realDeltaTime)
            //    runs EVERY REAL FRAME, forever -- a second, real-frame-rate-driven
            //    clock that would race against our own direct ISimulation.Step()
            //    calls and violate the "controlled stepping is authoritative"
            //    invariant. The stock mitigation, used here: once the transition-in
            //    finishes, call the public GameContainerScreen.SetGameSuspended(true)
            //    -- this makes the screen's own Tick() skip its _game.Tick(deltaTime)
            //    call (ShouldTickGame() => !_gameSuspended), while the screen keeps
            //    rendering/compositing normally. From that point on, AdvanceSimulation
            //    (direct ISimulation.Step(), unchanged from Phase 8) is the ONLY thing
            //    that advances simulated time.
            private IEnumerator AttachGameToFrontend(IApp app, CityDefinition cityDefinition, MapDefinition mapDefinition, uint seed,
                Action<MotorwaysGame, GameContainerScreen> onAttached)
            {
                ScreenStack screenStack;
                try
                {
                    screenStack = app.Scope.Get<ScreenStack>();
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] Failed to resolve ScreenStack: {ex}");
                    onAttached(null, null);
                    yield break;
                }

                // Phase 9A (third correction): GetActiveScreen<StartupScreen>() will
                // almost certainly return the pooled StartupScreen instance here
                // regardless of boot state -- screens are pooled/reused and
                // ScreenStack's _activeScreens list never clears them (confirmed live
                // in WaitForStockFrontendBootComplete's first attempt). Its mere
                // presence is NOT the hazard. The actual root cause, confirmed by
                // decompiling StartupScreen.cs, is its private _menuGame field being
                // null when GameContainerScreen.TransitionIn calls StopMenuGameAudio()
                // on it. WaitForStockFrontendBootComplete already confirmed
                // MainMenuScreen is the stable, topmost VISIBLE screen -- and
                // StartupScreen.TransitionToMainMenu (the only stock path that pushes
                // MainMenuScreen) calls StartSimulatingMenuGame()/PlayMenuGameAudio()
                // on _menuGame immediately beforehand, so _menuGame is necessarily
                // already constructed by this point. The read-only reflective check
                // below is therefore the real hazard gate (based on the actual root
                // cause), not the presence check from the first correction attempt.
                StartupScreen activeStartupScreen = screenStack.GetActiveScreen<StartupScreen>();
                object menuGame = activeStartupScreen != null ? GetPrivateField(activeStartupScreen, "_menuGame") : null;
                WriteLine($"[Phase9A] Diagnostic: GetActiveScreen<StartupScreen>() = {(activeStartupScreen != null ? "non-null (pooled instance, expected regardless of boot state)" : "null")}, its _menuGame = {(menuGame != null ? "non-null (StopMenuGameAudio is safe)" : "NULL -- StopMenuGameAudio would NRE")}.");
                if (activeStartupScreen != null && menuGame == null)
                {
                    WriteLine("[Phase9A] UNEXPECTED: StartupScreen._menuGame is still null despite a stable, fully-transitioned-in MainMenuScreen. Aborting rather than risk the known StopMenuGameAudio NullReferenceException.");
                    onAttached(null, null);
                    yield break;
                }

                // Native seed-control entry point (unchanged from every prior phase):
                // MotorwaysGame.Start() internally calls Random.NextSimulationSeed()
                // when constructing InitCityCommand. Must be set BEFORE pushing the
                // screen, since GameContainerScreen.TransitionIn -- not us -- is the
                // one that will call .Start() this time.
                global::Random.SetSimulationSeed(seed, app.Scope);
                WriteLine($"[Phase9A] Called global::Random.SetSimulationSeed({seed}, app.Scope) before pushing the frontend screen.");

                GameContainerScreen attachedScreen = null;
                try
                {
                    screenStack.PushScreen<GameContainerScreen>(
                        ScreenStack.MotorwaysScreen.InGame,
                        s => { attachedScreen = s; s.PrepareForMap(cityDefinition, mapDefinition, GameMode.Normal, null, false); },
                        false, null, true, null);
                    WriteLine("[Phase9A] ScreenStack.PushScreen(InGame, PrepareForMap(...)) completed without throwing. Waiting for transition-in to finish (GameContainerScreen.TransitionIn will call MotorwaysGame.Start() internally)...");
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] EXCEPTION during PushScreen/PrepareForMap: {ex}");
                    onAttached(null, null);
                    yield break;
                }

                float waitStart = Time.realtimeSinceStartup;
                while (attachedScreen == null && Time.realtimeSinceStartup - waitStart < 10f)
                {
                    yield return null;
                }
                if (attachedScreen == null)
                {
                    WriteLine("[Phase9A] GameContainerScreen prep delegate never fired within 10s. Aborting attachment.");
                    onAttached(null, null);
                    yield break;
                }

                while (attachedScreen.IsTransitioningIn() && Time.realtimeSinceStartup - waitStart < 30f)
                {
                    yield return null;
                }
                WriteLine($"[Phase9A] Transition-in finished (IsTransitioningIn={attachedScreen.IsTransitioningIn()}) after {Time.realtimeSinceStartup - waitStart:F2}s.");

                MotorwaysGame attachedGame = attachedScreen.GetActiveGame() as MotorwaysGame;
                if (attachedGame == null)
                {
                    WriteLine("[Phase9A] GameContainerScreen.GetActiveGame() returned null or not a MotorwaysGame after transition-in. Aborting attachment.");
                    onAttached(null, attachedScreen);
                    yield break;
                }

                // Simulation-identity proof: confirm IApp.Game (what the stock
                // frontend considers "the" active game) is REFERENCE-EQUAL to the
                // object we're about to drive directly -- not merely the same type.
                bool sameAsAppGame = ReferenceEquals(app.Game, attachedGame);
                WriteLine($"[Phase9A] Simulation identity proof: attachedGame hash={System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(attachedGame)}, " +
                    $"Server.Simulation hash={System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(attachedGame.Simulation)}, " +
                    $"ReferenceEquals(app.Game, attachedGame)={sameAsAppGame} (app.Game hash={(app.Game != null ? System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(app.Game) : 0)}).");

                // Static trace of ScreenStack.cs: its own per-frame update detects
                // !IsTransitioningIn() and then BOTH adds the screen to
                // _visibleScreens AND calls OnTransitionedIn() (HUD finalization via
                // GameUIScreen.OnTransitionedIn, menu background-city shutdown via
                // StartupScreen.StopSimulatingMenuGame, OnPlayPressed), then clears
                // _screenTransitioningIn. We must NOT call OnTransitionedIn()
                // ourselves: that was tried, and it DOUBLE-fires -- ScreenStack still
                // holds _screenTransitioningIn and calls it AGAIN a frame later, and
                // that second OnPlayPressed queues an UNPAUSE command AFTER our pause
                // command, which leaked exactly one 0.1s simulation step (caught live
                // by the clock-ownership gate below). So: wait for ScreenStack's own
                // dispatch (observable as _screenTransitioningIn going null) instead
                // of racing it.
                {
                    float transitionedInWaitStart = Time.realtimeSinceStartup;
                    bool screenStackDispatched = false;
                    while (Time.realtimeSinceStartup - transitionedInWaitStart < 10f)
                    {
                        object transitioningIn = GetPrivateField(screenStack, "_screenTransitioningIn");
                        if (transitioningIn == null) { screenStackDispatched = true; break; }
                        yield return null;
                    }
                    WriteLine($"[Phase9A] Waited for ScreenStack's OWN per-frame update to dispatch OnTransitionedIn() (stock bookkeeping: _visibleScreens add + HUD finalization + menu background-city shutdown): dispatched={screenStackDispatched} after {Time.realtimeSinceStartup - transitionedInWaitStart:F2}s.");
                    if (!screenStackDispatched)
                    {
                        WriteLine("[Phase9A] Aborting attachment: ScreenStack never dispatched OnTransitionedIn for the pushed screen (unexpected mid-transition state).");
                        onAttached(null, attachedScreen);
                        yield break;
                    }
                }

                // Clock ownership via the STOCK PAUSE MECHANISM, replacing the earlier
                // SetGameSuspended(true) approach. Static trace of Game.Tick/
                // TimeInterval/Simulation.Step established:
                //   - Game.Tick(frameTime) accumulates UnpausedScaledDelta and calls
                //     Simulation.Step() as needed, THEN _view.Tick(timeInterval, ...)
                //     with the REAL Delta.
                //   - Simulation.Step() with IsPaused==true executes pending commands
                //     but steps the clock and every process by Fix64.Zero -- i.e. a
                //     paused game's per-frame ticks advance NOTHING (this is exactly
                //     the shipped pause-button behavior, not a trick).
                //   - GameUIScreen.Tick (HUD appear timers, clock/upgrade-bar fade-in,
                //     world-grid transition) consumes timeInterval.Delta -- REAL frame
                //     time, pause-independent. This is why the HUD could never appear
                //     under the old design: SetGameSuspended(true) stopped the screen's
                //     _game.Tick entirely and our per-decision Tick(0f) calls fed the
                //     UI a permanent delta of zero, so _uiAppearTimer never elapsed.
                // So: leave the screen UNsuspended (its stock per-frame _game.Tick
                // drives views/HUD/theme with real time), and PAUSE the game instead
                // (simulated time frozen). AdvanceSimulation unpauses the simulation
                // only around its own direct Step() calls -- synchronously, on the
                // main thread, so the screen's own Tick can never observe the
                // unpaused state. Controlled stepping remains the sole SIMULATED clock.
                try
                {
                    attachedGame.SetPaused(true, Plugins.Analytics.AnalyticsTypes.PauseReason.TransitionIn);
                    attachedGame.Simulation.IsPaused = true; // immediate; the SetPausedCommand confirms it on the next Step
                    WriteLine("[Phase9A] Game paused via stock SetPaused(true) (screen left UNsuspended): per-frame _game.Tick now drives views/HUD with real frame time but advances simulated time by zero; AdvanceSimulation (direct ISimulation.Step() inside an unpause window) is the sole simulated clock from here on.");
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] EXCEPTION pausing attached game: {ex}");
                }

                // Pause-settle window (measured live, per-frame diagnostics): the
                // stock pause lands via the command queue, and the FIRST screen Tick
                // after our SetPaused drains that queue -- during which exactly ONE
                // 0.1s Simulation.Step runs before the pause command takes effect
                // (simTime 0.0 -> 0.1 on idle frame 0, then IsPaused=True and frozen
                // on every subsequent frame, HasAnyScheduledCommands=False). That is
                // a one-time, bounded stock-pause handshake, not a competing clock.
                // Let it settle BEFORE taking the clock-ownership baseline: wait until
                // simTime is stable across consecutive frames (bounded at 30 frames).
                {
                    // The screen's Tick accumulator needs ~0.1s of REAL time before
                    // its first Simulation.Step, so "simTime stable for a few frames"
                    // alone passes TOO EARLY (measured live: stable at 0.0 for the
                    // first ~6 frames, then the queue-draining Step leaks its one
                    // 0.1s). The authoritative settle signal is the command queue
                    // actually draining (HasAnyScheduledCommands -> false, which
                    // happens exactly at that first Step), THEN simTime stability.
                    float settleStart = Time.realtimeSinceStartup;
                    while (attachedGame.Simulation.HasAnyScheduledCommands && Time.realtimeSinceStartup - settleStart < 5f)
                    {
                        yield return null;
                    }
                    double settlePrev = (double)attachedGame.Simulation.GetModel<ClockModel>().Time;
                    int stableFrames = 0;
                    for (int settleFrame = 0; settleFrame < 30 && stableFrames < 3; settleFrame++)
                    {
                        yield return null;
                        double settleNow = (double)attachedGame.Simulation.GetModel<ClockModel>().Time;
                        stableFrames = (settleNow == settlePrev) ? stableFrames + 1 : 0;
                        settlePrev = settleNow;
                    }
                    WriteLine($"[Phase9A] Pause-settle complete: simTime={settlePrev:F4} (the stock pause handshake consumes one 0.1s step while its command queue drains -- episode baseline starts AFTER this settled state), Simulation.IsPaused={attachedGame.Simulation.IsPaused}, HasAnyScheduledCommands={attachedGame.Simulation.HasAnyScheduledCommands}.");
                }

                // Split the two halves of the stock pause (confirmed live + static):
                //   - Simulation.IsPaused=true is the actual clock-ownership mechanism
                //     (zero-time Steps). KEEP it.
                //   - Game._timeInterval.IsPaused=true only zeroes ScaledDelta for the
                //     VIEW layer -- and gameplay-visual animations are paced by
                //     ScaledDelta: DestinationPinAnimatorView decrements its
                //     _newPinPostponement/_newPinCooldown with timeInterval.ScaledDelta
                //     before showing the next demand pin, so under a permanent
                //     game-level pause the pins NEVER appear even though
                //     DestinationModel.TotalDemand grows (confirmed live: model demand
                //     0->4 over 3 in-game days, zero pins on screen). CLEAR this flag
                //     only, via the private field (Game.SetPaused(false) would also
                //     queue a SetPausedCommand(false) and unpause the SIMULATION,
                //     which must stay paused). The clock-ownership check below then
                //     validates this exact configuration: view-time flowing, simulated
                //     time frozen.
                try
                {
                    object timeIntervalObj = null;
                    for (Type t = attachedGame.GetType(); t != null && timeIntervalObj == null; t = t.BaseType)
                    {
                        var f = t.GetField("_timeInterval", BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.DeclaredOnly);
                        if (f != null) timeIntervalObj = f.GetValue(attachedGame);
                    }
                    if (timeIntervalObj != null)
                    {
                        var isPausedProp = timeIntervalObj.GetType().GetProperty("IsPaused");
                        isPausedProp.SetValue(timeIntervalObj, false, null);
                        WriteLine($"[Phase9A] Cleared Game._timeInterval.IsPaused (view-layer ScaledDelta restored for demand-pin/animation pacing) while Simulation.IsPaused stays {attachedGame.Simulation.IsPaused} (simulated time remains frozen outside AdvanceSimulation).");
                    }
                    else
                    {
                        WriteLine("[Phase9A] WARNING: could not locate Game._timeInterval field -- demand pins and other ScaledDelta-paced view animations will not play.");
                    }
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] EXCEPTION clearing Game._timeInterval.IsPaused: {ex}");
                }

                // Clock-ownership proof (Step 3 hard invariant): record simulation time
                // and the canonical observation fingerprint after the pause has
                // settled, then let several real Unity frames pass WITHOUT calling
                // AdvanceSimulation ourselves. The screen's per-frame _game.Tick is
                // RUNNING by design -- but paused Steps are zero-time, so if
                // simulated time or the observation fingerprint changes here with no
                // action from us, pause-based ownership is broken and we abort.
                double simTimeAtSuspend = (double)attachedGame.Simulation.GetModel<ClockModel>().Time;
                string fingerprintAtSuspend = null;
                try { fingerprintAtSuspend = HashJson(BuildPolicyObservation(attachedGame)); }
                catch (Exception ex) { WriteLine($"[Phase9A] EXCEPTION building at-suspend observation: {ex}"); }
                WriteLine($"[Phase9A] Clock-ownership check: simTime={simTimeAtSuspend:F4}, fingerprint={fingerprintAtSuspend} after pause settled. Waiting 15 idle real frames with NO AdvanceSimulation call to detect any competing per-frame tick...");

                for (int idleFrame = 0; idleFrame < 15; idleFrame++)
                {
                    yield return null;
                    try
                    {
                        double tNow = (double)attachedGame.Simulation.GetModel<ClockModel>().Time;
                        WriteLine($"[Phase9A][DIAG] idle frame {idleFrame}: simTime={tNow:F4} Simulation.IsPaused={attachedGame.Simulation.IsPaused} HasAnyScheduledCommands={attachedGame.Simulation.HasAnyScheduledCommands}");
                    }
                    catch (Exception ex) { WriteLine($"[Phase9A][DIAG] idle frame {idleFrame}: EXCEPTION {ex.Message}"); }
                }

                double simTimeAfterIdle = (double)attachedGame.Simulation.GetModel<ClockModel>().Time;
                string fingerprintAfterIdle = null;
                try { fingerprintAfterIdle = HashJson(BuildPolicyObservation(attachedGame)); }
                catch (Exception ex) { WriteLine($"[Phase9A] EXCEPTION building post-idle observation: {ex}"); }

                bool clockOwnershipOk = simTimeAfterIdle == simTimeAtSuspend && fingerprintAfterIdle == fingerprintAtSuspend;
                WriteLine($"[Phase9A] Clock-ownership check after 15 idle frames: simTime={simTimeAfterIdle:F4} (was {simTimeAtSuspend:F4}), fingerprint={fingerprintAfterIdle} (was {fingerprintAtSuspend}). Verdict: {(clockOwnershipOk ? "PASS -- no duplicate stepping detected; Phase 8's controlled ISimulation.Step() is confirmed to be the sole clock." : "*** FAIL -- simulation state changed with zero AdvanceSimulation calls. GameContainerScreen is still independently advancing the simulation. ***")}");

                if (!clockOwnershipOk)
                {
                    WriteLine("[Phase9A] Aborting attachment: attachment itself changed authoritative gameplay state unexpectedly (Step 4 hard stop condition).");
                    onAttached(null, attachedScreen);
                    yield break;
                }

                onAttached(attachedGame, attachedScreen);
            }

            // One short, human-viewable RandomPolicy episode against the ATTACHED
            // (visible) game. Reuses EnumerateLegalActions/ApplyAction/
            // AdvanceSimulation/BuildPolicyObservation/AssertPersistenceIsolated/
            // ActionDescriptor UNCHANGED from Phase 8 -- only the construction
            // (frontend attachment instead of a headless Get<MotorwaysGame>()) and
            // the per-decision real-frame yields (so a human watching the window can
            // actually see each step) are new.
            private IEnumerator RunVisibleRandomPolicyEpisode(IApp app, CityDefinition cityDefinition, MapDefinition mapDefinition)
            {
                WriteLine("[Phase9A] ===== Visible RandomPolicy episode: attaching Phase 8 environment core to the native frontend =====");

                MotorwaysGame attachedGame = null;
                GameContainerScreen attachedScreen = null;
                yield return AttachGameToFrontend(app, cityDefinition, mapDefinition, 2026u,
                    (game, screen) => { attachedGame = game; attachedScreen = screen; });

                if (attachedGame == null)
                {
                    WriteLine("[Phase9A] Frontend attachment failed -- aborting the visible episode (nothing further was attempted).");
                    yield break;
                }

                Player testPlayer = _isolationDiagnosticTestPlayer;
                string preAttachFingerprint = null;
                try
                {
                    preAttachFingerprint = HashJson(BuildPolicyObservation(attachedGame));
                    WriteLine($"[Phase9A] Environment-integrity fingerprint immediately after attachment: {preAttachFingerprint}.");
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] EXCEPTION building post-attach observation: {ex}");
                }

                AssertPersistenceIsolated(app, testPlayer, attachedGame, "post-attach");

                var actionBounds = new RectInt(-5, -5, 16, 16);
                const double decisionDelta = 0.3;
                const int maxDecisions = 10;
                const double pWait = 0.3;
                var policyRng = new System.Random(90125);

                for (int decisionIndex = 0; decisionIndex < maxDecisions; decisionIndex++)
                {
                    bool isolationOk = AssertPersistenceIsolated(app, testPlayer, attachedGame, $"visible-pre-action-decision{decisionIndex}");

                    System.Collections.Generic.List<ActionDescriptor> legalActions;
                    try
                    {
                        legalActions = EnumerateLegalActions(attachedGame, actionBounds);
                    }
                    catch (Exception ex)
                    {
                        WriteLine($"[Phase9A] EXCEPTION enumerating legal actions at decision {decisionIndex}: {ex}");
                        legalActions = new System.Collections.Generic.List<ActionDescriptor> { ActionDescriptor.Wait() };
                    }

                    ActionDescriptor action;
                    var editActions = legalActions.FindAll(a => a.Kind != ActionKind.Wait);
                    if (!isolationOk || editActions.Count == 0 || policyRng.NextDouble() < pWait)
                    {
                        action = ActionDescriptor.Wait();
                    }
                    else
                    {
                        action = editActions[policyRng.Next(editActions.Count)];
                    }
                    if (!isolationOk)
                    {
                        WriteLine($"[Phase9A] *** ABORTING action at decision {decisionIndex}: AssertPersistenceIsolated FAILED. Forcing WAIT. ***");
                    }

                    bool accepted = false;
                    string applyInfo = "";
                    try
                    {
                        accepted = ApplyAction(attachedGame, action, out applyInfo);
                    }
                    catch (Exception ex)
                    {
                        applyInfo = $"EXCEPTION: {ex}";
                        WriteLine($"[Phase9A] EXCEPTION applying action {action} at decision {decisionIndex}: {ex}");
                    }

                    // Advance by the SAME controlled mechanism as Phase 8 -- direct
                    // ISimulation.Step() calls, now spread across real frames (via
                    // the surrounding yields below) purely so a human watching the
                    // window can see each step; the simulated-time advance itself is
                    // identical in kind to Phase 8's headless AdvanceSimulation calls.
                    double simTimeBeforeStep = (double)attachedGame.Simulation.GetModel<ClockModel>().Time;
                    try
                    {
                        AdvanceSimulation(attachedGame, decisionDelta);
                    }
                    catch (Exception ex)
                    {
                        WriteLine($"[Phase9A] EXCEPTION during AdvanceSimulation at decision {decisionIndex}: {ex}");
                    }

                    double simTimeNow = (double)attachedGame.Simulation.GetModel<ClockModel>().Time;

                    // Step 3 duplicate-stepping instrumentation: AdvanceSimulation's own
                    // round-half-up math (steps = (int)((deltaSeconds/0.1)+0.5)) tells us
                    // EXACTLY how much simulated time this one controlled call should have
                    // added. Any discrepancy means something other than our own
                    // AdvanceSimulation call is advancing ISimulation -- i.e. a competing
                    // per-frame tick that survived SetGameSuspended(true).
                    int expectedSteps = (int)((decisionDelta / 0.1) + 0.5);
                    double expectedAdvance = expectedSteps * 0.1;
                    double actualAdvance = simTimeNow - simTimeBeforeStep;
                    bool stepCountOk = Math.Abs(actualAdvance - expectedAdvance) < 0.0001;
                    if (!stepCountOk)
                    {
                        WriteLine($"[Phase9A] *** DUPLICATE-STEPPING DETECTED at decision {decisionIndex}: expected simTime to advance by {expectedAdvance:F4} (from {expectedSteps} controlled steps) but it advanced by {actualAdvance:F4}. Phase 8 clock ownership has been violated. ***");
                    }

                    WriteLine($"[Phase9A] visible decision {decisionIndex}: simTime={simTimeNow:F2} (advance={actualAdvance:F4}, expected={expectedAdvance:F4}, stepCountOk={stepCountOk}) action={action} legalActionCount={legalActions.Count} accepted={accepted} [{applyInfo}]");

                    // Human-viewable pacing: hold this frame's result on screen for
                    // about half a second of real time before the next decision.
                    // This is purely a presentation choice (real frames rendered by
                    // Unity's own loop) -- it does NOT call AdvanceSimulation again
                    // and does NOT touch ISimulation.Step(); GameContainerScreen's own
                    // per-frame _game.Tick(deltaTime) remains suspended throughout.
                    for (int f = 0; f < 30; f++) { yield return null; }
                }

                AssertPersistenceIsolated(app, testPlayer, attachedGame, "visible-post-loop");

                string postLoopFingerprint = null;
                try
                {
                    postLoopFingerprint = HashJson(BuildPolicyObservation(attachedGame));
                    WriteLine($"[Phase9A] Environment-integrity fingerprint after the visible RandomPolicy loop: {postLoopFingerprint} (pre-attach was {preAttachFingerprint} -- expected to differ, since real actions were applied; this is NOT a determinism check, just confirming BuildPolicyObservation still works correctly against the attached game).");
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] EXCEPTION building post-loop observation: {ex}");
                }

                WriteLine("[Phase9A] Visible RandomPolicy episode complete. Leaving the frontend attached and suspended (no teardown call on the attached game, since GameContainerScreen still references it) -- the orchestrating session will end the process directly.");
            }

            // Constructs a brand-new player via the stock PlayerDatabase.CreatePlayer()
            // factory (the same method the real "create profile" UI screen calls) and
            // activates it via the stock ActivePlayer.ActivatePlayer(Player) -- no
            // custom Player subclass, no hand-filled fields, no approximation of the
            // real creation flow. This itself WILL write one or two small new files
            // under the test player's own GUID (confirmed unavoidable: CreatePlayer's
            // locale-set and ActivatePlayer's Touch() both go through idiomatic
            // property setters that trigger the same immediate OnValueChanged->Store()
            // path described above) -- that is expected, disposable, and verified
            // below to never touch the real player's files.
            private bool SwitchToIsolatedTestProfile(IApp app, out Player testPlayer)
            {
                testPlayer = null;
                try
                {
                    PlayerDatabase playerDatabase = app.Scope.Get<PlayerDatabase>();
                    ActivePlayer activePlayer = app.Scope.Get<ActivePlayer>();

                    testPlayer = playerDatabase.CreatePlayer();
                    WriteLine($"[Phase9A] Created isolated test player via stock PlayerDatabase.CreatePlayer(): Id={testPlayer.Id}. " +
                        "This is a genuinely new, disposable profile -- any persistent files it produces will be named with THIS id, " +
                        "never colliding with the real player's files (confirmed via StorableUtilities.GenerateFilename's \"{prefix}{playerId}{ext}\" scheme).");

                    SubscribePlayerChangedDiagnostic(activePlayer); // no-op if already subscribed in RestoreExistingPlayerProfile
                    LogPlayerCheckpoint(app, "A (before ActivatePlayer(testPlayer))");
                    activePlayer.ActivatePlayer(testPlayer);
                    LogPlayerCheckpoint(app, "B (immediately after ActivatePlayer(testPlayer))");

                    // Suppress the "Menü Geçişleri" / skip-transitions FTUX nag on the
                    // TEST player only (stock per-player seen-flag, same API the prompt
                    // itself uses -- no device/global setting touched, real player
                    // unaffected). MainMenuScreen re-shows it every session otherwise,
                    // because our disposable test profile is fresh each boot and each
                    // episode's pop-to-menu counts as a menu visit; while open it sets
                    // InputState.BlockAllInput=true, killing manual debugging input.
                    try
                    {
                        activePlayer.SetNewContentSeen("SkipTransitionsFTUXMessage");
                        WriteLine("[Phase9A] Marked SkipTransitionsFTUXMessage as seen on the test player (suppresses the recurring menu-transitions prompt).");
                    }
                    catch (Exception ex) { WriteLine($"[Phase9A] EXCEPTION suppressing SkipTransitions FTUX prompt: {ex}"); }

                    return activePlayer.HasActivePlayer && activePlayer.Player == testPlayer;
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] EXCEPTION creating/activating isolated test profile: {ex}");
                    return false;
                }
            }

            // Phase 5E: Native Profile Initialization. A subagent decompilation of
            // ActivePlayer/PlayerDatabase/LoadingScreen found the EXACT stock restore
            // chain: IPersistentStorageService.LoadAll(callback) -> populates
            // PlayerDatabase (AddUserProfile/AddDeviceSettings/AddSavedGame, called by
            // IStorableTypeHandler.ProcessLoadedStorable for each file on disk/Steam
            // Cloud) -> PlayerDatabase.MostRecentPlayer (pure read, picks the existing
            // profile with the latest DeviceSettings.LastPlayedUtcTime) ->
            // IActivePlayer.ActivatePlayer(Player) (the ONLY writer of ActivePlayer's
            // private _player field). This is exactly what Motorways.Views.
            // LoadingScreen.Tick() does on every normal launch, before
            // ProfileSelectScreen/ProfileCreationScreen are ever reachable -- the
            // single-profile case never routes through those UI screens at all.
            //
            // Confirmed via decompilation (both WindowsBaseEnvironment.LocalFileStorage
            // and WindowsSteamEnvironment.SteamCloud, which Steam builds actually use)
            // that LoadAll is fully SYNCHRONOUS: it reads every file, calls
            // ProcessLoadedStorable for each, then invokes loadCompleteCallback -- all
            // before returning. PlayerDatabase.MostRecentPlayer is a pure in-memory
            // read with no side effects. IActivePlayer.ActivatePlayer(Player) only
            // assigns the private field, (un)subscribes two events, and calls
            // CheckAchievementsRetroactively()/Touch() -- all in-memory, per the
            // separate subagent persistence investigation (no disk write except via
            // the time-gated autosave or OnGameEnd(), neither triggered here).
            //
            // Hard constraint from the Phase 5E brief: if PlayerDatabase.MostRecentPlayer
            // is null (no existing profile on disk/cloud), we STOP and document rather
            // than call PlayerDatabase.CreatePlayer() -- never fabricate a profile, never
            // touch persistent save data.
            private IEnumerator RestoreExistingPlayerProfile(IApp app, Action<bool> onResult)
            {
                WriteLine("[Phase9A] Attempting to restore an EXISTING player profile (read-only load + activation; profile CREATION is explicitly out of bounds).");

                ActivePlayer activePlayerBefore;
                try
                {
                    activePlayerBefore = app.Scope.Get<ActivePlayer>();
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] Failed to resolve ActivePlayer from app.Scope: {ex}");
                    onResult(false);
                    yield break;
                }

                // Persistence-isolation diagnostic: subscribe to the PUBLIC
                // ActivePlayer.PlayerChanged event as early as possible (before our
                // own first ActivatePlayer call), so every activation for the rest of
                // this process -- ours or the stock game's own -- is captured with a
                // real call-stack snapshot. This is a plain event subscription, not a
                // patch of App.dll: no method body is rewritten, no Harmony/MonoMod
                // hook installed.
                SubscribePlayerChangedDiagnostic(activePlayerBefore);
                LogPlayerCheckpoint(app, "A0 (before stock restore's ActivatePlayer)");

                if (activePlayerBefore != null && activePlayerBefore.HasActivePlayer)
                {
                    WriteLine("[Phase9A] ActivePlayer already has a player loaded (unexpected in this bypass context, but nothing to do). Treating as success.");
                    onResult(true);
                    yield break;
                }

                IPersistentStorageService storage;
                PlayerDatabase playerDatabase;
                try
                {
                    storage = app.Scope.Get<IPersistentStorageService>();
                    playerDatabase = app.Scope.Get<PlayerDatabase>();
                    WriteLine($"[Phase9A] Resolved IPersistentStorageService ({storage.GetType().FullName}) and PlayerDatabase from app.Scope.");
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] Failed to resolve IPersistentStorageService/PlayerDatabase: {ex}");
                    onResult(false);
                    yield break;
                }

                bool loadCompleted = false;
                Exception loadException = null;
                try
                {
                    storage.LoadAll(() => { loadCompleted = true; });
                }
                catch (Exception ex)
                {
                    loadException = ex;
                }

                if (loadException != null)
                {
                    WriteLine($"[Phase9A] IPersistentStorageService.LoadAll threw: {loadException}");
                    onResult(false);
                    yield break;
                }

                float waitStart = Time.realtimeSinceStartup;
                while (!loadCompleted && Time.realtimeSinceStartup - waitStart < 10f)
                {
                    yield return null;
                }

                WriteLine($"[Phase9A] IPersistentStorageService.LoadAll callback fired = {loadCompleted} (elapsed {Time.realtimeSinceStartup - waitStart:F3}s -- 0.000s confirms the synchronous path decompiled above).");

                if (!loadCompleted)
                {
                    WriteLine("[Phase9A] LoadAll did not complete within 10s. Aborting restore -- no profile activated, nothing mutated.");
                    onResult(false);
                    yield break;
                }

                WriteLine($"[Phase9A] PlayerDatabase.PlayerCount after load = {playerDatabase.PlayerCount}.");

                Player mostRecent;
                try
                {
                    mostRecent = playerDatabase.MostRecentPlayer;
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] PlayerDatabase.MostRecentPlayer threw: {ex}");
                    onResult(false);
                    yield break;
                }

                if (mostRecent == null)
                {
                    WriteLine("[Phase9A] PlayerDatabase.MostRecentPlayer == null: no existing profile was found on disk/Steam Cloud. " +
                        "Per the Phase 5E brief, this is exactly the case where we STOP rather than call PlayerDatabase.CreatePlayer() -- " +
                        "doing so would fabricate a new profile. Documenting and aborting; no profile was created, nothing was mutated.");
                    onResult(false);
                    yield break;
                }

                WriteLine($"[Phase9A] Found existing player via MostRecentPlayer: Id={mostRecent.Id}, LocaleId={mostRecent.LocaleId}, " +
                    $"LastPlayedUtcTime={mostRecent.DeviceSettings?.LastPlayedUtcTime.ToString() ?? "null"}.");

                try
                {
                    activePlayerBefore.ActivatePlayer(mostRecent);
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] ActivePlayer.ActivatePlayer(existingPlayer) threw: {ex}");
                    onResult(false);
                    yield break;
                }

                WriteLine($"[Phase9A] ActivePlayer.ActivatePlayer(existingPlayer) completed without throwing. HasActivePlayer = {activePlayerBefore.HasActivePlayer}.");
                LogPlayerCheckpoint(app, "A1 (after stock restore's ActivatePlayer -- real player)");
                onResult(activePlayerBefore.HasActivePlayer);
            }

            private IEnumerator RunLifecycleProof()
            {
                WriteLine("[Phase9A] Starting native profile restore + session lifecycle proof.");

                float waitStart = Time.realtimeSinceStartup;
                IApp app = null;
                while (Time.realtimeSinceStartup - waitStart < 60f)
                {
                    app = AppRuntimeRef != null ? AppRuntimeRef.App : null;
                    if (app != null)
                    {
                        break;
                    }
                    yield return null;
                }

                if (app == null)
                {
                    WriteLine("[Phase9A] AppRuntime.App never became available within 60s. Aborting.");
                    yield break;
                }

                WriteLine($"[Phase9A] IApp resolved: {app.GetType().FullName}");

                // Phase 5F Task 4: InitializeProcessContext() runs ONCE per process --
                // stock profile restore (Phase 5E) + stock RoadTileAtlas/RailTileAtlas/
                // BoatPathTileAtlas population (Phase 5F, new). Everything after this
                // point is ResetEpisode()/DestroyEpisode(), repeated per cycle, which
                // must NOT redo any of this.
                bool processReady = false;
                yield return InitializeProcessContext(app, success => processReady = success);

                if (!processReady)
                {
                    WriteLine("[Phase9A] Process-lifetime initialization did not complete (profile restore and/or atlas population failed). " +
                        "Per the hard constraints (never fabricate a profile; never patch/null-guard atlas lookups), STOPPING here rather than " +
                        "proceeding to GameMode.Normal episodes. See the per-stage log lines above for exactly which step failed.");
                    WriteLine("[MiniMotorwaysAI] phase5f blocked: process initialization incomplete");
                    yield break;
                }

                WriteLine("[Phase9A] Process-lifetime initialization complete (profile restored, all three atlases verified populated). Proceeding to GameMode.Normal episodes.");

                // Diagnostic probe: a subagent investigation traced the CameraView
                // NullReferenceException to a null `_visualConstantsData` field,
                // registered app-level via an UNGUARDED
                // AssetBundleUtility.LoadAsset<VisualConstantsData>("core",
                // "VisualConstantsData") in CreateAppAssembler (unlike GameCamera's
                // registration, which IS null-checked). If that registration is
                // truly app-level and runs once at boot, app.Scope.Get<T>() here
                // (BEFORE constructing any test Game) should already reveal whether
                // it's null for every caller, or only inside a game's own child
                // scope -- resolving the one open question the static analysis
                // alone could not settle. Purely a read, no mutation.
                try
                {
                    VisualConstantsData vcd = app.Scope.Get<VisualConstantsData>();
                    WriteLine($"[Phase9A] Diagnostic: app.Scope.Get<VisualConstantsData>() = {(vcd == null ? "NULL" : "non-null")}" +
                        (vcd != null ? $", ZoomLevelsCameraMin.Count={vcd.ZoomLevelsCameraMin?.Count ?? -1}" : ""));
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] Diagnostic: app.Scope.Get<VisualConstantsData>() threw: {ex.Message}");
                }

                // Step 4: if a manually-started session exists, record it read-only.
                // This is purely informational -- we never touch this object.
                Game existingGame = app.Game;
                if (existingGame != null)
                {
                    WriteLine("[Phase9A] An existing (manually-started) session is active -- recording read-only, will not be touched:");
                    WriteLine($"[Phase9A]   MotorwaysGame identity: {existingGame.GetType().FullName}");
                    WriteLine($"[Phase9A]   Server.Simulation identity: {existingGame.Simulation?.GetType().FullName ?? "null"}");
                    try
                    {
                        var motorwaysGame = existingGame as MotorwaysGame;
                        WriteLine($"[Phase9A]   StartedWithCityDefinition: {motorwaysGame?.StartedWithCityDefinition?.name ?? "null"}");
                        WriteLine($"[Phase9A]   MapDefinition.cityName: {motorwaysGame?.MapDefinition?.cityName ?? "null"}");
                    }
                    catch (Exception ex)
                    {
                        WriteLine($"[Phase9A]   (city/map read failed, informational only: {ex.Message})");
                    }
                    try
                    {
                        ClockModel clock = existingGame.Scope?.Get<ClockModel>();
                        WriteLine($"[Phase9A]   ClockModel.Time: {clock?.Time}, IsPaused: {existingGame.Simulation?.IsPaused}");
                    }
                    catch (Exception ex)
                    {
                        WriteLine($"[Phase9A]   (ClockModel read failed, informational only: {ex.Message})");
                    }
                }
                else
                {
                    WriteLine("[Phase9A] No existing session active (main menu) -- proceeding with an isolated test session only.");
                }

                // Obtain a CityDefinition/MapDefinition to construct test sessions
                // with, purely via code (no UI). See GetCityDefinitionForTesting().
                CityDefinition cityDefinition = null;
                MapDefinition mapDefinition = null;
                LogPlayerCheckpoint(app, "C1 (before async city-definition/prefab acquisition)");
                yield return GetCityDefinitionForTesting(app, existingGame, result => { cityDefinition = result.Item1; mapDefinition = result.Item2; });
                LogPlayerCheckpoint(app, "C2 (immediately after city-definition/prefab acquisition completes)");

                if (cityDefinition == null || mapDefinition == null)
                {
                    WriteLine("[Phase9A] Could not obtain a CityDefinition/MapDefinition for testing. Aborting lifecycle proof (nothing was constructed or mutated).");
                    yield break;
                }

                WriteLine($"[Phase9A] Using CityDefinition='{cityDefinition.name}', MapDefinition.cityName='{mapDefinition.cityName}' for all Phase 8 episodes.");

                // Phase 10: optional visible fixed-action replay mode, used to show
                // ONE already-trained-and-evaluated PPO episode through the proven
                // Phase 9A frontend attachment path after quantitative evaluation in
                // Python is complete. Detected by the presence of a plain JSON file
                // (an array of action indices, same index scheme as the IPC
                // protocol) written by python/evaluate.py -- this lets the SAME
                // bootstrap DLL serve both the IPC-training runs and the one visible
                // replay run without a rebuild. Does nothing live until that file is
                // dropped; absent, this run proceeds to the IPC server exactly as
                // before.
                string replayActionsPath = @"C:\Users\TKA\Desktop\mini moto\logs\phase10_replay_actions.json";
                if (File.Exists(replayActionsPath))
                {
                    System.Collections.Generic.List<int> replayIndices = null;
                    try
                    {
                        object parsed = MiniJson.Parse(File.ReadAllText(replayActionsPath));
                        replayIndices = new System.Collections.Generic.List<int>();
                        foreach (object item in (System.Collections.Generic.List<object>)parsed)
                        {
                            replayIndices.Add((int)(double)item);
                        }
                        WriteLine($"[Phase10] Loaded {replayIndices.Count} replay action indices from {replayActionsPath}.");
                    }
                    catch (Exception ex)
                    {
                        WriteLine($"[Phase10] Failed to parse replay actions file: {ex}. Falling back to the IPC server.");
                        replayIndices = null;
                    }

                    if (replayIndices != null)
                    {
                        var replayBounds = cityDefinition.PlayableArea;
                        var replayActions = new System.Collections.Generic.List<ActionDescriptor>();
                        foreach (int idx in replayIndices)
                        {
                            replayActions.Add(ActionIndexToDescriptor(idx, replayBounds));
                        }
                        yield return RunVisibleFixedActionEpisode(app, cityDefinition, mapDefinition, replayActions);
                        WriteLine("[MiniMotorwaysAI] phase10 visible replay run complete");
                        yield break;
                    }
                }

                // Phase 10: start the IPC bridge and hand control to Python. This
                // REPLACES Phase 9A's own canary+visible-episode battery for this
                // run (both remain intact, unchanged, below -- reachable by setting
                // phase10IpcServerRun=false). _isolationDiagnosticTestPlayer (already
                // created and activated by InitializeProcessContext, above) and
                // AssertPersistenceIsolated (unchanged since Phase 8) remain the
                // permanent safety gate for every RESET/STEP handled over IPC.
                const bool phase10IpcServerRun = true;
                if (phase10IpcServerRun)
                {
                    _ipcApp = app;
                    _ipcCityDefinition = cityDefinition;
                    _ipcMapDefinition = mapDefinition;
                    // Phase 10B finding: the previous hardcoded RectInt(-5,-5,16,16)
                    // (inherited unchanged from Phase 9A's short visual demo) does not
                    // contain ANY of this map's destinations -- confirmed live: 0/4
                    // destinations fall inside that window, while the full
                    // CityDefinition.PlayableArea is a 37x21 region. No policy, random
                    // or trained, could ever reach a destination under the old bounds,
                    // regardless of episode length -- this, not reward sparsity or a
                    // too-short horizon, was the real reason every experiment showed a
                    // flat-zero reward. Action bounds now match the observation bounds
                    // exactly (the same cityDefinition.PlayableArea BuildPolicyObservation
                    // already uses), so every observable tile is also an actionable one.
                    _ipcActionBounds = cityDefinition.PlayableArea;
                    _ipcActionSpaceSize = 1 + _ipcActionBounds.width * _ipcActionBounds.height * 4 + UpgradeChoiceSlots;
                    bool ipcStarted = InitializeFileIpc();
                    if (!ipcStarted)
                    {
                        WriteLine("[MiniMotorwaysAI] phase10 ipc server failed to start");
                        yield break;
                    }
                    WriteLine($"[Phase10] File-based IPC ready. requestPath={IpcRequestPath} responsePath={IpcResponsePath} actionSpaceSize={_ipcActionSpaceSize} bounds=(xMin={_ipcActionBounds.xMin},yMin={_ipcActionBounds.yMin},width={_ipcActionBounds.width},height={_ipcActionBounds.height}) decisionDelta={IpcDecisionDelta}. Waiting for Python client...");
                    while (!_ipcShutdownRequested)
                    {
                        yield return null;
                    }
                    WriteLine("[MiniMotorwaysAI] phase10 ipc server shutdown complete");
                    yield break;
                }

                // Persistence isolation canary (kept as a cheap, permanent sanity
                // check at the start of every run, per explicit user direction) --
                // the root-cause fix (wait for the stock LoadingScreen's one-shot
                // activation before creating the test player) is confirmed solved;
                // see research/PHASE_8_ENVIRONMENT_CORE.md. The full determinism
                // test + RandomPolicy episodes below now run for real.
                const bool diagnosticOnlyRun = false;
                yield return RunPersistenceCanary(app, cityDefinition, mapDefinition);
                if (diagnosticOnlyRun)
                {
                    WriteLine("[MiniMotorwaysAI] phase8 persistence isolation canary complete (canary-only run; RandomPolicy not yet run)");
                    yield break;
                }

                // Phase 9A: presentation-integration milestone. Attaches the SAME
                // Phase 8 environment core (unmodified: EnumerateLegalActions,
                // ApplyAction, AdvanceSimulation, BuildPolicyObservation,
                // AssertPersistenceIsolated are all reused byte-for-byte) to the
                // stock native frontend, then runs ONE short, human-viewable
                // RandomPolicy episode. This REPLACES Phase 8's own determinism/
                // RandomPolicy battery for this run (that battery is unchanged below
                // and still runs whenever phase9aVisibleRun is false).
                const bool phase9aVisibleRun = true;
                if (phase9aVisibleRun)
                {
                    yield return RunVisibleRandomPolicyEpisode(app, cityDefinition, mapDefinition);
                    WriteLine("[MiniMotorwaysAI] phase9a visible environment run complete");
                    yield break;
                }

                // Bound the legal-action enumeration to a modest sub-region of the
                // full playable area for this smoke test's runtime -- enumerating
                // thousands of native TileEditor probes per decision across the
                // WHOLE map is unnecessary to demonstrate the environment loop, and
                // this bound is explicitly a smoke-test convenience, not a permanent
                // design decision (same spirit as treating Δt_decision as a
                // parameter). 16x16 tiles x 2 directions x 2 action kinds = up to
                // 1024 native legality probes per decision, which is still a real,
                // non-trivial exercise of the native rules engine.
                var actionBounds = new RectInt(-5, -5, 16, 16);

                var fixedActions = new System.Collections.Generic.List<ActionDescriptor>
                {
                    ActionDescriptor.Wait(),
                    ActionDescriptor.Add(new Vector2Int(5, 5), TileDirection.East),
                    ActionDescriptor.Wait(),
                    ActionDescriptor.Add(new Vector2Int(5, 6), TileDirection.South),
                    ActionDescriptor.Wait(),
                    ActionDescriptor.Remove(new Vector2Int(5, 5), TileDirection.East),
                };

                // ===== Persistence-isolation validation (explicit user requirement):
                // run ONE deliberately stat-producing episode (2 real road adds, 1
                // real removal -- exactly the kind of action that mutated the real
                // profile's AchievementStatistics in the pre-fix run) against the
                // now-active ISOLATED TEST profile, before trusting it for the full
                // multi-episode test below. The orchestrating session hashes the
                // real player's persistent files before this bootstrap launched and
                // again after the whole run (including this episode) completes --
                // see research/PHASE_8_ENVIRONMENT_CORE.md for that comparison. This
                // log line marks the checkpoint the external verification is anchored
                // to.
                WriteLine("[Phase9A] ===== Isolation validation episode: deliberately stat-producing action sequence against the ISOLATED test profile =====");
                yield return RunPolicyEpisode(app, 9001u, cityDefinition, mapDefinition, actionBounds,
                    fixedActions, null, 0, -1, new System.Collections.Generic.List<string>(), null, null);
                WriteLine("[Phase9A] ===== Isolation validation episode complete. Proceeding to the full determinism test + RandomPolicy episodes, still on the isolated test profile. =====");

                // ===== Part 3 determinism test: same seed, same fixed action
                // sequence, two independent episode resets, compare canonical
                // observation fingerprints at every checkpoint, not just the end. =====
                var runAFingerprints = new System.Collections.Generic.List<string>();
                var runBFingerprints = new System.Collections.Generic.List<string>();
                string exampleObservationJson = null;

                WriteLine("[Phase9A] ===== Determinism test: run A =====");
                yield return RunPolicyEpisode(app, 1001u, cityDefinition, mapDefinition, actionBounds,
                    fixedActions, null, 0, 0, runAFingerprints, null, obs => exampleObservationJson = exampleObservationJson ?? obs);

                WriteLine("[Phase9A] ===== Determinism test: run B (independent reset, identical seed + action sequence) =====");
                yield return RunPolicyEpisode(app, 1001u, cityDefinition, mapDefinition, actionBounds,
                    fixedActions, null, 0, 1, runBFingerprints, null, null);

                bool determinismHeld = true;
                int firstDivergenceIndex = -1;
                int checkpointCount = Math.Min(runAFingerprints.Count, runBFingerprints.Count);
                for (int ci = 0; ci < checkpointCount; ci++)
                {
                    if (runAFingerprints[ci] != runBFingerprints[ci])
                    {
                        determinismHeld = false;
                        firstDivergenceIndex = ci;
                        break;
                    }
                }
                if (runAFingerprints.Count != runBFingerprints.Count)
                {
                    determinismHeld = false;
                    WriteLine($"[Phase9A] Determinism test: run A produced {runAFingerprints.Count} checkpoints, run B produced {runBFingerprints.Count} -- already a divergence (different episode length).");
                }
                WriteLine($"[Phase9A] Determinism test verdict: identical fingerprints at all {checkpointCount} shared checkpoints = {determinismHeld}.");
                if (!determinismHeld && firstDivergenceIndex >= 0)
                {
                    WriteLine($"[Phase9A] First divergence at checkpoint #{firstDivergenceIndex}: runA={runAFingerprints[firstDivergenceIndex]} runB={runBFingerprints[firstDivergenceIndex]}");
                }
                for (int ci = 0; ci < checkpointCount; ci++)
                {
                    WriteLine($"[Phase9A]   checkpoint {ci}: runA={runAFingerprints[ci]} runB={runBFingerprints[ci]} match={runAFingerprints[ci] == runBFingerprints[ci]}");
                }

                if (exampleObservationJson != null)
                {
                    try
                    {
                        string obsPath = @"C:\Users\TKA\Desktop\mini moto\research\environment_observation_example.json";
                        Directory.CreateDirectory(Path.GetDirectoryName(obsPath));
                        File.WriteAllText(obsPath, exampleObservationJson);
                        WriteLine($"[Phase9A] Wrote example PolicyObservation ({exampleObservationJson.Length} bytes) to {obsPath}.");
                    }
                    catch (Exception ex)
                    {
                        WriteLine($"[Phase9A] Failed to write example observation JSON: {ex}");
                    }
                }

                // ===== Part 4: end-to-end RandomPolicy, multiple episodes. =====
                var traceLines = new System.Collections.Generic.List<string>();
                int randomPolicySeed = 777;
                for (int episodeIndex = 0; episodeIndex < 3; episodeIndex++)
                {
                    uint episodeSeed = (uint)(2001 + episodeIndex);
                    WriteLine($"[Phase9A] ===== RandomPolicy episode {episodeIndex}: simSeed={episodeSeed}, policyRngSeed={randomPolicySeed + episodeIndex} =====");
                    yield return RunPolicyEpisode(app, episodeSeed, cityDefinition, mapDefinition, actionBounds,
                        null, new System.Random(randomPolicySeed + episodeIndex), episodeIndex, episodeIndex, null, traceLines, null);
                }

                try
                {
                    string tracePath = @"C:\Users\TKA\Desktop\mini moto\research\random_policy_trace.jsonl";
                    Directory.CreateDirectory(Path.GetDirectoryName(tracePath));
                    File.WriteAllText(tracePath, string.Join("\n", traceLines) + "\n");
                    WriteLine($"[Phase9A] Wrote {traceLines.Count} RandomPolicy decision records to {tracePath}.");
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] Failed to write RandomPolicy trace JSONL: {ex}");
                }

                if (existingGame != null)
                {
                    Game stillThere = app.Game;
                    WriteLine($"[Phase9A] Post-run check: existing manually-started session still intact (same instance)={ReferenceEquals(stillThere, existingGame)}.");
                }

                WriteLine("[MiniMotorwaysAI] phase8 environment core complete");
            }

            // ---- Phase 7A: native road add/remove via the stock semantic edit path ----
            // Per the brief: never mutate TilemapModel/lane/pathfinding structures
            // directly, never synthesize internal state the normal edit system would
            // construct itself. Both helpers go through the REAL call chain traced
            // via decompilation: TileEditor.AddRoad/ClearTileExplicit (the same entry
            // points DrawRoadAction/DragClearTileAction use) -> EditTileCommand.Create
            // -> ISimulation.ScheduleCommand -- the exact same Command-based mechanism
            // already proven for InitCityCommand since Phase 5A. TileEditor is
            // resolved from testGame.Scope (not app.Scope) because it, EditTileCommand,
            // AddRoadEdit, and ClearTileEdit are all registered in the GAME-scope
            // assembler (MotorwaysAppContainer), confirmed via decompilation.
            private bool TryAddRoad(MotorwaysGame testGame, Vector2Int originCoordinates, TileDirection direction, out string resultInfo)
            {
                try
                {
                    TilemapModel tilemap = testGame.Simulation.GetModel<TilemapModel>();
                    TileEditor tileEditor = testGame.Scope.Get<TileEditor>();
                    TileEditResult result = tileEditor.AddRoad(tilemap, originCoordinates, direction);
                    if (!result.IsSuccessful || result.edit == null)
                    {
                        resultInfo = $"TileEditor.AddRoad({originCoordinates}, {direction}) did not succeed: resultCode={result.resultCode}.";
                        return false;
                    }

                    EditTileCommand command = EditTileCommand.Create(testGame.Scope, result.edit);
                    bool scheduled = testGame.Simulation.ScheduleCommand(command);
                    resultInfo = $"TileEditor.AddRoad succeeded (resultCode={result.resultCode}); EditTileCommand scheduled={scheduled}.";
                    return scheduled;
                }
                catch (Exception ex)
                {
                    resultInfo = $"TryAddRoad threw: {ex}";
                    return false;
                }
            }

            private bool TryClearTile(MotorwaysGame testGame, Vector2Int coordinates, out string resultInfo)
            {
                try
                {
                    TilemapModel tilemap = testGame.Simulation.GetModel<TilemapModel>();
                    TileEditor tileEditor = testGame.Scope.Get<TileEditor>();
                    TileEditResult result = tileEditor.ClearTileExplicit(tilemap, coordinates, TileEditor.ClearTileOfType.Roads);
                    if (!result.IsSuccessful || result.edit == null)
                    {
                        resultInfo = $"TileEditor.ClearTileExplicit({coordinates}, Roads) did not succeed: resultCode={result.resultCode}.";
                        return false;
                    }

                    EditTileCommand command = EditTileCommand.Create(testGame.Scope, result.edit);
                    bool scheduled = testGame.Simulation.ScheduleCommand(command);
                    resultInfo = $"TileEditor.ClearTileExplicit succeeded (resultCode={result.resultCode}); EditTileCommand scheduled={scheduled}.";
                    return scheduled;
                }
                catch (Exception ex)
                {
                    resultInfo = $"TryClearTile threw: {ex}";
                    return false;
                }
            }

            // Pure read-only probe of one tile/direction's road state plus the
            // concrete resource counters -- used for before/after/leak-check
            // comparisons. Not part of SimulationSnapshot (Phase 6A) since it is
            // scoped to exactly the one edge this phase cares about.
            private string DescribeRoadState(MotorwaysGame testGame, Vector2Int originCoordinates, TileDirection direction)
            {
                try
                {
                    TilemapModel tilemap = testGame.Simulation.GetModel<TilemapModel>();
                    Tile originTile = tilemap.GetTile(originCoordinates);
                    Vector2Int destCoordinates = TileUtilities.GetAdjacentCoordinates(originCoordinates, direction);
                    Tile destTile = tilemap.GetTile(destCoordinates);
                    RoadState originState = originTile != null ? originTile.GetTwoLaneRoadStateInDirection(direction) : RoadState.None;
                    UpgradeDatabaseModel upgrades = testGame.Simulation.GetModel<UpgradeDatabaseModel>();
                    int concreteAvailable = upgrades.GetAvailableUpgradeCount(UpgradeType.Concrete);
                    int concreteTotal = upgrades.GetTotalUpgradeCount(UpgradeType.Concrete);
                    ModelList<LaneModel> allLanes = testGame.Simulation.GetModels<LaneModel>();
                    int totalActiveLanes = 0;
                    for (int li = 0; li < allLanes.Count; li++)
                    {
                        if (allLanes[li].state == RoadState.Active) totalActiveLanes++;
                    }
                    return $"origin={originCoordinates} dest={destCoordinates} originTileExists={originTile != null} destTileExists={destTile != null} " +
                        $"roadStateTowardDest={originState} concreteAvailable={concreteAvailable}/{concreteTotal} totalActiveLanes={totalActiveLanes}";
                }
                catch (Exception ex)
                {
                    return $"DescribeRoadState threw: {ex.Message}";
                }
            }

            // ==================== Phase 8: Environment Core ====================

            // One discrete action. Kind.Wait ignores Coord/Direction. Only cardinal
            // N/E/S/W directions are used (TileDirection also has 4 diagonals, not
            // part of this phase's action vocabulary). Per the brief, (x,y,E) and
            // (x+1,y,W) are the SAME undirected edge -- this is enforced not by
            // deduping after the fact, but by construction: EnumerateLegalActions
            // below only ever generates East/South candidates per tile, which
            // between them cover every edge in the grid exactly once (a tile's
            // North edge is its northern neighbor's South edge; West is its western
            // neighbor's East edge).
            private enum ActionKind { Wait, Add, Remove, ChooseUpgrade }

            // Number of weekly-upgrade option slots reserved at the END of the
            // Discrete action space (stock always offers exactly 2 options per
            // pending choice). Weekly choices are granted by UpgradeAwardingProcess,
            // a SIMULATION process -- identical in headless and visible modes -- so
            // adding this action keeps TRAIN_FAST/VISIBLE semantics unified. Without
            // it the agent can never claim any weekly package (+20 roads/week...),
            // which compounds the measured concrete-exhaustion failure mode.
            private const int UpgradeChoiceSlots = 2;

            private struct ActionDescriptor
            {
                public ActionKind Kind;
                public Vector2Int Coord;
                public TileDirection Direction;
                public int UpgradeOptionIndex;

                public static ActionDescriptor Wait() => new ActionDescriptor { Kind = ActionKind.Wait };
                public static ActionDescriptor Add(Vector2Int coord, TileDirection dir) => new ActionDescriptor { Kind = ActionKind.Add, Coord = coord, Direction = dir };
                public static ActionDescriptor Remove(Vector2Int coord, TileDirection dir) => new ActionDescriptor { Kind = ActionKind.Remove, Coord = coord, Direction = dir };
                public static ActionDescriptor ChooseUpgrade(int optionIndex) => new ActionDescriptor { Kind = ActionKind.ChooseUpgrade, UpgradeOptionIndex = optionIndex };

                private static char DirChar(TileDirection d) => d == TileDirection.North ? 'N' : d == TileDirection.East ? 'E' : d == TileDirection.South ? 'S' : d == TileDirection.West ? 'W' : '?';

                public override string ToString()
                {
                    switch (Kind)
                    {
                        case ActionKind.Add: return $"ADD_ROAD({Coord.x},{Coord.y},{DirChar(Direction)})";
                        case ActionKind.Remove: return $"REMOVE_ROAD({Coord.x},{Coord.y},{DirChar(Direction)})";
                        case ActionKind.ChooseUpgrade: return $"CHOOSE_UPGRADE({UpgradeOptionIndex})";
                        default: return "WAIT";
                    }
                }
            }

            // Legal-action enumeration. Legality is determined ENTIRELY by the
            // game's own native edit logic (TileEditor.AddRoad / ClearTileExplicit),
            // never by a hand-rolled approximation of placement rules. WAIT is
            // always first and always legal. For ADD_ROAD we construct-then-discard
            // the probe edit (Scope.Release) when we don't intend to execute it --
            // TileEdit objects are pooled (Factory.Pools.IReusable) and otherwise
            // inert until scheduled via EditTileCommand, confirmed in Phase 7A.
            //
            // REMOVE_ROAD has a real native constraint, reported honestly rather
            // than approximated: TileEditor.ClearTileExplicit(..., Roads) mothballs
            // EVERY road direction on the target tile, not just one edge (Phase 7A
            // finding). There is no native single-edge inverse of AddRoadEdit. To
            // keep REMOVE_ROAD's native behavior equal to its name, this phase only
            // calls it legal when the target tile has EXACTLY ONE two-lane road
            // direction (the requested one) -- in that case clearing the whole tile
            // IS clearing exactly that one edge. This is a real native-semantics
            // restriction on the action's legal scope, not a custom strategic rule.
            private System.Collections.Generic.List<ActionDescriptor> EnumerateLegalActions(MotorwaysGame testGame, RectInt bounds)
            {
                var legal = new System.Collections.Generic.List<ActionDescriptor>();

                // FORCED CHOICE, mirroring stock semantics exactly: while the weekly
                // upgrade choice screen is up, a human player cannot do anything else
                // -- the game blocks until an option is picked. So while a choice is
                // pending, the ONLY legal actions are the options. This guarantees
                // the model claims within one decision of the grant (an untrained
                // policy sampling ~2 of ~1300 actions otherwise usually died with the
                // choice unclaimed), and it is a legality rule faithful to the stock
                // game, not reward shaping.
                try
                {
                    UpgradeDatabaseModel pendingUpgrades = testGame.Simulation.GetModel<UpgradeDatabaseModel>();
                    if (pendingUpgrades != null && pendingUpgrades.pendingUpgradeChoices != null && pendingUpgrades.pendingUpgradeChoices.Count > 0)
                    {
                        int forcedOptionCount = pendingUpgrades.pendingUpgradeChoices[0].choices != null ? pendingUpgrades.pendingUpgradeChoices[0].choices.Count : 0;
                        for (int i = 0; i < forcedOptionCount && i < UpgradeChoiceSlots; i++)
                        {
                            legal.Add(ActionDescriptor.ChooseUpgrade(i));
                        }
                        if (legal.Count > 0) return legal;
                    }
                }
                catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION checking forced upgrade choice: {ex}"); }

                legal.Add(ActionDescriptor.Wait());

                TilemapModel tilemap = testGame.Simulation.GetModel<TilemapModel>();
                TileEditor tileEditor = testGame.Scope.Get<TileEditor>();
                TileDirection[] probeDirections = { TileDirection.East, TileDirection.South };
                TileDirection[] allCardinal = { TileDirection.North, TileDirection.East, TileDirection.South, TileDirection.West };

                // REACH RULE -- the ACTUAL game mechanic (user-directed): the area a
                // player can reach is City.GetSimulationPlayableAreaAtTime, the same
                // native zoom-unlock schedule that fences the stock camera (CameraView
                // computes its framing from the identical call). It starts tight
                // around the young city and expands over in-game time exactly like
                // stock map growth. Returned in TILE units (the Client variant is the
                // same rect in world units). Legal placements are restricted to it;
                // the Discrete indexing over the full PlayableArea is unchanged.
                int loopMinX = bounds.xMin, loopMaxX = bounds.xMin + bounds.width - 1;
                int loopMinY = bounds.yMin, loopMaxY = bounds.yMin + bounds.height - 1;
                try
                {
                    City reachCity = testGame.Scope.Get<City>();
                    Fix64 expT = testGame.Simulation.GetModel<ClockModel>().ExpansionTime;
                    RectFixed area = reachCity.GetSimulationPlayableAreaAtTime(expT, City.PlayableAreaRoundingType.ForceWholeTiles);
                    loopMinX = Math.Max(loopMinX, (int)Math.Floor((double)area.xMin));
                    loopMaxX = Math.Min(loopMaxX, (int)Math.Ceiling((double)area.xMax) - 1);
                    loopMinY = Math.Max(loopMinY, (int)Math.Floor((double)area.yMin));
                    loopMaxY = Math.Min(loopMaxY, (int)Math.Ceiling((double)area.yMax) - 1);
                }
                catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION reading native playable-area-at-time (falling back to full bounds): {ex.Message}"); }

                for (int y = loopMinY; y <= loopMaxY; y++)
                {
                    for (int x = loopMinX; x <= loopMaxX; x++)
                    {
                        Vector2Int coord = new Vector2Int(x, y);
                        foreach (TileDirection dir in probeDirections)
                        {
                            // ADD_ROAD probe.
                            try
                            {
                                TileEditResult addResult = tileEditor.AddRoad(tilemap, coord, dir);
                                if (addResult.IsSuccessful && addResult.edit != null)
                                {
                                    legal.Add(ActionDescriptor.Add(coord, dir));
                                    testGame.Scope.Release(addResult.edit);
                                }
                            }
                            catch { /* treat as illegal; this is a probe, never let it abort enumeration */ }

                            // REMOVE_ROAD probe: native single-edge precondition first
                            // (cheap, read-only), THEN confirm via the real native
                            // clear-edit construction before calling it legal.
                            try
                            {
                                Tile tile = tilemap.GetTile(coord);
                                if (tile == null) continue;
                                RoadState targetState = tile.GetTwoLaneRoadStateInDirection(dir);
                                if (targetState != RoadState.Active && targetState != RoadState.Mothballed) continue;
                                bool isSingleEdgeTile = true;
                                foreach (TileDirection other in allCardinal)
                                {
                                    if (other == dir) continue;
                                    if (tile.GetTwoLaneRoadStateInDirection(other) != RoadState.None) { isSingleEdgeTile = false; break; }
                                }
                                if (!isSingleEdgeTile) continue;

                                TileEditResult clearResult = tileEditor.ClearTileExplicit(tilemap, coord, TileEditor.ClearTileOfType.Roads);
                                if (clearResult.IsSuccessful && clearResult.edit != null)
                                {
                                    legal.Add(ActionDescriptor.Remove(coord, dir));
                                    testGame.Scope.Release(clearResult.edit);
                                }
                            }
                            catch { /* treat as illegal */ }
                        }
                    }
                }

                return legal;
            }


            // CONNECTED_START (Phase 11A experiment). After a normal deterministic
            // reset, builds ONE simple road connection between an existing house and
            // a compatible destination, using ONLY the native semantic path every
            // ordinary road placement uses: TileEditor.AddRoad -> EditTileCommand ->
            // Simulation.Step. No state mutation, no score/demand/routing touching.
            //
            // Pair choice: from OBSERVABLE map facts only (house/destination tile
            // positions and colour group -- what a human sees). Deterministic order:
            // houses sorted by (y, x); the same-group (house, destination tile) pair
            // with the smallest Manhattan distance wins, ties broken by that order.
            // Same seed -> same pair, always.
            //
            // Path: breadth-first search over tile adjacency where an edge is allowed
            // iff the NATIVE legality probe (TileEditor.AddRoad construct-then-discard,
            // the same probe the agent's legal mask uses) accepts it. The planner
            // exists only for environment initialisation; it is not part of the agent.
            //
            // Each edge is applied through the native path with ONE native tick after
            // every placement (so each probe sees the previous edit executed), as a
            // player drawing the road would. Roads consume normal concrete; nothing is
            // refunded; nothing is protected from later removal.
            private string InitializeConnectedStart(MotorwaysGame game)
            {
                var info = new StringBuilder();
                info.Append("{\"mode\":\"CONNECTED_START\"");
                try
                {
                    TilemapModel tilemap = game.Simulation.GetModel<TilemapModel>();
                    TileEditor tileEditor = game.Scope.Get<TileEditor>();
                    UpgradeDatabaseModel upg = game.Simulation.GetModel<UpgradeDatabaseModel>();
                    int concreteBefore = upg.GetAvailableUpgradeCount(UpgradeType.Concrete);

                    HouseModel bestHouse = null; DestinationModel bestDest = null;
                    int waitedTicks = 0;
                    // The first house spawns on the simulation's own schedule (none exist
                    // at t=0). CONNECTED_START therefore begins at the earliest moment a
                    // compatible pair exists: only native ticks (no actions) are
                    // advanced until then, bounded at 30 simulated seconds.
                    while (true)
                    {
                        var houses = new System.Collections.Generic.List<HouseModel>();
                        ModelList<HouseModel> hm = game.Simulation.GetModels<HouseModel>();
                        for (int i = 0; i < hm.Count; i++) houses.Add(hm[i]);
                        houses.Sort((a, b) =>
                        {
                            Vector2Int ca = a.tileModel.Coordinates, cb = b.tileModel.Coordinates;
                            int c = ca.y.CompareTo(cb.y);
                            return c != 0 ? c : ca.x.CompareTo(cb.x);
                        });
                        var dests = new System.Collections.Generic.List<DestinationModel>();
                        ModelList<DestinationModel> dm = game.Simulation.GetModels<DestinationModel>();
                        for (int i = 0; i < dm.Count; i++) if (!dm[i].IsTrainStation && !dm[i].IsBoatTerminal) dests.Add(dm[i]);

                        int bestDist = int.MaxValue;
                        foreach (HouseModel h in houses)
                        {
                            Vector2Int hc = h.tileModel.Coordinates;
                            foreach (DestinationModel d in dests)
                            {
                                if (d.GroupIndex != h.GroupIndex) continue;
                                foreach (var tm in d.TileModels)
                                {
                                    int dist = Math.Abs(tm.Coordinates.x - hc.x) + Math.Abs(tm.Coordinates.y - hc.y);
                                    if (dist < bestDist) { bestDist = dist; bestHouse = h; bestDest = d; }
                                }
                            }
                        }
                        if (bestHouse != null || waitedTicks >= 300) break;
                        AdvanceSimulation(game, 0.1);
                        waitedTicks++;
                    }
                    info.Append(",\"waitedForSpawnTicks\":" + waitedTicks);
                    if (bestHouse == null)
                    {
                        info.Append(",\"error\":\"no compatible house/destination pair\"}");
                        return info.ToString();
                    }
                    Vector2Int start = bestHouse.tileModel.Coordinates;
                    var goal = new System.Collections.Generic.HashSet<Vector2Int>();
                    var footprint = new StringBuilder();
                    foreach (var tm in bestDest.TileModels)
                    {
                        goal.Add(tm.Coordinates);
                        if (footprint.Length > 0) footprint.Append(",");
                        footprint.Append(JVec2Int(tm.Coordinates));
                    }
                    info.Append(",\"house\":" + JVec2Int(start) + ",\"houseGroup\":" + bestHouse.GroupIndex + ",\"destinationFootprint\":[" + footprint + "],\"destinationGroup\":" + bestDest.GroupIndex);
                    info.Append(",\"concreteBefore\":" + concreteBefore);

                    // ---- native semantics (read from TileEditor.AddRoad):
                    //  * a House tile as an endpoint is a DRIVEWAY realignment
                    //    (AlignDrivewayEdit, no concrete) -- the house's way onto the road;
                    //  * a Destination/Carpark tile can NEVER be an endpoint ("cannot
                    //    connect directly"): a destination is served by a road on any
                    //    tile ADJACENT to its footprint;
                    //  * everything else is an ordinary road edge costing concrete.
                    // Node set = non-content tiles. Edges = native-legal ADD probes.
                    RectInt bounds = _ipcActionBounds;
                    var contentTiles = new System.Collections.Generic.HashSet<Vector2Int>();
                    for (int y = bounds.yMin; y < bounds.yMin + bounds.height; y++)
                        for (int x = bounds.xMin; x < bounds.xMin + bounds.width; x++)
                        {
                            Tile t = tilemap.GetTile(new Vector2Int(x, y));
                            if (t != null && (t.ContentType == TileContentType.House || t.ContentType == TileContentType.Destination || t.ContentType == TileContentType.Carpark))
                                contentTiles.Add(new Vector2Int(x, y));
                        }

                    var adj = new System.Collections.Generic.Dictionary<Vector2Int, System.Collections.Generic.List<InitEdge>>();
                    var houseEdges = new System.Collections.Generic.List<InitEdge>(); // driveway options of the chosen house
                    TileDirection[] dirs = { TileDirection.East, TileDirection.South };
                    for (int y = bounds.yMin; y < bounds.yMin + bounds.height; y++)
                    {
                        for (int x = bounds.xMin; x < bounds.xMin + bounds.width; x++)
                        {
                            Vector2Int a2 = new Vector2Int(x, y);
                            foreach (TileDirection dir in dirs)
                            {
                                Vector2Int b2 = TileUtilities.GetAdjacentCoordinates(a2, dir);
                                bool aHouse = a2.Equals(start), bHouse = b2.Equals(start);
                                bool aContent = contentTiles.Contains(a2), bContent = contentTiles.Contains(b2);
                                if ((aContent && !aHouse) || (bContent && !bHouse)) continue;   // other buildings: never an endpoint
                                if (aContent && bContent) continue;
                                TileEditResult probe;
                                try { probe = tileEditor.AddRoad(tilemap, a2, dir); } catch (Exception) { continue; }
                                if (!probe.IsSuccessful || probe.edit == null) continue;
                                game.Scope.Release(probe.edit);

                                // BRIDGES: a bridge is ONE native edit issued from the origin bank
                                // (ADD(origin, dir) toward the water); the game then spans the whole
                                // water gap itself. Model it as a single edge between the two LAND
                                // tiles it joins -- the water tiles are never graph nodes. Water
                                // origins are skipped (the native edit starts from land).
                                CityDefinition cityDefForWater = game.Scope.Get<City>().Definition;
                                if (cityDefForWater.TileIsOverWater(a2)) continue;
                                if (cityDefForWater.TileIsOverWater(b2))
                                {
                                    Vector2Int land = b2; int span = 0;
                                    while (cityDefForWater.TileIsOverWater(land) && span < 8) { land = TileUtilities.GetAdjacentCoordinates(land, dir); span++; }
                                    if (cityDefForWater.TileIsOverWater(land) || contentTiles.Contains(land)) continue;
                                    if (!adj.ContainsKey(a2)) adj[a2] = new System.Collections.Generic.List<InitEdge>();
                                    if (!adj.ContainsKey(land)) adj[land] = new System.Collections.Generic.List<InitEdge>();
                                    adj[a2].Add(new InitEdge { To = land, Origin = a2, Dir = dir, Span = span });
                                    adj[land].Add(new InitEdge { To = a2, Origin = a2, Dir = dir, Span = span });
                                    continue;
                                }

                                var edge = new InitEdge { Origin = a2, Dir = dir };
                                if (aHouse || bHouse)
                                {
                                    edge.To = aHouse ? b2 : a2;   // the road tile the driveway would point at
                                    houseEdges.Add(edge);
                                    continue;
                                }
                                if (!adj.ContainsKey(a2)) adj[a2] = new System.Collections.Generic.List<InitEdge>();
                                if (!adj.ContainsKey(b2)) adj[b2] = new System.Collections.Generic.List<InitEdge>();
                                adj[a2].Add(new InitEdge { To = b2, Origin = a2, Dir = dir });
                                adj[b2].Add(new InitEdge { To = a2, Origin = a2, Dir = dir });
                            }
                        }
                    }

                    // GOAL (native semantics, observed live): a destination is entered through
                    // its CARPARK pad. The carpark tile carries a pre-existing road stub
                    // (a node pointing out of the pad), and the tile at the end of that stub
                    // already carries the matching node. A road that reaches that entry tile
                    // completes the destination connection. Both stubs are visible on screen;
                    // nothing hidden is read. (A road merely touching the building does NOT
                    // connect -- confirmed: the first attempt, which ended beside the
                    // building, produced no traffic at all.)
                    var goalRoad = new System.Collections.Generic.HashSet<Vector2Int>();
                    TileDirection[] allDirs = { TileDirection.North, TileDirection.East, TileDirection.South, TileDirection.West };
                    var padTiles = new System.Collections.Generic.HashSet<Vector2Int>(goal);
                    foreach (Vector2Int g in goal)
                        foreach (TileDirection d4 in allDirs)
                        {
                            Vector2Int n = TileUtilities.GetAdjacentCoordinates(g, d4);
                            Tile nt = tilemap.GetTile(n);
                            if (nt != null && nt.ContentType == TileContentType.Carpark) padTiles.Add(n);
                        }
                    foreach (Vector2Int pad in padTiles)
                    {
                        Tile padTile = tilemap.GetTile(pad);
                        if (padTile == null) continue;
                        foreach (TileDirection d4 in allDirs)
                        {
                            if (padTile.GetTwoLaneRoadStateInDirection(d4) == RoadState.None) continue;
                            Vector2Int entry = TileUtilities.GetAdjacentCoordinates(pad, d4);
                            if (!contentTiles.Contains(entry) && adj.ContainsKey(entry)) goalRoad.Add(entry);
                        }
                    }
                    info.Append(",\"driveWayOptions\":" + houseEdges.Count + ",\"goalRoadTiles\":" + goalRoad.Count + ",\"roadGraphNodes\":" + adj.Count);

                    // SOURCE: the house's EXISTING driveway tile (visible: the stub leaving
                    // the house). Fallback: any native-legal driveway realignment.
                    var prev = new System.Collections.Generic.Dictionary<Vector2Int, System.Collections.Generic.KeyValuePair<Vector2Int, InitEdge>>();
                    var queue = new System.Collections.Generic.Queue<Vector2Int>();
                    var seen = new System.Collections.Generic.HashSet<Vector2Int>();
                    var sourceOf = new System.Collections.Generic.Dictionary<Vector2Int, InitEdge?>(); // road tile -> driveway edit needed (null = driveway already there)
                    TileDirection existingDrive = bestHouse.DrivewayDirection;
                    if (existingDrive != TileDirection.None)
                    {
                        Vector2Int dt = TileUtilities.GetAdjacentCoordinates(start, existingDrive);
                        if (adj.ContainsKey(dt)) { seen.Add(dt); queue.Enqueue(dt); sourceOf[dt] = null; }
                    }
                    if (queue.Count == 0)
                    {
                        foreach (InitEdge he in houseEdges)
                        {
                            if (!adj.ContainsKey(he.To) || seen.Contains(he.To)) continue;
                            seen.Add(he.To); queue.Enqueue(he.To); sourceOf[he.To] = he;
                        }
                    }
                    info.Append(",\"existingDrivewayDirection\":" + JStr(existingDrive.ToString()));

                    Vector2Int reached = default(Vector2Int); bool found = false;
                    foreach (System.Collections.Generic.KeyValuePair<Vector2Int, InitEdge?> src in sourceOf) if (goalRoad.Contains(src.Key)) { reached = src.Key; found = true; break; }
                    while (queue.Count > 0 && !found)
                    {
                        Vector2Int cur = queue.Dequeue();
                        foreach (InitEdge e in adj[cur])
                        {
                            if (seen.Contains(e.To)) continue;
                            seen.Add(e.To);
                            prev[e.To] = new System.Collections.Generic.KeyValuePair<Vector2Int, InitEdge>(cur, e);
                            if (goalRoad.Contains(e.To)) { reached = e.To; found = true; break; }
                            queue.Enqueue(e.To);
                        }
                    }
                    if (!found)
                    {
                        info.Append(",\"error\":\"no legal path between the selected pair\"}");
                        return info.ToString();
                    }
                    var edges = new System.Collections.Generic.List<InitEdge>();
                    Vector2Int walk = reached;
                    while (prev.ContainsKey(walk)) { edges.Add(prev[walk].Value); walk = prev[walk].Key; }
                    edges.Reverse();
                    info.Append(",\"pathStartTile\":" + JVec2Int(walk) + ",\"pathGoalTile\":" + JVec2Int(reached));

                    // apply through the native semantic path, one native tick per edit:
                    // the road edges first, then the house's driveway onto the first road tile
                    int applied = 0, rejected = 0;
                    var log = new StringBuilder();
                    // Flatten the path into NATIVE edits (a bridge is several tile-by-tile
                    // edits). The house's driveway realignment (if needed) is applied first.
                    var nativeRoad = new System.Collections.Generic.List<System.Collections.Generic.KeyValuePair<Vector2Int, TileDirection>>();
                    foreach (InitEdge e0 in edges)
                    {
                        Vector2Int org0 = e0.Origin;
                        for (int k0 = 0; k0 <= e0.Span; k0++)
                        {
                            nativeRoad.Add(new System.Collections.Generic.KeyValuePair<Vector2Int, TileDirection>(org0, e0.Dir));
                            org0 = TileUtilities.GetAdjacentCoordinates(org0, e0.Dir);
                        }
                    }
                    // Full native road path (before any omission), in order from the house: lets a task
                    // generator know every edit and pick which single edit to leave out.
                    var fullPath = new StringBuilder();
                    foreach (var fe in nativeRoad) fullPath.Append(ActionDescriptor.Add(fe.Key, fe.Value).ToString()).Append(' ');
                    info.Append(",\"fullPathEdits\":" + JStr(fullPath.ToString().Trim()) + ",\"pathLengthEdits\":" + nativeRoad.Count);
                    int gap = Math.Min(_ipcStartGap, nativeRoad.Count);
                    var omitted = new StringBuilder();
                    int gapIdx = _ipcStartGapIndex;
                    if (gapIdx >= 1000) gapIdx = Math.Min(nativeRoad.Count - 1, (int)((long)(gapIdx - 1000) * nativeRoad.Count / 1000));   // per-mille position along the path
                    if (gapIdx >= 0 && gapIdx < nativeRoad.Count)
                    {
                        // Gap-1 task variant: omit exactly ONE edit at an arbitrary position along the path
                        // (default behaviour, start_gap_index < 0, is unchanged: the last N edits).
                        gap = 1;
                        omitted.Append(ActionDescriptor.Add(nativeRoad[gapIdx].Key, nativeRoad[gapIdx].Value).ToString()).Append(' ');
                        nativeRoad.RemoveAt(gapIdx);
                        info.Append(",\"gapIndex\":" + gapIdx);
                    }
                    else
                    {
                        for (int om = nativeRoad.Count - gap; om < nativeRoad.Count; om++)
                            omitted.Append(ActionDescriptor.Add(nativeRoad[om].Key, nativeRoad[om].Value).ToString()).Append(' ');
                        if (gap > 0) nativeRoad.RemoveRange(nativeRoad.Count - gap, gap);
                    }

                    var allEdits = new System.Collections.Generic.List<System.Collections.Generic.KeyValuePair<Vector2Int, TileDirection>>();
                    InitEdge? driveEdit = sourceOf[walk];
                    if (driveEdit.HasValue) allEdits.Add(new System.Collections.Generic.KeyValuePair<Vector2Int, TileDirection>(driveEdit.Value.Origin, driveEdit.Value.Dir));
                    allEdits.AddRange(nativeRoad);
                    foreach (var ed in allEdits)
                    {
                        string ri;
                        bool ok = TryAddRoad(game, ed.Key, ed.Value, out ri);
                        AdvanceSimulation(game, 0.1);
                        if (ok) applied++; else rejected++;
                        string label = ActionDescriptor.Add(ed.Key, ed.Value).ToString();
                        log.Append(ok ? "" : "!").Append(label).Append(' ');
                        WriteLine("[Phase11A] init edit " + (ok ? "OK " : "REJECTED ") + label + " (" + ri + ")");
                    }
                    info.Append(",\"gap\":" + gap + ",\"omittedEdits\":" + JStr(omitted.ToString().Trim()));
                    AdvanceSimulation(game, 0.3); // let the last pending lanes promote

                    int concreteAfter = upg.GetAvailableUpgradeCount(UpgradeType.Concrete);
                    info.Append(",\"pathEdges\":" + allEdits.Count + ",\"applied\":" + applied + ",\"rejected\":" + rejected);
                    info.Append(",\"concreteAfter\":" + concreteAfter + ",\"concreteSpent\":" + (concreteBefore - concreteAfter));
                    info.Append(",\"initSimTime\":" + Inv((double)game.Simulation.GetModel<ClockModel>().Time));
                    info.Append(",\"actions\":" + JStr(log.ToString().Trim()));
                    WriteLine("[Phase11A] CONNECTED_START: house " + start + " group " + bestHouse.GroupIndex + " -> destination group " + bestDest.GroupIndex + "; " + allEdits.Count + " native edits (" + applied + " applied, " + rejected + " rejected); concrete " + concreteBefore + " -> " + concreteAfter + ".");
                }
                catch (Exception ex)
                {
                    info.Append(",\"error\":" + JStr(ex.GetType().Name + ": " + ex.Message));
                    WriteLine("[Phase11A] EXCEPTION in InitializeConnectedStart: " + ex);
                }
                info.Append("}");
                return info.ToString();
            }

            private struct InitEdge { public Vector2Int To; public Vector2Int Origin; public TileDirection Dir; public int Span; }

            // Executes exactly one action through the stock semantic path. Returns
            // whether the native command accepted it (re-validated at this point,
            // same as every other legal-action probe -- state may have changed
            // between enumeration and execution, e.g. concrete spent by an earlier
            // action this same decision never happens in this phase's loop, but the
            // re-check is what the native EditTileCommand.Execute does anyway).
            private bool ApplyAction(MotorwaysGame testGame, ActionDescriptor action, out string info)
            {
                switch (action.Kind)
                {
                    case ActionKind.Wait:
                        info = "WAIT (no-op)";
                        return true;
                    case ActionKind.Add:
                        return TryAddRoad(testGame, action.Coord, action.Direction, out info);
                    case ActionKind.Remove:
                        return TryClearTile(testGame, action.Coord, out info);
                    case ActionKind.ChooseUpgrade:
                        return TrySelectUpgrade(testGame, action.UpgradeOptionIndex, out info);
                    default:
                        info = "unknown action kind";
                        return false;
                }
            }

            // Claims the oldest pending weekly upgrade choice via the SAME native
            // path the stock UI uses (GameUpgradeScreen's selection handler):
            // numChoicesMade++ followed by scheduling SelectUpgradeCommand, whose
            // Execute does numChoicesMade-- and ApplyUpgradePackage. The command
            // executes inside the next Simulation.Step (our AdvanceSimulation call
            // right after this), exactly like every road edit.
            private bool TrySelectUpgrade(MotorwaysGame testGame, int optionIndex, out string info)
            {
                try
                {
                    UpgradeDatabaseModel upgrades = testGame.Simulation.GetModel<UpgradeDatabaseModel>();
                    if (upgrades == null || upgrades.pendingUpgradeChoices == null || upgrades.pendingUpgradeChoices.Count == 0)
                    {
                        info = "no pending upgrade choice";
                        return false;
                    }
                    var choices = upgrades.pendingUpgradeChoices[0].choices;
                    if (choices == null || optionIndex < 0 || optionIndex >= choices.Count)
                    {
                        info = $"upgrade option {optionIndex} out of range ({(choices != null ? choices.Count : 0)} options)";
                        return false;
                    }
                    string chosenType = choices[optionIndex].type.ToString();
                    upgrades.numChoicesMade++;
                    testGame.Simulation.ScheduleCommand(SelectUpgradeCommand.Create(testGame.Scope, optionIndex));
                    info = $"scheduled SelectUpgradeCommand(option={optionIndex}, type={chosenType}); pendingBefore={upgrades.pendingUpgradeChoices.Count}";
                    return true;
                }
                catch (Exception ex)
                {
                    info = $"EXCEPTION selecting upgrade: {ex.Message}";
                    WriteLine($"[Phase10] EXCEPTION in TrySelectUpgrade: {ex}");
                    return false;
                }
            }

            // Controlled, deterministic simulation-time stepping (Phase 8 Part 3).
            // Confirmed via decompilation: ISimulation.Step() takes NO deltaTime
            // argument at all -- it always advances by exactly the fixed
            // Timestep=0.1 simulated seconds (or by zero if paused), via internal
            // Fix64 arithmetic with no float round-trip. This is called DIRECTLY,
            // bypassing MotorwaysGame.Tick/Game.Tick's real-frame-time accumulator
            // entirely -- confirmed safe because LaneUpdateProcess (Pending->Active
            // promotion) and every other registered IProcess run INSIDE
            // Simulation.Step() itself, not in Game.Tick's wrapper. What this
            // deliberately skips (view interpolation, audio, autosave-on-timer, the
            // upgrade-choice popup trigger) are exactly the real-time/UI-driven side
            // effects a headless policy loop should not depend on anyway.
            //
            // Δt_decision is 0.3s (3 native steps), not the brief's example 0.25s --
            // chosen because Timestep=0.1 only divides evenly into multiples of
            // 0.1s; 0.25s is not an exact multiple and would force a fractional/
            // rounded step count. This is an explicit environment parameter choice,
            // not a permanent design decision.
            private void AdvanceSimulation(MotorwaysGame testGame, double deltaSeconds)
            {
                Server.ISimulation sim = testGame.Simulation;
                // Math.Round(double, MidpointRounding) is MISSING from this game's
                // stripped Mono BCL (confirmed live: MissingMethodException on every
                // call -- the same class of stripped-corlib gap documented since
                // Phase 0/3). Avoid Math.Round entirely rather than patch corlib
                // again: manual round-half-up via integer truncation.
                int steps = (int)((deltaSeconds / 0.1) + 0.5);
                // Visible mode keeps the attached game PAUSED (Simulation.Step with
                // IsPaused==true advances clock/processes by Fix64.Zero -- the shipped
                // pause semantics) so the screen's own per-frame _game.Tick can drive
                // views/HUD in real time without advancing simulated time. Our
                // controlled steps therefore open a synchronous unpause window: this
                // whole method runs inside one main-thread slice, so the screen's Tick
                // can never observe the unpaused state. Headless games are never
                // paused, so this is a no-op there.
                // Restore pause whenever this is the frontend-attached game, not just
                // when it was paused on entry: a stock flow may have leaked an
                // unpause between decisions (see the per-frame re-assertion in
                // Update()), and leaving it unpaused here would hand the clock back
                // to the screen's real-time Tick.
                bool mustRestorePause = sim.IsPaused || (_ipcVisibleActive && ReferenceEquals(testGame, _ipcGame));
                sim.IsPaused = false;
                try
                {
                    for (int i = 0; i < steps; i++)
                    {
                        sim.Step();
                    }
                }
                finally
                {
                    if (mustRestorePause) sim.IsPaused = true;
                }

                // Synchronous week-end screen suppression, in the SAME main-thread
                // slice the grant lands in: the per-frame Update guard alone can lose
                // a frame-order race against GameplayEventHandler (the screen's Tick
                // may run before our Update next frame and push the GameUpgradeScreen
                // -- observed live). Marking the grant as handled here, before any
                // frame boundary, closes that race deterministically. Model claims
                // stay forced via the action mask.
                if (_ipcVisibleActive && ReferenceEquals(testGame, _ipcGame) && !_ipcFreePlay)
                {
                    try
                    {
                        UpgradeDatabaseModel upModel = testGame.Simulation.GetModel<UpgradeDatabaseModel>();
                        if (upModel != null && upModel.pendingUpgradeChoices != null
                            && upModel.pendingUpgradeChoices.Count > upModel.numChoicesMade)
                        {
                            WriteLine($"[Phase10] Suppressing stock GameUpgradeScreen push (synchronous, post-advance): numChoicesMade {upModel.numChoicesMade} -> {upModel.pendingUpgradeChoices.Count}.");
                            upModel.numChoicesMade = upModel.pendingUpgradeChoices.Count;
                        }
                    }
                    catch (Exception) { }
                }
            }

            // Terminal state (Phase 8 terminal-state handling). MotorwaysGame.
            // HasGameEnded is the authoritative native flag (public getter, private
            // setter, set exactly once by MotorwaysGame.OnGameEnd(GameEndReason)).
            // Confirmed via decompilation that under GameMode.Normal the ONLY path
            // to OnGameEnd(GameEndReason.GameOver) is DestinationModel.OnOvercrowded
            // -> GameplayEventHandler.OnDestinationOvercrowded -> EndGame ->
            // ScreenStack.PushScreen(GameOver) -> GameOverScreen.TransitionIn ->
            // _game.OnGameEnd(GameOver) -- i.e. it runs through the UI screen stack.
            // This bootstrap never drives that screen stack, so HasGameEnded may
            // never flip to true even if a destination genuinely overcrowds. This is
            // reported honestly rather than papered over with a custom threshold:
            // IsTerminal reads the real native flag (never invents its own), and
            // this phase's episodes are expected to end via truncation (decision
            // count / simulated-time horizon), not native termination, given how
            // short they are and this architectural caveat. See PHASE_8 doc.
            private bool IsTerminal(MotorwaysGame testGame)
            {
                // Native flag first (set by the stock game-over flow when it runs).
                try { if (testGame.HasGameEnded) return true; } catch (Exception) { return true; }
                // Model-level game-over: a destination's overcrowding timer reaching
                // MaxOvercrowdTime is the EXACT native trigger
                // (DestinationModel.OnOvercrowded -> GameplayEventHandler.EndGame).
                // Detecting it one native step early (epsilon 0.11s) pre-empts the
                // stock EndGame UI push, which the screen-free design must never
                // let run -- and it finally unifies headless and visible terminal
                // semantics (headless episodes previously NEVER terminated, the
                // documented Phase 8 caveat).
                try
                {
                    // Pre-emption window = ONE DECISION (plus margin), not one native
                    // tick: each decision advances _ipcDecisionDeltaSeconds of
                    // simulated time in a burst, so the timer can cross the stock
                    // threshold MID-advance. If it could cross within the next
                    // advance, the episode is terminal NOW -- the absorbing-terminal
                    // guard then never steps again and the stock EndGame/GameOver
                    // screen can never fire (confirmed leaking with a 1-tick window).
                    double maxT = (double)testGame.Scope.Get<SimulationConstantsData>().MaxOvercrowdTime;
                    double preempt = _ipcDecisionDeltaSeconds + 0.05;
                    ModelList<DestinationModel> dests = testGame.Simulation.GetModels<DestinationModel>();
                    for (int i = 0; i < dests.Count; i++)
                    {
                        if ((double)dests[i].CurrentFrame.OvercrowdingTime >= maxT - preempt) return true;
                    }
                }
                catch (Exception) { }
                return false;
            }

            private static string HashJson(string json)
            {
                using (var sha = System.Security.Cryptography.SHA256.Create())
                {
                    byte[] hash = sha.ComputeHash(System.Text.Encoding.UTF8.GetBytes(json));
                    var sb = new System.Text.StringBuilder();
                    for (int i = 0; i < 8; i++) sb.Append(hash[i].ToString("x2"));
                    return sb.ToString();
                }
            }

            // Canonical, human-observable PolicyObservation (Phase 8 Part 1).
            // Deliberately separate from BuildSnapshotJson (Phase 6A's privileged
            // diagnostic snapshot, kept below unchanged) -- this contains ONLY
            // fields a human playing normally could reasonably see/infer. Excluded
            // on purpose (privileged, per Phase 6A's tagging): contributedSupply/
            // demandMultiplier/RequiredSupply, the unassignedDemand-vs-waitingDemand
            // SPLIT (only the visible TOTAL pin count is included), vehicle route/
            // pathfinding internals, lane-graph object identity, RNG state. Vehicle
            // WORLD POSITION is included (a human sees cars on screen) but per-
            // vehicle native id/house/destination REFERENCES are not (a human
            // cannot read a vehicle's internal id or wire it to a specific trip by
            // inspecting object identity) -- instead, tiles[] carries an aggregate,
            // OBSERVABLE visibleVehicleCount per tile. Iteration is row-major
            // (y then x) over the fixed CityDefinition.PlayableArea rectangle --
            // deterministic regardless of any dictionary/hash-set iteration order
            // inside the native models. Coordinates are UnityEngine.Vector2Int, the
            // canonical grid coordinate system identified in Phase 6A.
            private string BuildPolicyObservation(MotorwaysGame testGame)
            {
                Server.ISimulation sim = testGame.Simulation;
                CityDefinition cityDef = testGame.StartedWithCityDefinition;
                TilemapModel tilemap = sim.GetModel<TilemapModel>();
                ClockModel clock = sim.GetModel<ClockModel>();
                RectInt bounds = cityDef.PlayableArea;

                var sb = new System.Text.StringBuilder();
                sb.Append("{");
                sb.Append($"\"simulationTime\":{Inv((double)clock.Time)},");
                sb.Append($"\"bounds\":{{\"xMin\":{bounds.xMin},\"yMin\":{bounds.yMin},\"width\":{bounds.width},\"height\":{bounds.height}}},");

                sb.Append("\"tiles\":[");
                TileDirection[] cardinal = { TileDirection.North, TileDirection.East, TileDirection.South, TileDirection.West };
                bool firstTile = true;
                for (int y = bounds.yMin; y < bounds.yMin + bounds.height; y++)
                {
                    for (int x = bounds.xMin; x < bounds.xMin + bounds.width; x++)
                    {
                        Vector2Int coord = new Vector2Int(x, y);
                        if (!firstTile) sb.Append(",");
                        firstTile = false;

                        Tile tile = tilemap.GetTile(coord);
                        TileModel tileModel = tilemap.GetTileModel(coord);

                        sb.Append($"{{\"coord\":{JVec2Int(coord)},");
                        sb.Append($"\"buildable\":{JBool(cityDef.TileIsBuildable(coord))},\"overWater\":{JBool(cityDef.TileIsOverWater(coord))},\"underMountain\":{JBool(cityDef.TileIsUnderAMountain(coord))},\"overRail\":{JBool(cityDef.TileIsOverRail(coord))},");

                        string roadN = tile != null ? tile.GetTwoLaneRoadStateInDirection(TileDirection.North).ToString() : "None";
                        string roadE = tile != null ? tile.GetTwoLaneRoadStateInDirection(TileDirection.East).ToString() : "None";
                        string roadS = tile != null ? tile.GetTwoLaneRoadStateInDirection(TileDirection.South).ToString() : "None";
                        string roadW = tile != null ? tile.GetTwoLaneRoadStateInDirection(TileDirection.West).ToString() : "None";
                        sb.Append($"\"road\":{{\"N\":{JStr(roadN)},\"E\":{JStr(roadE)},\"S\":{JStr(roadS)},\"W\":{JStr(roadW)}}},");

                        bool hasTrafficLight = tile != null && tile.HasTrafficLight;
                        bool hasRoundabout = tile != null && (tile.IsCenterOfRoundabout || tile.HasRoundabout(RoadState.VisiblyActive));
                        var motorwayDirs = new System.Collections.Generic.List<string>();
                        if (tile != null)
                        {
                            foreach (TileDirection d in cardinal)
                            {
                                if (tile.GetMotorwayInDirection(d, RoadState.VisiblyActive) != -1) motorwayDirs.Add(JStr(d.ToString()));
                            }
                        }
                        sb.Append($"\"hasTrafficLight\":{JBool(hasTrafficLight)},\"hasRoundabout\":{JBool(hasRoundabout)},\"motorwayDirections\":[{string.Join(",", motorwayDirs)}],");

                        string contentType = tile != null ? tile.ContentType.ToString() : "None";
                        sb.Append($"\"contentType\":{JStr(contentType)},");

                        int? groupIndex = null;
                        string destinationInfo = "null";
                        if (tile?.ContentModel is HouseModel house)
                        {
                            groupIndex = house.GroupIndex;
                        }
                        else if (tile?.ContentModel is DestinationModel destination)
                        {
                            groupIndex = destination.GroupIndex;
                            string destType = destination.IsTrainStation ? "TrainStation" : (destination.IsBoatTerminal ? "BoatTerminal" : "Destination");
                            destinationInfo = $"{{\"destinationType\":{JStr(destType)},\"totalDemand\":{destination.TotalDemand},\"isOvercrowding\":{JBool(destination.IsOvercrowding)},\"overcrowdingTime\":{Inv((double)destination.CurrentFrame.OvercrowdingTime)},\"isUpgraded\":{JBool(destination.IsUpgraded)}}}";
                        }
                        sb.Append($"\"groupIndex\":{(groupIndex.HasValue ? groupIndex.Value.ToString() : "null")},\"destination\":{destinationInfo},");

                        int visibleVehicleCount = tileModel?.roadChunk?.traversingVehicles?.Count ?? 0;
                        sb.Append($"\"visibleVehicleCount\":{visibleVehicleCount}");
                        sb.Append("}");
                    }
                }
                sb.Append("],");

                UpgradeDatabaseModel upgrades = sim.GetModel<UpgradeDatabaseModel>();
                ScoreModel score = sim.GetModel<ScoreModel>();
                sb.Append("\"globals\":{");
                sb.Append($"\"hour\":{clock.Hour},\"day\":{clock.Day},\"week\":{clock.Week},");
                sb.Append($"\"score\":{score.Score},");
                sb.Append($"\"concreteAvailable\":{upgrades.GetAvailableUpgradeCount(UpgradeType.Concrete)},\"concreteTotal\":{upgrades.GetTotalUpgradeCount(UpgradeType.Concrete)},");
                sb.Append($"\"bridgesAvailable\":{upgrades.GetAvailableUpgradeCount(UpgradeType.Bridge)},\"bridgesTotal\":{upgrades.GetTotalUpgradeCount(UpgradeType.Bridge)},");
                sb.Append($"\"tunnelsAvailable\":{upgrades.GetAvailableUpgradeCount(UpgradeType.Tunnel)},\"tunnelsTotal\":{upgrades.GetTotalUpgradeCount(UpgradeType.Tunnel)},");
                sb.Append($"\"motorwaysAvailable\":{upgrades.GetAvailableUpgradeCount(UpgradeType.Motorway)},\"motorwaysTotal\":{upgrades.GetTotalUpgradeCount(UpgradeType.Motorway)},");
                sb.Append($"\"trafficLightsAvailable\":{upgrades.GetAvailableUpgradeCount(UpgradeType.TrafficLight)},\"trafficLightsTotal\":{upgrades.GetTotalUpgradeCount(UpgradeType.TrafficLight)},");
                sb.Append($"\"roundaboutsAvailable\":{upgrades.GetAvailableUpgradeCount(UpgradeType.Roundabout)},\"roundaboutsTotal\":{upgrades.GetTotalUpgradeCount(UpgradeType.Roundabout)},");
                sb.Append($"\"pendingUpgradeChoices\":{upgrades.pendingUpgradeChoices?.Count ?? 0},\"totalClaimedPackages\":{upgrades.TotalClaimedPackages}");
                sb.Append("}");

                sb.Append("}");
                return sb.ToString();
            }

            // The single Phase 8 episode runner: Reset(seed) -> loop{ Observe,
            // EnumerateLegalActions, [fixed or random] action, ApplyAction,
            // AdvanceSimulation, Observe } -> terminal/truncated -> teardown.
            // Reused for BOTH the determinism test (fixedActions != null, no RNG)
            // and RandomPolicy episodes (fixedActions == null, policyRng != null).
            // policyRng is a SEPARATE System.Random, never the game's own
            // global::Random -- selecting an action must never perturb simulation
            // determinism.
            private IEnumerator RunPolicyEpisode(IApp app, uint seed, CityDefinition cityDefinition, MapDefinition mapDefinition, RectInt actionBounds,
                System.Collections.Generic.List<ActionDescriptor> fixedActions, System.Random policyRng, int episodeLogIndex, int runLabel,
                System.Collections.Generic.List<string> fingerprintsOut, System.Collections.Generic.List<string> traceLinesOut, Action<string> onFirstObservation)
            {
                WriteLine($"[Phase9A] ----- Episode start: seed={seed}, mode={(fixedActions != null ? "fixed-action (determinism test run " + runLabel + ")" : "RandomPolicy episode " + episodeLogIndex)} -----");
                MotorwaysGame testGame = null;
                bool constructionSucceeded = false;

                try
                {
                    testGame = app.Scope.Get<MotorwaysGame>();
                    testGame.SetMapDefinition(mapDefinition);
                    global::Random.SetSimulationSeed(seed, app.Scope);
                    testGame.Start(cityDefinition, GameMode.Normal, null);
                    testGame.SetPaused(false, Plugins.Analytics.AnalyticsTypes.PauseReason.TransitionIn);
                    testGame.Tick(0f);
                    testGame.Tick(0f);
                    testGame.OnGameStarted();
                    WriteLine($"[Phase9A] Episode construct/Start/warm-up completed without throwing. Simulation.IsPaused={testGame.Simulation.IsPaused}.");
                    constructionSucceeded = true;
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] EXCEPTION during episode construction/start: {ex}");
                }

                if (constructionSucceeded)
                {
                    const double decisionDelta = 0.3;
                    const double maxSimTimeSeconds = 10.0;
                    int maxDecisions = fixedActions != null ? fixedActions.Count : 12;
                    const double pWait = 0.3;

                    int decisionIndex = 0;
                    bool terminated = false;
                    bool truncated = false;

                    while (decisionIndex < maxDecisions && !terminated && !truncated)
                    {
                        string obsBefore = null;
                        string fpBefore = null;
                        try
                        {
                            obsBefore = BuildPolicyObservation(testGame);
                            fpBefore = HashJson(obsBefore);
                            if (onFirstObservation != null) { onFirstObservation(obsBefore); onFirstObservation = null; }
                        }
                        catch (Exception ex)
                        {
                            WriteLine($"[Phase9A] EXCEPTION building observation at decision {decisionIndex}: {ex}");
                        }

                        System.Collections.Generic.List<ActionDescriptor> legalActions = null;
                        try
                        {
                            legalActions = EnumerateLegalActions(testGame, actionBounds);
                        }
                        catch (Exception ex)
                        {
                            WriteLine($"[Phase9A] EXCEPTION enumerating legal actions at decision {decisionIndex}: {ex}");
                            legalActions = new System.Collections.Generic.List<ActionDescriptor> { ActionDescriptor.Wait() };
                        }

                        ActionDescriptor action;
                        if (fixedActions != null)
                        {
                            action = fixedActions[decisionIndex];
                        }
                        else
                        {
                            var editActions = legalActions.FindAll(a => a.Kind != ActionKind.Wait);
                            if (editActions.Count == 0 || policyRng.NextDouble() < pWait)
                            {
                                action = ActionDescriptor.Wait();
                            }
                            else
                            {
                                action = editActions[policyRng.Next(editActions.Count)];
                            }
                        }

                        int resourcesBefore = -1;
                        try { resourcesBefore = testGame.Simulation.GetModel<UpgradeDatabaseModel>().GetAvailableUpgradeCount(UpgradeType.Concrete); } catch { }

                        // Permanent pre-action safety gate (per explicit user
                        // direction: must remain even after the isolation bug is
                        // solved). If this ever fails, the action is replaced with a
                        // WAIT rather than executed -- never skip the gate itself.
                        bool isolationOk = _isolationDiagnosticTestPlayer == null
                            || AssertPersistenceIsolated(app, _isolationDiagnosticTestPlayer, testGame, $"pre-action-decision{decisionIndex}");
                        if (!isolationOk)
                        {
                            WriteLine($"[Phase9A] *** ABORTING action at decision {decisionIndex}: AssertPersistenceIsolated FAILED. Forcing WAIT instead of {action}. ***");
                            action = ActionDescriptor.Wait();
                        }

                        bool accepted = false;
                        string applyInfo = "";
                        try
                        {
                            accepted = ApplyAction(testGame, action, out applyInfo);
                        }
                        catch (Exception ex)
                        {
                            applyInfo = $"EXCEPTION: {ex}";
                            WriteLine($"[Phase9A] EXCEPTION applying action {action} at decision {decisionIndex}: {ex}");
                        }

                        try
                        {
                            AdvanceSimulation(testGame, decisionDelta);
                        }
                        catch (Exception ex)
                        {
                            WriteLine($"[Phase9A] EXCEPTION during AdvanceSimulation at decision {decisionIndex}: {ex}");
                        }

                        int resourcesAfter = -1;
                        try { resourcesAfter = testGame.Simulation.GetModel<UpgradeDatabaseModel>().GetAvailableUpgradeCount(UpgradeType.Concrete); } catch { }

                        string obsAfter = null;
                        string fpAfter = null;
                        try
                        {
                            obsAfter = BuildPolicyObservation(testGame);
                            fpAfter = HashJson(obsAfter);
                        }
                        catch (Exception ex)
                        {
                            WriteLine($"[Phase9A] EXCEPTION building post-action observation at decision {decisionIndex}: {ex}");
                        }

                        double simTimeNow = (double)testGame.Simulation.GetModel<ClockModel>().Time;
                        WriteLine($"[Phase9A] decision {decisionIndex}: simTime={simTimeNow:F2} action={action} legalActionCount={legalActions.Count} accepted={accepted} resources(concrete) {resourcesBefore}->{resourcesAfter} fp {fpBefore}->{fpAfter} [{applyInfo}]");

                        if (fingerprintsOut != null) fingerprintsOut.Add(fpAfter);

                        if (traceLinesOut != null)
                        {
                            string line = "{" +
                                $"\"episode\":{episodeLogIndex},\"decisionIndex\":{decisionIndex},\"simulationTime\":{Inv(simTimeNow)}," +
                                $"\"observationFingerprint\":{JStr(fpBefore)},\"legalActionCount\":{legalActions.Count}," +
                                $"\"selectedAction\":{JStr(action.ToString())},\"actionAccepted\":{JBool(accepted)}," +
                                $"\"resourcesBefore\":{resourcesBefore},\"resourcesAfter\":{resourcesAfter}," +
                                $"\"nextObservationFingerprint\":{JStr(fpAfter)}" +
                                "}";
                            traceLinesOut.Add(line);
                        }

                        terminated = IsTerminal(testGame);
                        decisionIndex++;
                        if (fixedActions == null && (decisionIndex >= maxDecisions || simTimeNow >= maxSimTimeSeconds))
                        {
                            truncated = true;
                        }

                        yield return null;
                    }

                    WriteLine($"[Phase9A] Episode loop finished after {decisionIndex} decision(s): terminated={terminated} (native game-over, via MotorwaysGame.HasGameEnded) truncated={truncated} (decision/time limit).");
                }

                if (testGame != null)
                {
                    try
                    {
                        testGame.StopAudio();
                        testGame.ClearPathfinder();
                        testGame.Scope.ParentScope.Release(testGame);
                        WriteLine("[Phase9A] Episode teardown completed without throwing.");
                    }
                    catch (Exception ex)
                    {
                        WriteLine($"[Phase9A] EXCEPTION during episode teardown: {ex}");
                    }
                }
            }

            // ---- Phase 6A SimulationSnapshot: pure read-only diagnostic capture ----
            // Every call below is a plain property/field read or a Get<T>()/
            // GetModel<T>()/GetModels<T>() resolution -- no ScheduleCommand, no
            // Tick(), no Store()/Delete(), nothing that mutates simulation or
            // persistent state. Numeric formatting uses InvariantCulture explicitly
            // because this process's locale (confirmed Turkish from earlier phases'
            // log output, e.g. "0,9000000008") would otherwise emit comma decimal
            // separators into the JSON, making it invalid.
            private static string Inv(double d) => d.ToString("R", System.Globalization.CultureInfo.InvariantCulture);

            private static string JStr(string s)
            {
                if (s == null) return "null";
                var sb = new System.Text.StringBuilder();
                sb.Append('"');
                foreach (char c in s)
                {
                    if (c == '"' || c == '\\') sb.Append('\\').Append(c);
                    else if (c == '\n') sb.Append("\\n");
                    else if (c == '\r') { }
                    else sb.Append(c);
                }
                sb.Append('"');
                return sb.ToString();
            }

            private static string JVec2Int(Vector2Int v) => $"[{v.x},{v.y}]";

            private static string JBool(bool b) => b ? "true" : "false";

            private string BuildSnapshotJson(IApp app, MotorwaysGame testGame, int sampleIndex, double realElapsedSeconds)
            {
                Server.ISimulation sim = testGame.Simulation;
                var sb = new System.Text.StringBuilder();
                sb.Append("{");
                sb.Append($"\"sampleIndex\":{sampleIndex},\"realElapsedSeconds\":{Inv(realElapsedSeconds)},");

                // --- time ---
                ClockModel clock = sim.GetModel<ClockModel>();
                sb.Append("\"time\":{");
                sb.Append($"\"time\":{Inv((double)clock.Time)},\"hour\":{clock.Hour},\"day\":{clock.Day},\"week\":{clock.Week},");
                sb.Append($"\"expansionTime\":{Inv((double)clock.ExpansionTime)},\"isPaused\":{JBool(clock.isPaused)},\"simulationIsPaused\":{JBool(sim.IsPaused)}");
                sb.Append("},");

                // --- score ---
                ScoreModel score = sim.GetModel<ScoreModel>();
                sb.Append("\"score\":{");
                sb.Append($"\"score\":{score.Score},\"efficiencyScore\":{Inv((double)score.EfficiencyScore)},\"currentEfficiencyMilestone\":{score.CurrentEfficiencyMilestone}");
                sb.Append("},");

                // --- bounds (from the CityDefinition this episode was started with, not a simulation model) ---
                RectInt bounds = testGame.StartedWithCityDefinition != null ? testGame.StartedWithCityDefinition.PlayableArea : default(RectInt);
                sb.Append($"\"bounds\":{{\"xMin\":{bounds.xMin},\"yMin\":{bounds.yMin},\"width\":{bounds.width},\"height\":{bounds.height}}},");

                // --- resources (UpgradeDatabaseModel, inherited UpgradeDatabase accessors) ---
                UpgradeDatabaseModel upgrades = sim.GetModel<UpgradeDatabaseModel>();
                sb.Append("\"resources\":[");
                var upgradeTypes = (UpgradeType[])Enum.GetValues(typeof(UpgradeType));
                bool firstResource = true;
                foreach (UpgradeType ut in upgradeTypes)
                {
                    if (ut == UpgradeType.Count) continue;
                    if (!firstResource) sb.Append(",");
                    firstResource = false;
                    sb.Append($"{{\"type\":{JStr(ut.ToString())},\"available\":{upgrades.GetAvailableUpgradeCount(ut)},\"total\":{upgrades.GetTotalUpgradeCount(ut)}}}");
                }
                sb.Append("],");
                sb.Append($"\"upgrades\":{{\"totalClaimedPackages\":{upgrades.TotalClaimedPackages},\"pendingChoices\":{upgrades.pendingUpgradeChoices?.Count ?? 0},\"numChoicesMade\":{upgrades.numChoicesMade}}},");

                // --- failure state (global gate; per-destination overcrowd state is in destinations[] below) ---
                GameBehaviourModel behaviour = sim.GetModel<GameBehaviourModel>();
                sb.Append($"\"failureState\":{{\"canGameOver\":{JBool(behaviour?.CanGameOver ?? false)}}},");

                // --- houses ---
                ModelList<HouseModel> houses = sim.GetModels<HouseModel>();
                sb.Append("\"houses\":[");
                for (int i = 0; i < houses.Count; i++)
                {
                    HouseModel h = houses[i];
                    if (i > 0) sb.Append(",");
                    Vector2Int coord = h.tileModel != null ? h.tileModel.Coordinates : default(Vector2Int);
                    sb.Append($"{{\"coord\":{JVec2Int(coord)},\"groupIndex\":{h.GroupIndex},\"waitingVehicles\":{h.waitingVehicles.Count},\"ownedVehicles\":{h.ownedVehicles.Count}}}");
                }
                sb.Append("],");

                // --- destinations ---
                ModelList<DestinationModel> destinations = sim.GetModels<DestinationModel>();
                sb.Append("\"destinations\":[");
                for (int i = 0; i < destinations.Count; i++)
                {
                    DestinationModel d = destinations[i];
                    if (i > 0) sb.Append(",");
                    string footprint = d.TileModels != null ? string.Join(",", d.TileModels.Select(t => JVec2Int(t.Coordinates))) : "";
                    string destType = d.IsTrainStation ? "TrainStation" : (d.IsBoatTerminal ? "BoatTerminal" : "Destination");
                    sb.Append($"{{\"footprint\":[{footprint}],\"groupIndex\":{d.GroupIndex},\"destinationType\":{JStr(destType)},");
                    sb.Append($"\"unassignedDemand\":{d.unassignedDemand.Count},\"waitingDemand\":{d.waitingDemand.Count},\"totalDemand\":{d.TotalDemand},");
                    sb.Append($"\"isOvercrowding\":{JBool(d.IsOvercrowding)},\"overcrowdingTime\":{Inv((double)d.CurrentFrame.OvercrowdingTime)},\"isUpgraded\":{JBool(d.IsUpgraded)}}}");
                }
                sb.Append("],");

                // --- vehicles ---
                ModelList<VehicleModel> vehicles = sim.GetModels<VehicleModel>();
                sb.Append("\"vehicles\":[");
                for (int i = 0; i < vehicles.Count; i++)
                {
                    VehicleModel v = vehicles[i];
                    if (i > 0) sb.Append(",");
                    Vector2Int? houseCoord = v.house?.tileModel != null ? v.house.tileModel.Coordinates : (Vector2Int?)null;
                    string worldPos = "null";
                    try
                    {
                        if (v.CurrentFrame.lane != null)
                        {
                            Vector2Fixed pos = v.CurrentFrame.lane.PositionAtDistance(v.CurrentFrame.distanceAlongLane);
                            worldPos = $"[{Inv((double)pos.x)},{Inv((double)pos.y)}]";
                        }
                    }
                    catch { /* best-effort; leave as null if the lane reports no position */ }
                    sb.Append($"{{\"id\":{v.id},\"houseCoord\":{(houseCoord.HasValue ? JVec2Int(houseCoord.Value) : "null")},\"behaviorState\":{JStr(v.behaviorState.ToString())},\"worldPosition\":{worldPos},\"speed\":{Inv((double)v.CurrentFrame.speed)}}}");
                }
                sb.Append("],");

                // --- road summary + motorways + passages (model-layer infrastructure; Task 1's tilemap/road/motorway/bridge/tunnel cluster) ---
                ModelList<LaneModel> lanes = sim.GetModels<LaneModel>();
                int planned = 0, pending = 0, active = 0, mothballed = 0;
                for (int i = 0; i < lanes.Count; i++)
                {
                    switch (lanes[i].state)
                    {
                        case RoadState.Planned: planned++; break;
                        case RoadState.Pending: pending++; break;
                        case RoadState.Active: active++; break;
                        case RoadState.Mothballed: mothballed++; break;
                    }
                }
                ModelList<MotorwayModel> motorways = sim.GetModels<MotorwayModel>();
                ModelList<PassageModel> passages = sim.GetModels<PassageModel>();
                ModelList<TrafficLightModel> trafficLights = sim.GetModels<TrafficLightModel>();
                ModelList<RoundaboutModel> roundabouts = sim.GetModels<RoundaboutModel>();
                sb.Append($"\"roadSummary\":{{\"totalLanes\":{lanes.Count},\"planned\":{planned},\"pending\":{pending},\"active\":{active},\"mothballed\":{mothballed},");
                sb.Append($"\"motorwayCount\":{motorways.Count},\"passageCount\":{passages.Count},\"trafficLightCount\":{trafficLights.Count},\"roundaboutCount\":{roundabouts.Count}}},");

                sb.Append("\"motorways\":[");
                for (int i = 0; i < motorways.Count; i++)
                {
                    MotorwayModel m = motorways[i];
                    if (i > 0) sb.Append(",");
                    sb.Append($"{{\"id\":{m.Id},\"number\":{m.Number},\"state\":{JStr(m.State.ToString())},\"start\":{JVec2Int(m.StartCoordinates)},\"end\":{JVec2Int(m.EndCoordinates)}}}");
                }
                sb.Append("],");

                sb.Append("\"passages\":[");
                for (int i = 0; i < passages.Count; i++)
                {
                    Passage p = passages[i].Passage;
                    if (i > 0) sb.Append(",");
                    sb.Append($"{{\"upgradeType\":{JStr(p.UpgradeType.ToString())},\"start\":{JVec2Int(p.StartCoordinates)},\"end\":{JVec2Int(p.EndCoordinates)},\"length\":{p.Length},\"isComplete\":{JBool(p.IsComplete)}}}");
                }
                sb.Append("]");

                sb.Append("}");
                return sb.ToString();
            }

            // Obtains a CityDefinition/MapDefinition purely via code, no UI/input.
            // Two paths, in order of preference:
            //   (a) reuse the already-loaded CityDefinition/MapDefinition from a
            //       manually-started session, if one happens to exist (zero-cost,
            //       read-only, confirmed instances);
            //   (b) autonomous path, confirmed via decompiled source: MapDatabase is
            //       a Scope-bound singleton already synchronously loaded by
            //       container-build time (AssetBundleUtility.LoadAsset, blocking,
            //       at app-container construction -- not something we trigger), so
            //       app.Scope.Get<MapDatabase>().MapLibrary.Maps gives real
            //       MapDefinitions immediately with no coroutine needed for that
            //       part. Only the subsequent CityDefinition PREFAB load is async
            //       (AssetBundleUtility.LoadPrefabAsync -- the exact same call
            //       GameStarter.LoadMapDefinition makes), typically a couple of
            //       frames for a first-time bundle load.
            private IEnumerator GetCityDefinitionForTesting(IApp app, Game existingGame, Action<Tuple<CityDefinition, MapDefinition>> onResult)
            {
                var motorwaysGame = existingGame as MotorwaysGame;
                if (motorwaysGame?.StartedWithCityDefinition != null && motorwaysGame.MapDefinition != null)
                {
                    WriteLine("[Phase9A] Reusing the existing manually-started session's CityDefinition/MapDefinition (read-only) for test cycles.");
                    onResult(Tuple.Create(motorwaysGame.StartedWithCityDefinition, motorwaysGame.MapDefinition));
                    yield break;
                }

                WriteLine("[Phase9A] No existing session to borrow from -- loading a MapDefinition autonomously via app.Scope.Get<MapDatabase>() (no UI).");
                MapDefinition mapDefinition;
                try
                {
                    MapDatabase mapDatabase = app.Scope.Get<MapDatabase>();
                    mapDefinition = mapDatabase.MapLibrary.Maps.First();
                    WriteLine($"[Phase9A] Resolved MapDatabase synchronously; selected first map: cityName='{mapDefinition.cityName}', bundle='{mapDefinition.mapAssetBundle}', prefab='{mapDefinition.mapPrefabName}'.");
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] Failed to resolve MapDatabase/MapDefinition: {ex}");
                    onResult(Tuple.Create<CityDefinition, MapDefinition>(null, null));
                    yield break;
                }

                AssetBundleUtility.AsyncLoadResult loadResult;
                try
                {
                    loadResult = AssetBundleUtility.LoadPrefabAsync(mapDefinition.mapAssetBundle, mapDefinition.mapPrefabName, this);
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] AssetBundleUtility.LoadPrefabAsync threw: {ex}");
                    onResult(Tuple.Create<CityDefinition, MapDefinition>(null, null));
                    yield break;
                }

                float waitStart = Time.realtimeSinceStartup;
                while (loadResult != null && !loadResult.HasValue && Time.realtimeSinceStartup - waitStart < 30f)
                {
                    yield return null;
                }

                if (loadResult == null || !loadResult.HasValue)
                {
                    WriteLine("[Phase9A] CityDefinition prefab did not finish loading within 30s. Aborting.");
                    onResult(Tuple.Create<CityDefinition, MapDefinition>(null, null));
                    yield break;
                }

                try
                {
                    GameObject prefabInstance = UnityEngine.Object.Instantiate(loadResult.asset as GameObject);
                    CityDefinition cityDefinition = prefabInstance.GetComponent<CityDefinition>();
                    if (cityDefinition == null)
                    {
                        WriteLine("[Phase9A] Instantiated prefab has no CityDefinition component. Aborting.");
                        UnityEngine.Object.Destroy(prefabInstance);
                        onResult(Tuple.Create<CityDefinition, MapDefinition>(null, null));
                        yield break;
                    }
                    WriteLine($"[Phase9A] Autonomously loaded and instantiated CityDefinition '{cityDefinition.name}' for map '{mapDefinition.cityName}' (no UI interaction).");

                    // Phase 5C fix for Phase 5B's second failure (BridgeSpouts/
                    // RoadTileAtlas NullReferenceException): explicitly call the
                    // existing public, idempotent CompileTilemap() now, rather than
                    // guessing at a Unity Awake/OnEnable frame-count wait. Confirmed
                    // via decompilation: this is the SAME method City.Definition's
                    // own setter calls internally (ARCHITECTURE.md), and it is safe
                    // to call here since it no-ops if already compiled (private
                    // _isCompiled guard). This is calling an existing PUBLIC game
                    // method, not invoking a Unity lifecycle method ourselves.
                    cityDefinition.CompileTilemap();
                    WriteLine($"[Phase9A] Called CityDefinition.CompileTilemap() explicitly (public, idempotent method) before use.");

                    onResult(Tuple.Create(cityDefinition, mapDefinition));
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase9A] Failed to instantiate CityDefinition prefab: {ex}");
                    onResult(Tuple.Create<CityDefinition, MapDefinition>(null, null));
                }
            }

            // Root cause found live: Phase 10's visible-training RESET reused the
            // SAME shared _ipcCityDefinition GameObject (instantiated once at boot)
            // across every episode. GameContainerScreen.PrepareForMap's own
            // CleanupPreviousGame() destroys the PREVIOUS episode's city GameObject
            // when attaching a new one -- fine for a human who gets a fresh
            // CityDefinition each "new game", but fatal for us reusing the same
            // instance: every episode after the first ran against a Unity "fake
            // null" (a C# reference to an ALREADY-DESTROYED UnityEngine.Object).
            // Confirmed exactly this via the live stack trace: EVERY STEP call
            // after the first episode threw NullReferenceException inside
            // UnityEngine.Object.get_name(), reached via
            // DemandModel.GetGroupDemandOscillationOffset -> Diagnostics.Verify's
            // "{2}" format argument -> _city.Definition.name -- a destroyed
            // CityDefinition's .name getter. The headless RESET path never hit
            // this because headless MotorwaysGame.Start() has no such screen-level
            // cleanup step. Fix: give every VISIBLE episode its own fresh
            // CityDefinition instance (re-instantiate the prefab, exactly like
            // GetCityDefinitionForTesting did once at boot), never reusing one
            // across episodes, so each one is safe to let GameContainerScreen
            // destroy when the NEXT episode's cleanup runs.
            private IEnumerator InstantiateFreshCityDefinitionForEpisode(MapDefinition mapDefinition, Action<CityDefinition> onResult)
            {
                AssetBundleUtility.AsyncLoadResult loadResult;
                try
                {
                    loadResult = AssetBundleUtility.LoadPrefabAsync(mapDefinition.mapAssetBundle, mapDefinition.mapPrefabName, this);
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase10] AssetBundleUtility.LoadPrefabAsync threw (fresh per-episode city): {ex}");
                    onResult(null);
                    yield break;
                }

                float waitStart = Time.realtimeSinceStartup;
                while (loadResult != null && !loadResult.HasValue && Time.realtimeSinceStartup - waitStart < 30f)
                {
                    yield return null;
                }
                if (loadResult == null || !loadResult.HasValue)
                {
                    WriteLine("[Phase10] Fresh per-episode CityDefinition prefab did not finish loading within 30s. Aborting.");
                    onResult(null);
                    yield break;
                }

                try
                {
                    GameObject prefabInstance = UnityEngine.Object.Instantiate(loadResult.asset as GameObject);
                    CityDefinition cityDefinition = prefabInstance.GetComponent<CityDefinition>();
                    if (cityDefinition == null)
                    {
                        WriteLine("[Phase10] Fresh per-episode prefab has no CityDefinition component. Aborting.");
                        UnityEngine.Object.Destroy(prefabInstance);
                        onResult(null);
                        yield break;
                    }
                    cityDefinition.CompileTilemap();
                    onResult(cityDefinition);
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase10] Failed to instantiate fresh per-episode CityDefinition prefab: {ex}");
                    onResult(null);
                }
            }

            // ================= Phase 10: C# <-> Python IPC bridge =================
            //
            // Transport: plain request/response FILES, not TCP sockets. A first
            // version of this bridge used a loopback TcpListener; live testing
            // showed builds referencing System.Net.Sockets reproducibly stalled
            // the game process for MINUTES before it even reached its first
            // SceneManager.sceneLoaded event (confirmed not a launch-method or
            // system-load artifact -- a clean PowerShell Start-Process launch of
            // the exact same build showed the identical stall, while the same
            // launch of a build WITHOUT socket APIs booted normally in seconds).
            // This is consistent with antivirus/real-time-protection heuristic
            // scanning of a freshly-built, unsigned DLL that opens a network
            // listener. Rather than ask for a Defender exclusion (a security-
            // setting change outside what this bootstrap should do on its own),
            // the transport was changed to plain file read/write -- the SAME
            // System.IO this bootstrap already uses for its own log file, with no
            // new APIs introduced, so there is nothing new for AV heuristics to
            // flag. Protocol: Python writes one JSON object (with an incrementing
            // integer "id") to ipcRequestPath; this bootstrap polls for a new id
            // once per Unity frame (Update(), main-thread only -- required, since
            // EnumerateLegalActions/ApplyAction/AdvanceSimulation/
            // BuildPolicyObservation/AssertPersistenceIsolated all touch live
            // Unity/game-state objects that are not thread-safe and no background
            // thread is involved at all here), processes it synchronously exactly
            // like the old per-request handler did, and atomically writes the
            // response (same "id" echoed back) to ipcResponsePath. Both files are
            // written via write-to-.tmp-then-replace so a reader never observes a
            // half-written file. Ops: HELLO, RESET(seed, max_decisions), STEP(action),
            // CLOSE, PING -- unchanged from the TCP version.
            private const string IpcProtocolVersion = "1.0";
            private const double IpcDecisionDelta = 0.3;
            // Last successfully-built observation/legal-mask JSON for the current
            // episode. When the native game over fires INSIDE a step's own
            // simulation advance (confirmed live: overcrowding -> GameOverScreen ->
            // OnGameEnd tears the game down mid-step, and the post-step
            // BuildPolicyObservation NREs), the step still must answer -- respond
            // with this cached observation and terminated=true so the trainer closes
            // the episode cleanly instead of dying on an error response.
            private string _ipcLastObsJson;
            private string _ipcLastLegalJson = "[0]";
            // Runtime-configurable decision interval (simulated seconds per agent
            // decision), set per episode via RESET's optional "decision_delta" field
            // (must be a positive multiple of the native 0.1s timestep). Larger
            // values cover more game time per IPC round-trip -- near-linear training
            // speedup over a fixed sim horizon -- at the cost of coarser control.
            private double _ipcDecisionDeltaSeconds = IpcDecisionDelta;
            private const int IpcDefaultMaxDecisions = 40;
            private const double IpcTerminalPenalty = -10.0;
            // Per explicit user request: supports running multiple game processes
            // concurrently (e.g. one doing real training, one as a debug sandbox)
            // without them fighting over the same request/response files. Each
            // process picks its own IPC folder via the MINI_MOTORWAYS_IPC_DIR
            // environment variable (set by whatever launches the process), falling
            // back to the original fixed path if unset so existing scripts/usage
            // keep working unchanged.
            private static readonly string IpcDir =
                Environment.GetEnvironmentVariable("MINI_MOTORWAYS_IPC_DIR")
                ?? @"C:\Users\TKA\Desktop\mini moto\logs\ipc";
            private static readonly string IpcRequestPath = Path.Combine(IpcDir, "request.json");
            private static readonly string IpcResponsePath = Path.Combine(IpcDir, "response.json");

            private long _ipcLastProcessedId;
            private volatile bool _ipcShutdownRequested;

            private IApp _ipcApp;
            private CityDefinition _ipcCityDefinition;
            private MapDefinition _ipcMapDefinition;
            private MotorwaysGame _ipcGame;
            private RectInt _ipcActionBounds;
            private int _ipcActionSpaceSize;
            private int _ipcDecisionIndex;
            private int _ipcMaxDecisions;
            private double _ipcPrevScore;

            // Visible-training mode (added per explicit user request: every training
            // episode should be watchable through the real frontend, not just a
            // post-hoc replay). When true, every RESET attaches the new episode's
            // game to GameContainerScreen via the proven Phase 9A AttachGameToFrontend
            // path instead of constructing it headlessly -- STEP/ApplyAction/
            // AdvanceSimulation/BuildPolicyObservation/EnumerateLegalActions need NO
            // changes at all, since they already operate on whatever MotorwaysGame
            // instance _ipcGame currently points to, regardless of how it was built.
            private const bool IpcVisibleTraining = true;
            private bool _ipcVisibleActive;
            private CityDefinition _ipcEpisodeCity;

            // Clears any stale request/response files from a previous run (this
            // process is the only writer of IpcResponsePath and the only reader
            // of IpcRequestPath, so a leftover file from an earlier session could
            // otherwise be misread as a fresh request/response at id 0).
            private bool InitializeFileIpc()
            {
                try
                {
                    Directory.CreateDirectory(IpcDir);
                    // Deliberately KEEP a pending request.json: after a game-process
                    // death mid-training, the trainer is still waiting on it, and the
                    // fresh process serves it once init completes (self-healing
                    // episode-boundary recovery). Only stale responses/tmp are wiped.
                    if (File.Exists(IpcResponsePath)) File.Delete(IpcResponsePath);
                    if (File.Exists(IpcRequestPath + ".tmp")) File.Delete(IpcRequestPath + ".tmp");
                    if (File.Exists(IpcResponsePath + ".tmp")) File.Delete(IpcResponsePath + ".tmp");
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase10] EXCEPTION initializing file IPC directory {IpcDir}: {ex}");
                    return false;
                }
                _ipcLastProcessedId = 0;
                // Throughput: the IPC poll and the step pipeline are frame-quantized,
                // so the render loop's rate IS the decision-rate ceiling. Uncap it.
                try
                {
                    // vSyncCount is absent from this stripped CoreModule's compile-time
                    // surface; set it reflectively (it exists at runtime).
                    typeof(QualitySettings).GetProperty("vSyncCount", BindingFlags.Public | BindingFlags.Static)?.SetValue(null, 0, null);
                    Application.targetFrameRate = 300;
                    // The stream window must keep rendering at all times, focused or
                    // not (it is a live stream source); the trainer must never pause
                    // when behind other windows either. The setter is compile-time
                    // hidden in this stripped CoreModule -- set reflectively.
                    var rib = typeof(Application).GetProperty("runInBackground", BindingFlags.Public | BindingFlags.Static);
                    var ribSet = rib != null ? rib.GetSetMethod(true) : null;
                    if (ribSet != null) ribSet.Invoke(null, new object[] { true });
                }
                catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION uncapping frame rate: {ex.Message}"); }
                return true;
            }

            // Called from Update() every real Unity frame (main thread only). A
            // request file that fails to parse is treated as "still being
            // written by Python" and simply retried next frame -- Python writes
            // via temp-file-then-replace too, so a reader should never actually
            // observe a torn write, but this is a cheap, harmless safety net.
            private void PollIpcRequestFile()
            {
                // Never touch requests before process init completes. Confirmed live:
                // after a game-process death mid-training, the auto-restarted process
                // read the trainer's still-pending RESET during its own boot
                // (_ipcMapDefinition not yet resolved) and answered it with a bogus
                // city_definition_instantiation_failed, killing the run. Leaving the
                // request untouched until init finishes lets the fresh process serve
                // it properly -- episode-boundary crashes become self-healing.
                if (_ipcMapDefinition == null || _ipcActionSpaceSize == 0) return;
                if (!File.Exists(IpcRequestPath)) return;

                string line;
                try
                {
                    line = File.ReadAllText(IpcRequestPath);
                }
                catch (IOException)
                {
                    return;
                }
                if (string.IsNullOrWhiteSpace(line)) return;

                object parsed;
                long requestId;
                try
                {
                    parsed = MiniJson.Parse(line);
                    var obj0 = parsed as System.Collections.Generic.Dictionary<string, object>;
                    requestId = obj0 != null && obj0.ContainsKey("id") ? (long)(double)obj0["id"] : -1;
                }
                catch (Exception)
                {
                    return;
                }
                if (requestId <= _ipcLastProcessedId) return;

                var obj1 = parsed as System.Collections.Generic.Dictionary<string, object>;
                string op1 = obj1 != null && obj1.ContainsKey("op") ? obj1["op"] as string : null;

                // Single-flight guard (confirmed live: a client-side retry sent a new
                // RESET while the previous RESET's attach coroutine was still
                // mid-flight; the two attaches raced and one crashed on the
                // InGame->InGame double-push, failing the whole run). While a visible
                // op is in flight, leave any new request untouched in the file -- it
                // is served the moment the in-flight op responds. The watchdog below
                // breaks a stuck flag (a coroutine that died without responding) so
                // one lost op can never deadlock the bridge.
                if (_ipcOpInFlight)
                {
                    if (Time.realtimeSinceStartup - _ipcOpInFlightSince > 120f)
                    {
                        WriteLine("[Phase10] WATCHDOG: in-flight visible op never responded within 120s -- clearing the single-flight guard.");
                        _ipcOpInFlight = false;
                    }
                    else return;
                }

                if (IpcVisibleTraining && op1 == "RESET")
                {
                    // Mark consumed BEFORE the coroutine starts -- it may span many
                    // frames (screen transition), and PollIpcRequestFile runs every
                    // frame; without this the same still-unanswered request file
                    // would be picked up and restarted on every subsequent frame.
                    _ipcLastProcessedId = requestId;
                    uint seed = obj1.ContainsKey("seed") ? (uint)(long)(double)obj1["seed"] : (uint)new System.Random().Next(1, int.MaxValue);
                    int maxDecisions = obj1.ContainsKey("max_decisions") ? (int)(double)obj1["max_decisions"] : IpcDefaultMaxDecisions;
                    double requestedDelta = obj1.ContainsKey("decision_delta") ? (double)obj1["decision_delta"] : IpcDecisionDelta;
                    _ipcStartMode = obj1.ContainsKey("start_mode") ? (obj1["start_mode"] as string ?? "NORMAL_START") : "NORMAL_START";
                    _ipcStartGap = obj1.ContainsKey("start_gap") ? Math.Max(0, (int)(double)obj1["start_gap"]) : 0;
                    _ipcStartGapIndex = obj1.ContainsKey("start_gap_index") ? (int)(double)obj1["start_gap_index"] : -1;
                    _ipcDecisionDeltaSeconds = requestedDelta >= 0.1 ? requestedDelta : IpcDecisionDelta;
                    _ipcOpInFlight = true; _ipcOpInFlightSince = Time.realtimeSinceStartup;
                    StartCoroutine(HandleIpcResetVisibleCoroutine(requestId, seed, maxDecisions));
                    return;
                }

                // Same reasoning as RESET above, for STEP: ONLY when a game is
                // currently frontend-attached (_ipcAttachedScreen != null) -- i.e.
                // only during visible training, never for headless RESET/STEP, whose
                // speed and synchronous semantics are completely unaffected by any of
                // this. Live evidence (user-reported, screenshot-confirmed) showed
                // that two Tick(0f) calls made back-to-back WITHIN THE SAME Unity
                // frame were not enough to fully initialize newly-created road/house
                // Views (untextured grey capsule shapes) -- consistent with view
                // theme/sprite assignment depending on Unity's own next-frame
                // Start()/OnEnable()/render lifecycle, which cannot run without an
                // actual frame boundary passing. HandleIpcStepVisibleCoroutine lets a
                // few REAL frames pass (yield return null) instead.
                if (IpcVisibleTraining && op1 == "STEP" && _ipcVisibleActive)
                {
                    _ipcLastProcessedId = requestId;
                    int actionIndex = obj1.ContainsKey("action") ? (int)(double)obj1["action"] : 0;
                    bool skipLegal = obj1.ContainsKey("skip_legal") && obj1["skip_legal"] is bool b && b;
                    bool realtime = obj1.ContainsKey("realtime") && obj1["realtime"] is bool rt && rt;
                    try
                    {
                        if (obj1.ContainsKey("overlay") && obj1["overlay"] is System.Collections.Generic.Dictionary<string, object> ov)
                        {
                            var sbOv = new StringBuilder();
                            foreach (var kv in ov)
                            {
                                if (sbOv.Length > 0) sbOv.Append('\n');
                                sbOv.Append(kv.Key).Append(": ").Append(kv.Value);
                            }
                            _overlayTrainerLines = sbOv.ToString();
                        }
                    }
                    catch (Exception) { }
                    _ipcOpInFlight = true; _ipcOpInFlightSince = Time.realtimeSinceStartup;
                    StartCoroutine(HandleIpcStepVisibleCoroutine(requestId, actionIndex, skipLegal, realtime));
                    return;
                }

                string response = HandleIpcRequestOnMainThread(line);
                _ipcLastProcessedId = requestId;
                WriteIpcResponse(requestId, response);
            }

            private void WriteIpcResponse(long requestId, string response)
            {
                _ipcOpInFlight = false; // every visible op ends in exactly one response
                // Echo the request id back so Python can match request<->response
                // (every handler returns a JSON object starting with '{').
                if (response.Length > 0 && response[0] == '{')
                {
                    response = "{\"id\":" + requestId + "," + response.Substring(1);
                }

                // Delete+Move can race Python's poll loop holding response.json open
                // for a read (confirmed live: IOException "being used by another
                // process", response silently lost, Python timed out). Python's read
                // window is sub-millisecond and it re-polls every 10ms, so a short
                // bounded retry always wins. Mirrors the retry Python already does
                // for its own os.replace() on request.json.
                try
                {
                    string tmp = IpcResponsePath + ".tmp";
                    File.WriteAllText(tmp, response);
                    const int maxAttempts = 100;
                    for (int attempt = 0; ; attempt++)
                    {
                        try
                        {
                            if (File.Exists(IpcResponsePath)) File.Delete(IpcResponsePath);
                            File.Move(tmp, IpcResponsePath);
                            break;
                        }
                        catch (IOException)
                        {
                            if (attempt >= maxAttempts) throw;
                            System.Threading.Thread.Sleep(3);
                        }
                    }
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase10] EXCEPTION writing IPC response file: {ex}");
                }
            }

            // Runs on the Unity MAIN THREAD only (called from Update()). Parses one
            // request line, dispatches to the matching handler, returns one
            // response line (never throws -- callers already wrap in try/catch, but
            // every handler below also catches internally so a single bad request
            // cannot take down the server or leave the queue stuck).
            private string HandleIpcRequestOnMainThread(string line)
            {
                object parsed;
                try
                {
                    parsed = MiniJson.Parse(line);
                }
                catch (Exception ex)
                {
                    return "{\"error\":" + JStr("bad JSON: " + ex.Message) + "}";
                }

                var obj = parsed as System.Collections.Generic.Dictionary<string, object>;
                string op = obj != null && obj.ContainsKey("op") ? obj["op"] as string : null;

                switch (op)
                {
                    case "HELLO": return HandleIpcHello();
                    case "PING": return "{\"op\":\"PING\",\"pong\":true}";
                    case "DIAG_INPUT": return HandleIpcDiagInput();
                    case "DIAG_SNAPSHOT": return HandleIpcDiagSnapshot(obj);
                    case "DIAG_BRANCHES": return HandleIpcDiagBranches(obj);
                    case "DIAG_CF": return HandleIpcDiagCounterfactual(obj);
                    case "DIAG_SPAWN": return HandleIpcDiagSpawn(obj);
                    case "FREEPLAY": return HandleIpcFreePlay(true);
                    case "FREEPLAY_STOP": return HandleIpcFreePlay(false);
                    case "RESET": return HandleIpcReset(obj);
                    case "STEP": return HandleIpcStep(obj);
                    case "CLOSE": return HandleIpcClose();
                    default: return "{\"error\":" + JStr("unknown or missing op: " + op) + "}";
                }
            }

            // ---------------------------------------------------------------- DIAG_SNAPSHOT
            // Feasibility probe (research only; never used by training): can the native
            // simulation be exported to bytes (the game's own save format:
            // Scope.Export(simulation)), restored (MotorwaysGameJournalSave.DeserializeGame,
            // the same path "Continue" uses), and then continue BIT-EXACTLY, including the
            // simulation PRNG (CityModel.pseudorandomGenerator)?
            private static string StripVehicleCounts(string json)
            {
                var o = new StringBuilder(json.Length);
                string key = "\"visibleVehicleCount\":";
                int i = 0;
                while (i < json.Length)
                {
                    int k = json.IndexOf(key, i, StringComparison.Ordinal);
                    if (k < 0) { o.Append(json, i, json.Length - i); break; }
                    o.Append(json, i, k - i);
                    int j = k + key.Length;
                    while (j < json.Length && char.IsDigit(json[j])) j++;
                    i = j;
                }
                return o.ToString();
            }

            private string StateFingerprint(MotorwaysGame g)
            {
                var sb = new StringBuilder();
                string o = BuildPolicyObservation(g);
                int gi = o.IndexOf("\"globals\"", StringComparison.Ordinal);
                string tiles = gi > 0 ? o.Substring(0, gi) : o;
                sb.Append("tiles=").Append(HashJson(StripVehicleCounts(tiles)));
                sb.Append(";globals=").Append(gi > 0 ? o.Substring(gi) : "");
                try { sb.Append(";prng=").Append(g.Simulation.GetModel<CityModel>().pseudorandomGenerator.ToString()); } catch (Exception) { sb.Append(";prng=?"); }
                try { var c = g.Scope.Get<Clock>(); sb.Append(";frame=").Append(c.FrameCount).Append(";time=").Append(c.Time.ToString()); } catch (Exception) { sb.Append(";frame=?"); }
                try
                {
                    var veh = new StringBuilder();
                    ModelListEnumerator<VehicleModel> en = g.Simulation.GetModels<VehicleModel>().GetEnumerator();
                    int n = 0;
                    while (en.MoveNext()) { veh.Append(en.Current.CurrentFrame.distanceAlongLane.ToString()).Append('|'); n++; }
                    sb.Append(";veh=").Append(n).Append(':').Append(HashJson(veh.ToString()));
                }
                catch (Exception) { sb.Append(";veh=?"); }
                try
                {
                    int h = 0, d = 0;
                    ModelListEnumerator<HouseModel> eh = g.Simulation.GetModels<HouseModel>().GetEnumerator(); while (eh.MoveNext()) h++;
                    ModelListEnumerator<DestinationModel> ed = g.Simulation.GetModels<DestinationModel>().GetEnumerator(); while (ed.MoveNext()) d++;
                    sb.Append(";houses=").Append(h).Append(";dests=").Append(d);
                }
                catch (Exception) { }
                try { sb.Append(";score=").Append(g.Simulation.GetModel<ScoreModel>().Score); } catch (Exception) { sb.Append(";score=?"); }
                return sb.ToString();
            }

            // variant >= 0: deterministic pseudo-choice among the CURRENT legal actions
            // (pure function of state + step index); variant < 0: WAIT only.
            private string VehicleDetail(MotorwaysGame g)
            {
                var laneIdx = new System.Collections.Generic.Dictionary<object, int>();
                int li = 0;
                ModelListEnumerator<LaneModel> el = g.Simulation.GetModels<LaneModel>().GetEnumerator();
                while (el.MoveNext()) laneIdx[el.Current] = li++;
                var sb = new StringBuilder();
                int vi = 0;
                ModelListEnumerator<VehicleModel> ev = g.Simulation.GetModels<VehicleModel>().GetEnumerator();
                while (ev.MoveNext())
                {
                    VehicleModel v = ev.Current;
                    var cl = v.CurrentFrame.lane;
                    sb.Append("V" + vi + ":lane=" + (cl != null && laneIdx.ContainsKey(cl) ? laneIdx[cl].ToString() : "?") + " d=" + v.CurrentFrame.distanceAlongLane + " s=" + v.CurrentFrame.speed + " st=" + v.behaviorState + " path=" + v.path.Count + " rp=" + v.returnPath.Count + " blk=" + (v.blockingVehicle != null) + " push=" + (v.vehiclePushingInto != null) + " | ");
                    vi++;
                }
                return sb.ToString();
            }

            private string ScriptedDiagStep(MotorwaysGame g, int stepIndex, int variant)
            {
                ActionDescriptor action = ActionDescriptor.Wait();
                if (variant >= 0)
                {
                    var legal = EnumerateLegalActions(g, _ipcActionBounds);
                    if (legal.Count > 0) action = legal[(int)(((long)stepIndex * 7919L + (long)variant * 104729L + 13L) % legal.Count)];
                }
                string info;
                ApplyAction(g, action, out info);
                AdvanceSimulation(g, _ipcDecisionDeltaSeconds);
                string pend = "?";
                try { var um = g.Simulation.GetModel<UpgradeDatabaseModel>(); pend = (um.pendingUpgradeChoices != null ? um.pendingUpgradeChoices.Count : 0) + "/" + um.numChoicesMade; } catch (Exception) { }
                _diagVehTrace.Add(VehicleDetail(g));
                if (stepIndex == _diagDumpAt) { _diagDumpOut = DumpModelLines(g); }
                _diagTrace.Add("step" + stepIndex + " v" + variant + " " + action + " -> " + info + " | t=" + g.Scope.Get<Clock>().Time + " frame=" + g.Scope.Get<Clock>().FrameCount + " paused=" + g.Simulation.IsPaused + " pend=" + pend);
                return StateFingerprint(g);
            }

            private void TearDownIpcGameForDiag()
            {
                if (_ipcGame == null) return;
                try { _ipcGame.StopAudio(); _ipcGame.ClearPathfinder(); _ipcGame.Scope.ParentScope.Release(_ipcGame); }
                catch (Exception ex) { WriteLine("[Snapshot] teardown exception: " + ex.Message); }
                _ipcGame = null;
            }

            // ---------------------------------------------------------------- snapshot extras
            // State the native Export/Import does NOT carry (found by diffing an original
            // game against its restored copy, see DumpModelLines): captured alongside the
            // snapshot bytes and re-applied right after import.
            //  * GameBehaviourModel._pseudorandomGenerator: in the original it is the SAME
            //    object as CityModel.pseudorandomGenerator (a [Dependency] resolved to the
            //    scope's generator). Import only restores the CityModel reference, so the
            //    behaviour model ends up with a fresh zero-seeded generator -> weekly
            //    upgrade offers (ShuffleChoices) and upgrade timing diverge.
            //  * DestinationModel.ActivationTime (private set; drives spawn timing/demand).
            //  * LaneModel._speedLimit, VehicleModel.frameBlockingChainLastChecked /
            //    blockingVehicle (blocking-chain bookkeeping).
            private class SnapshotExtras
            {
                public bool behaviourSharesCityPrng;
                public ulong behaviourX, behaviourW;
                public System.Collections.Generic.Dictionary<string, object> activation = new System.Collections.Generic.Dictionary<string, object>();
                public System.Collections.Generic.List<object> laneSpeed = new System.Collections.Generic.List<object>();
                public System.Collections.Generic.List<int> vehBlockFrame = new System.Collections.Generic.List<int>();
                public System.Collections.Generic.List<int> vehBlockingIndex = new System.Collections.Generic.List<int>();
                public System.Collections.Generic.List<GenericLost> generic = new System.Collections.Generic.List<GenericLost>();
                public System.Collections.Generic.List<int[]> laneInbound = new System.Collections.Generic.List<int[]>();
            }

            // Value-typed model state the native serializer drops: fields marked
            // [Serialize(false)] and auto-properties lacking [Serialize(true)]. Captured by
            // (model type, field, model index) and re-applied after import.
            private class GenericLost
            {
                public Type modelType;
                public FieldInfo field;
                public System.Collections.Generic.List<object> values = new System.Collections.Generic.List<object>();
            }

            private static bool IsLostValueField(FieldInfo f)
            {
                string n = f.Name;
                if (n.Contains("Pathfinding") || n.Contains("Clock") || n.Contains("NodeId") || n == "id" || n == "_id" || n.Contains("bserver")) return false;
                Type ft = f.FieldType;
                if (!(ft.IsPrimitive || ft.IsEnum || ft == typeof(string) || ft.Name == "Fix64")) return false;
                if (f.IsStatic || f.IsInitOnly) return false;
                object[] attrs = f.GetCustomAttributes(typeof(Factory.SerializeAttribute), true);
                if (attrs.Length > 0) return !((Factory.SerializeAttribute)attrs[0]).IsSerialized;
                if (n.StartsWith("<") && n.EndsWith(">k__BackingField"))
                {
                    string prop = n.Substring(1, n.IndexOf('>') - 1);
                    var pi = f.DeclaringType.GetProperty(prop, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
                    if (pi == null) return false;
                    object[] pa = pi.GetCustomAttributes(typeof(Factory.SerializeAttribute), true);
                    if (pa.Length > 0) return !((Factory.SerializeAttribute)pa[0]).IsSerialized;
                    return true;   // auto-property with no attribute: not exported
                }
                return false;
            }

            private System.Collections.Generic.List<GenericLost> CaptureGenericLost(MotorwaysGame g)
            {
                var result = new System.Collections.Generic.List<GenericLost>();
                var modelsField = typeof(Server.Simulation).GetField("_models", BindingFlags.Instance | BindingFlags.NonPublic);
                var dict = modelsField.GetValue(g.Simulation) as System.Collections.IDictionary;
                foreach (System.Collections.DictionaryEntry kv in dict)
                {
                    Type mt = (Type)kv.Key;
                    if (mt.Name == "TileModel" || mt.Name == "ClockModel") continue;
                    var list = (System.Collections.IList)kv.Value;
                    if (list.Count == 0) continue;
                    var seenFields = new System.Collections.Generic.HashSet<string>();
                    for (Type bt = mt; bt != null && bt != typeof(object); bt = bt.BaseType)
                    {
                        foreach (var f in bt.GetFields(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly))
                        {
                            if (!IsLostValueField(f) || !seenFields.Add(f.Name)) continue;
                            var gl = new GenericLost { modelType = mt, field = f };
                            for (int i = 0; i < list.Count; i++) gl.values.Add(f.GetValue(list[i]));
                            result.Add(gl);
                        }
                    }
                }
                return result;
            }

            private int ApplyGenericLost(MotorwaysGame g, System.Collections.Generic.List<GenericLost> gen)
            {
                var modelsField = typeof(Server.Simulation).GetField("_models", BindingFlags.Instance | BindingFlags.NonPublic);
                var dict = modelsField.GetValue(g.Simulation) as System.Collections.IDictionary;
                int applied = 0;
                foreach (var gl in gen)
                {
                    if (!dict.Contains(gl.modelType)) continue;
                    var list = (System.Collections.IList)dict[gl.modelType];
                    for (int i = 0; i < list.Count && i < gl.values.Count; i++) { gl.field.SetValue(list[i], gl.values[i]); applied++; }
                }
                return applied;
            }

            private static FieldInfo FindField(Type t, string name)
            {
                for (Type bt = t; bt != null; bt = bt.BaseType)
                {
                    var f = bt.GetField(name, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly);
                    if (f != null) return f;
                }
                return null;
            }

            private static string DestKey(DestinationModel d) { return d.TileModels[0].Coordinates.x + "," + d.TileModels[0].Coordinates.y; }

            private SnapshotExtras CaptureExtras(MotorwaysGame g)
            {
                var e = new SnapshotExtras();
                var gb = g.Simulation.GetModel<GameBehaviourModel>();
                var city = g.Simulation.GetModel<CityModel>();
                var gbField = FindField(typeof(GameBehaviourModel), "_pseudorandomGenerator");
                var gbPrng = gbField.GetValue(gb) as PseudorandomGenerator;
                e.generic = CaptureGenericLost(g);
                {
                    var lanes = new System.Collections.Generic.List<LaneModel>();
                    ModelListEnumerator<LaneModel> elc = g.Simulation.GetModels<LaneModel>().GetEnumerator();
                    while (elc.MoveNext()) lanes.Add(elc.Current);
                    var inF = FindField(typeof(LaneModel), "_inboundLanes");
                    foreach (var ln in lanes)
                    {
                        var lst = (System.Collections.IList)inF.GetValue(ln);
                        var arr = new int[lst.Count];
                        for (int q = 0; q < lst.Count; q++) arr[q] = lanes.IndexOf((LaneModel)lst[q]);
                        e.laneInbound.Add(arr);
                    }
                }
                e.behaviourSharesCityPrng = ReferenceEquals(gbPrng, city.pseudorandomGenerator);
                var xf = FindField(typeof(PseudorandomGenerator), "_x"); var wf = FindField(typeof(PseudorandomGenerator), "_w");
                e.behaviourX = (ulong)xf.GetValue(gbPrng); e.behaviourW = (ulong)wf.GetValue(gbPrng);

                var actF = FindField(typeof(DestinationModel), "<ActivationTime>k__BackingField");
                ModelListEnumerator<DestinationModel> ed = g.Simulation.GetModels<DestinationModel>().GetEnumerator();
                while (ed.MoveNext()) e.activation[DestKey(ed.Current)] = actF.GetValue(ed.Current);

                var slF = FindField(typeof(LaneModel), "_speedLimit");
                ModelListEnumerator<LaneModel> el = g.Simulation.GetModels<LaneModel>().GetEnumerator();
                while (el.MoveNext()) e.laneSpeed.Add(slF.GetValue(el.Current));

                var fbF = FindField(typeof(VehicleModel), "frameBlockingChainLastChecked");
                var bvF = FindField(typeof(VehicleModel), "blockingVehicle");
                var vehicles = new System.Collections.Generic.List<VehicleModel>();
                ModelListEnumerator<VehicleModel> ev = g.Simulation.GetModels<VehicleModel>().GetEnumerator();
                while (ev.MoveNext()) vehicles.Add(ev.Current);
                foreach (var v in vehicles)
                {
                    e.vehBlockFrame.Add((int)fbF.GetValue(v));
                    var bv = bvF.GetValue(v) as VehicleModel;
                    e.vehBlockingIndex.Add(bv == null ? -1 : vehicles.IndexOf(bv));
                }
                return e;
            }

            private string ApplyExtras(MotorwaysGame g, SnapshotExtras e)
            {
                var note = new StringBuilder();
                var gb = g.Simulation.GetModel<GameBehaviourModel>();
                var city = g.Simulation.GetModel<CityModel>();
                var gbField = FindField(typeof(GameBehaviourModel), "_pseudorandomGenerator");
                if (e.behaviourSharesCityPrng)
                {
                    gbField.SetValue(gb, city.pseudorandomGenerator);   // re-share the single stream
                    note.Append("prng reshared; ");
                }
                else
                {
                    var p = gbField.GetValue(gb) as PseudorandomGenerator;
                    FindField(typeof(PseudorandomGenerator), "_x").SetValue(p, e.behaviourX);
                    FindField(typeof(PseudorandomGenerator), "_w").SetValue(p, e.behaviourW);
                    note.Append("prng copied; ");
                }
                var actF = FindField(typeof(DestinationModel), "<ActivationTime>k__BackingField");
                int na = 0;
                ModelListEnumerator<DestinationModel> ed = g.Simulation.GetModels<DestinationModel>().GetEnumerator();
                while (ed.MoveNext()) { object v; if (e.activation.TryGetValue(DestKey(ed.Current), out v)) { actF.SetValue(ed.Current, v); na++; } }
                note.Append("activation " + na + "/" + e.activation.Count + "; ");

                var slF = FindField(typeof(LaneModel), "_speedLimit");
                int nl = 0;
                ModelListEnumerator<LaneModel> el = g.Simulation.GetModels<LaneModel>().GetEnumerator();
                while (el.MoveNext()) { if (nl < e.laneSpeed.Count) slF.SetValue(el.Current, e.laneSpeed[nl]); nl++; }
                note.Append("lanes " + nl + "/" + e.laneSpeed.Count + "; ");

                var fbF = FindField(typeof(VehicleModel), "frameBlockingChainLastChecked");
                var bvF = FindField(typeof(VehicleModel), "blockingVehicle");
                var vehicles = new System.Collections.Generic.List<VehicleModel>();
                ModelListEnumerator<VehicleModel> ev = g.Simulation.GetModels<VehicleModel>().GetEnumerator();
                while (ev.MoveNext()) vehicles.Add(ev.Current);
                for (int i = 0; i < vehicles.Count && i < e.vehBlockFrame.Count; i++)
                {
                    fbF.SetValue(vehicles[i], e.vehBlockFrame[i]);
                    int bi = e.vehBlockingIndex[i];
                    bvF.SetValue(vehicles[i], bi >= 0 && bi < vehicles.Count ? vehicles[bi] : null);
                }
 {
                    var lanes2 = new System.Collections.Generic.List<LaneModel>();
                    ModelListEnumerator<LaneModel> elc2 = g.Simulation.GetModels<LaneModel>().GetEnumerator();
                    while (elc2.MoveNext()) lanes2.Add(elc2.Current);
                    var inF2 = FindField(typeof(LaneModel), "_inboundLanes");
                    int reordered = 0, mismatched = 0;
                    for (int li2 = 0; li2 < lanes2.Count && li2 < e.laneInbound.Count; li2++)
                    {
                        var lst = (System.Collections.IList)inF2.GetValue(lanes2[li2]);
                        int[] want = e.laneInbound[li2];
                        var cur = new System.Collections.Generic.List<object>();
                        foreach (object o in lst) cur.Add(o);
                        var ordered = new System.Collections.Generic.List<object>();
                        bool ok = want.Length == cur.Count;
                        if (ok) { foreach (int wi in want) { if (wi < 0 || wi >= lanes2.Count || !cur.Contains(lanes2[wi])) { ok = false; break; } ordered.Add(lanes2[wi]); } }
                        if (!ok) { mismatched++; continue; }
                        bool same = true; for (int q = 0; q < cur.Count; q++) if (!ReferenceEquals(cur[q], ordered[q])) { same = false; break; }
                        if (same) continue;
                        lst.Clear(); foreach (object o in ordered) lst.Add(o);
                        reordered++;
                    }
                    note.Append("inboundLanes reordered=" + reordered + " mismatched=" + mismatched + "; ");
                }
                note.Append("vehicles " + vehicles.Count + "/" + e.vehBlockFrame.Count + "; generic fields=" + e.generic.Count + " applied=" + ApplyGenericLost(g, e.generic));
                return note.ToString();
            }

            private System.Collections.Generic.List<string> _diagVehTrace = new System.Collections.Generic.List<string>();
            private int _diagDumpAt = -1;
            private System.Collections.Generic.List<string> _diagDumpOut = new System.Collections.Generic.List<string>();
            private int _diagRestoreMode;
            private bool _diagUseExtras = true;
            private System.Collections.Generic.List<string> _diagTrace = new System.Collections.Generic.List<string>();
            private MotorwaysGame RestoreGameFromBytes(byte[] bytes, out string note, SnapshotExtras extras = null)
            {
                note = "";
                var save = _ipcApp.Scope.Get<MotorwaysGameJournalSave>();
                save.InitializeWithBytes(bytes);
                Game game = save.DeserializeGame(_ipcCityDefinition);
                MotorwaysGame mg = game as MotorwaysGame;
                if (mg == null) { note = "DeserializeGame returned null"; return null; }
                mg.FixDeserializedSimulation(_ipcCityDefinition);
                if (extras != null) note = ApplyExtras(mg, extras);
                // Exactly what GameStarter does after a load: one PAUSED step, then Clock.Rewind().
                bool wasPaused = mg.Simulation.IsPaused;
                mg.Simulation.IsPaused = true;
                mg.Simulation.Step();
                mg.Simulation.IsPaused = wasPaused;
                mg.Scope.Get<Clock>().Rewind();
                mg.SetMapDefinition(_ipcMapDefinition);
                mg.Start(_ipcCityDefinition, GameMode.Normal, null);
                if (_diagRestoreMode == 0)
                {
                    mg.SetPaused(false, Plugins.Analytics.AnalyticsTypes.PauseReason.TransitionIn);
                    mg.Tick(0f);
                    mg.Tick(0f);
                    mg.OnGameStarted();
                }
                else if (_diagRestoreMode == 1)
                {
                    mg.OnGameStarted();
                }
                return mg;
            }

            private static string FirstDivergence(System.Collections.Generic.List<string> a, System.Collections.Generic.List<string> b)
            {
                int n = Math.Min(a.Count, b.Count);
                for (int i = 0; i < n; i++) if (a[i] != b[i]) return "diverges at step " + i + " [" + a[i] + "] vs [" + b[i] + "]";
                return a.Count == b.Count ? "IDENTICAL" : "length differs";
            }

            // ---------------------------------------------------------------- model state dump (diag)
            // Reflective, depth-limited dump of every simulation model's fields, used to diff
            // an ORIGINAL game against its RESTORED copy and find state the snapshot loses.
            private static string DumpValue(object v, int depth, System.Collections.Generic.HashSet<object> seen)
            {
                if (v == null) return "null";
                Type t = v.GetType();
                if (t.IsPrimitive || t.IsEnum || v is string || v is decimal) return Convert_ToStringSafe(v);
                string ns = t.Namespace ?? "";
                if (ns.StartsWith("UnityEngine") || ns.StartsWith("System.Reflection") || typeof(Delegate).IsAssignableFrom(t)) return "<" + t.Name + ">";
                if (t.Name == "Fix64" || t.Name.StartsWith("Vector") || t.Name == "RectInt") return v.ToString();
                if (t.IsValueType && depth <= 0) return v.ToString();
                if (depth <= 0) return "<" + t.Name + ">";
                if (!t.IsValueType)
                {
                    if (seen.Contains(v)) return "<seen " + t.Name + ">";
                    seen.Add(v);
                }
                var sb = new StringBuilder();
                var en = v as System.Collections.IEnumerable;
                if (en != null)
                {
                    sb.Append(t.Name).Append('[');
                    int n = 0;
                    foreach (object it in en)
                    {
                        if (n++ < 40) { sb.Append(DumpValue(it, depth - 1, seen)).Append(','); }
                    }
                    sb.Append("]#").Append(n);
                    return sb.ToString();
                }
                if (ns.StartsWith("System") ) return v.ToString();
                sb.Append(t.Name).Append('{');
                for (Type bt = t; bt != null && bt != typeof(object); bt = bt.BaseType)
                {
                    foreach (var f in bt.GetFields(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly))
                    {
                        if (typeof(Delegate).IsAssignableFrom(f.FieldType)) continue;
                        string fn = f.Name;
                        if (fn.Contains("Scope") || fn.Contains("scope") || fn.Contains("_observers")) continue;
                        object fv; try { fv = f.GetValue(v); } catch (Exception) { continue; }
                        sb.Append(fn).Append('=').Append(DumpValue(fv, depth - 1, seen)).Append(';');
                    }
                }
                sb.Append('}');
                return sb.ToString();
            }

            private static string Convert_ToStringSafe(object v)
            {
                if (v is double) return ((double)v).ToString("R", System.Globalization.CultureInfo.InvariantCulture);
                if (v is float) return ((float)v).ToString("R", System.Globalization.CultureInfo.InvariantCulture);
                return v.ToString();
            }

            private System.Collections.Generic.List<string> DumpModelLines(MotorwaysGame g)
            {
                var lines = new System.Collections.Generic.List<string>();
                var modelsField = typeof(Server.Simulation).GetField("_models", BindingFlags.Instance | BindingFlags.NonPublic);
                var dict = modelsField.GetValue(g.Simulation) as System.Collections.IDictionary;
                var keys = new System.Collections.Generic.List<string>();
                var byName = new System.Collections.Generic.Dictionary<string, System.Collections.IList>();
                foreach (System.Collections.DictionaryEntry kv in dict)
                {
                    string name = ((Type)kv.Key).Name;
                    keys.Add(name); byName[name] = (System.Collections.IList)kv.Value;
                }
                keys.Sort(StringComparer.Ordinal);
                foreach (string name in keys)
                {
                    var list = byName[name];
                    lines.Add(name + ".count=" + list.Count);
                    // cap very large model families (tiles etc.) to keep the diff readable
                    int cap = Math.Min(list.Count, 400);
                    for (int i = 0; i < cap; i++)
                    {
                        var seen = new System.Collections.Generic.HashSet<object>();
                        var m = list[i];
                        Type t = m.GetType();
                        for (Type bt = t; bt != null && bt != typeof(object); bt = bt.BaseType)
                        {
                            foreach (var f in bt.GetFields(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly))
                            {
                                if (typeof(Delegate).IsAssignableFrom(f.FieldType)) continue;
                                string fn = f.Name;
                                if (fn.Contains("Scope") || fn.Contains("scope") || fn.Contains("_observers")) continue;
                                object fv; try { fv = f.GetValue(m); } catch (Exception) { continue; }
                                lines.Add(name + "#" + i + "." + bt.Name + "." + fn + "=" + DumpValue(fv, 1, seen));
                            }
                        }
                    }
                }
                try
                {
                    var laneIdx = new System.Collections.Generic.Dictionary<object, int>();
                    int li = 0;
                    ModelListEnumerator<LaneModel> el = g.Simulation.GetModels<LaneModel>().GetEnumerator();
                    while (el.MoveNext()) laneIdx[el.Current] = li++;
                    int vi = 0;
                    ModelListEnumerator<VehicleModel> ev = g.Simulation.GetModels<VehicleModel>().GetEnumerator();
                    while (ev.MoveNext())
                    {
                        VehicleModel v = ev.Current;
                        var sbp = new StringBuilder();
                        foreach (var ln in v.path) sbp.Append(laneIdx.ContainsKey(ln) ? laneIdx[ln].ToString() : "?").Append(',');
                        lines.Add("VehicleIdent#" + vi + ".path=" + sbp);
                        var sbr = new StringBuilder();
                        foreach (var ln in v.returnPath) sbr.Append(laneIdx.ContainsKey(ln) ? laneIdx[ln].ToString() : "?").Append(',');
                        lines.Add("VehicleIdent#" + vi + ".returnPath=" + sbr);
                        var cl = v.CurrentFrame.lane;
                        lines.Add("VehicleIdent#" + vi + ".curLane=" + (cl != null && laneIdx.ContainsKey(cl) ? laneIdx[cl].ToString() : "?") + " dist=" + v.CurrentFrame.distanceAlongLane + " speed=" + v.CurrentFrame.speed);
                        var nl = v.NextFrame.lane;
                        lines.Add("VehicleIdent#" + vi + ".curFrameFull=" + DumpValue(v.CurrentFrame, 2, new System.Collections.Generic.HashSet<object>()));
                        lines.Add("VehicleIdent#" + vi + ".nextFrameFull=" + DumpValue(v.NextFrame, 2, new System.Collections.Generic.HashSet<object>()));
                        lines.Add("VehicleIdent#" + vi + ".nextLane=" + (nl != null && laneIdx.ContainsKey(nl) ? laneIdx[nl].ToString() : "?") + " dist=" + v.NextFrame.distanceAlongLane);
                        vi++;
                    }
                }
                catch (Exception ex) { lines.Add("VehicleIdent.error=" + ex.Message); }
                try
                {
                    var laneIdx2 = new System.Collections.Generic.Dictionary<object, int>();
                    var vehIdx2 = new System.Collections.Generic.Dictionary<object, int>();
                    int a1 = 0;
                    ModelListEnumerator<LaneModel> el2 = g.Simulation.GetModels<LaneModel>().GetEnumerator();
                    while (el2.MoveNext()) laneIdx2[el2.Current] = a1++;
                    a1 = 0;
                    ModelListEnumerator<VehicleModel> ev2 = g.Simulation.GetModels<VehicleModel>().GetEnumerator();
                    while (ev2.MoveNext()) vehIdx2[ev2.Current] = a1++;
                    var fVeh = FindField(typeof(LaneModel), "_vehicles"); var fIn = FindField(typeof(LaneModel), "_inboundLanes"); var fOut = FindField(typeof(LaneModel), "_outboundLanes");
                    int lj = 0;
                    ModelListEnumerator<LaneModel> el3 = g.Simulation.GetModels<LaneModel>().GetEnumerator();
                    while (el3.MoveNext())
                    {
                        var ln = el3.Current;
                        var sbl = new StringBuilder();
                        sbl.Append("veh=["); foreach (object o in (System.Collections.IEnumerable)fVeh.GetValue(ln)) sbl.Append(vehIdx2.ContainsKey(o) ? vehIdx2[o].ToString() : "?").Append(',');
                        sbl.Append("] in=["); foreach (object o in (System.Collections.IEnumerable)fIn.GetValue(ln)) sbl.Append(laneIdx2.ContainsKey(o) ? laneIdx2[o].ToString() : "?").Append(',');
                        sbl.Append("] out=["); foreach (object o in (System.Collections.IEnumerable)fOut.GetValue(ln)) sbl.Append(laneIdx2.ContainsKey(o) ? laneIdx2[o].ToString() : "?").Append(',');
                        sbl.Append("]");
                        lines.Add("LaneIdent#" + lj + ".lists=" + sbl);
                        lj++;
                    }
                    // road chunks (distinct, in tile order): inbound vehicle lists + traversing vehicles
                    var seenChunks = new System.Collections.Generic.HashSet<object>();
                    int cj = 0;
                    ModelListEnumerator<TileModel> et = g.Simulation.GetModels<TileModel>().GetEnumerator();
                    while (et.MoveNext())
                    {
                        var ch = et.Current.roadChunk;
                        if (ch == null || !seenChunks.Add(ch)) continue;
                        var sbc = new StringBuilder();
                        sbc.Append("trav=["); foreach (var v in ch.traversingVehicles) sbc.Append(vehIdx2.ContainsKey(v) ? vehIdx2[v].ToString() : "?").Append(',');
                        sbc.Append("] inboundCount=" + ch.inboundVehicles.Count + " returning=" + ch.returningInboundVehicles.Count);
                        lines.Add("ChunkIdent#" + cj + ".state=" + sbc);
                        cj++;
                    }
                }
                catch (Exception ex) { lines.Add("LaneIdent.error=" + ex.Message); }
                return lines;
            }

            private static string StripIdNoise(string v)
            {
                string[] toks = { "_id=", "PathfindingStartNodeId>k__BackingField=", "PathfindingEndNodeId>k__BackingField=", ";id=", "{id=" };
                var o = new StringBuilder(v.Length);
                int i = 0;
                while (i < v.Length)
                {
                    int best = -1, bl = 0;
                    foreach (string t in toks)
                    {
                        if (string.CompareOrdinal(v, i, t, 0, t.Length) == 0) { best = i; bl = t.Length; break; }
                    }
                    if (best >= 0)
                    {
                        o.Append(v, i, bl);
                        i += bl;
                        while (i < v.Length && (char.IsDigit(v[i]) || v[i] == '-')) i++;
                        o.Append('#');
                    }
                    else { o.Append(v[i]); i++; }
                }
                return o.ToString();
            }

            private static string DiffLines(System.Collections.Generic.List<string> a, System.Collections.Generic.List<string> b, int max)
            {
                var setB = new System.Collections.Generic.Dictionary<string, string>();
                foreach (string l in b) { int e = l.IndexOf('='); if (e > 0) setB[l.Substring(0, e)] = l.Substring(e + 1); }
                var sb = new StringBuilder(); int n = 0;
                foreach (string l in a)
                {
                    int e = l.IndexOf('='); if (e <= 0) continue;
                    string key = l.Substring(0, e), va = l.Substring(e + 1), vb;
                    if (key.Contains("Clock>k__") || key.Contains("_motorwaysGame") || key.Contains("LaneModel._id") || key.Contains("Pathfinding") || key.Contains("VehicleModel.id") || key.Contains("CityModel._clock")) continue;
                    if (!setB.TryGetValue(key, out vb)) { if (n++ < max) sb.Append("ONLY-ORIG ").Append(key).Append(" ## "); continue; }
                    if (StripIdNoise(va) != StripIdNoise(vb) && n++ < max) sb.Append(key).Append(": orig=").Append(va.Length > 160 ? va.Substring(0, 160) : va).Append(" restored=").Append(vb.Length > 160 ? vb.Substring(0, 160) : vb).Append(" ## ");
                }
                return "diffs=" + n + " :: " + sb;
            }

            // ---------------------------------------------------------------- DIAG_BRANCHES
            // Determinism stress test for RESTORED branches: from one snapshot, several
            // action policies, each run twice from fresh restores (must be identical), plus
            // a restore-of-restore chain (snapshot taken from a restored game).
            private string UpgradeProgress(MotorwaysGame g)
            {
                try
                {
                    var um = g.Simulation.GetModel<UpgradeDatabaseModel>();
                    return "claimed=" + um.TotalClaimedPackages + ",pending=" + um.pendingUpgradeChoices.Count;
                }
                catch (Exception) { return "?"; }
            }

            private System.Collections.Generic.List<string> RunScripted(MotorwaysGame g, int start, int n, int variant, System.Collections.Generic.List<string> progressOut)
            {
                var l = new System.Collections.Generic.List<string>();
                for (int i = 0; i < n; i++)
                {
                    l.Add(ScriptedDiagStep(g, start + i, variant));
                    if (progressOut != null) progressOut.Add(UpgradeProgress(g));
                }
                return l;
            }

            private byte[] ExportSim(MotorwaysGame g)
            {
                using (var ms = new MemoryStream())
                {
                    using (var w = new BinaryWriter(ms))
                    {
                        if (!g.Simulation.Scope.Export(g.Simulation, w)) throw new Exception("export failed");
                    }
                    return ms.ToArray();
                }
            }

            private string HandleIpcDiagBranches(System.Collections.Generic.Dictionary<string, object> obj)
            {
                var sb = new StringBuilder("{\"op\":\"DIAG_BRANCHES\"");
                try
                {
                    if (_ipcGame == null) return "{\"op\":\"DIAG_BRANCHES\",\"error\":\"no_active_episode\"}";
                    int nPre = obj != null && obj.ContainsKey("n_pre") ? (int)(double)obj["n_pre"] : 100;
                    int nPost = obj != null && obj.ContainsKey("n_post") ? (int)(double)obj["n_post"] : 80;
                    _diagRestoreMode = 1; _diagUseExtras = true;
                    for (int i = 0; i < nPre; i++) ScriptedDiagStep(_ipcGame, i, 0);

                    SnapshotExtras ex0 = CaptureExtras(_ipcGame);
                    byte[] s0 = ExportSim(_ipcGame);
                    string fp0 = StateFingerprint(_ipcGame);
                    sb.Append(",\"bytes\":" + s0.Length + ",\"upgradeAtSnapshot\":" + JStr(UpgradeProgress(_ipcGame)));

                    // original continuation (variant 0) as the ground-truth reference
                    var origProg = new System.Collections.Generic.List<string>();
                    var orig0 = RunScripted(_ipcGame, nPre, nPost, 0, origProg);
                    sb.Append(",\"originalUpgradeAtEnd\":" + JStr(origProg[origProg.Count - 1]));

                    int[] variants = { 0, 1, 2, 3, -1 };
                    var perVariant = new StringBuilder();
                    foreach (int v in variants)
                    {
                        var runs = new System.Collections.Generic.List<System.Collections.Generic.List<string>>();
                        string prog = "";
                        for (int rep = 0; rep < 2; rep++)
                        {
                            TearDownIpcGameForDiag();
                            string note;
                            MotorwaysGame g2 = RestoreGameFromBytes(s0, out note, ex0);
                            _ipcGame = g2;
                            if (StateFingerprint(g2).Split(';')[2] != fp0.Split(';')[2]) perVariant.Append("[v" + v + " prng@restore differs] ");
                            var pg = new System.Collections.Generic.List<string>();
                            runs.Add(RunScripted(g2, nPre, nPost, v, pg));
                            prog = pg[pg.Count - 1];
                        }
                        string same = FirstDivergence(runs[0], runs[1]);
                        string vsOrig = v == 0 ? FirstDivergence(orig0, runs[0]) : "n/a";
                        perVariant.Append("\"v" + v + "\":{\"restoreTwice\":" + JStr(same) + ",\"vsOriginal\":" + JStr(vsOrig) + ",\"upgradeAtEnd\":" + JStr(prog) + ",\"endFp\":" + JStr(runs[0][runs[0].Count - 1].Substring(0, Math.Min(60, runs[0][runs[0].Count - 1].Length))) + "},");
                    }
                    sb.Append(",\"variants\":{" + perVariant.ToString().TrimEnd(',') + "}");

                    // chain: restore S0 -> run m -> snapshot S1 (from the RESTORED game) -> run to end (C)
                    //        restore S1 -> run the remainder (D);  D must equal C's tail.
                    int m = nPost / 2;
                    TearDownIpcGameForDiag();
                    string n1;
                    MotorwaysGame ga = RestoreGameFromBytes(s0, out n1, ex0);
                    _ipcGame = ga;
                    var head = RunScripted(ga, nPre, m, 0, null);
                    SnapshotExtras ex1 = CaptureExtras(ga);
                    var chainDumpA = DumpModelLines(ga);
                    byte[] s1 = ExportSim(ga);
                    _diagDumpAt = obj != null && obj.ContainsKey("dump_rel") ? nPre + m + (int)(double)obj["dump_rel"] : -1;
                    _diagVehTrace.Clear();
                    var tailC = RunScripted(ga, nPre + m, nPost - m, 0, null);
                    var vehC = new System.Collections.Generic.List<string>(_diagVehTrace);
                    var dumpC = _diagDumpOut;
                    TearDownIpcGameForDiag();
                    MotorwaysGame gb2 = RestoreGameFromBytes(s1, out n1, ex1);
                    _ipcGame = gb2;
                    sb.Append(",\"chainStateDiff\":" + JStr(DiffLines(chainDumpA, DumpModelLines(gb2), 60)));
                    _diagVehTrace.Clear();
                    var tailD = RunScripted(gb2, nPre + m, nPost - m, 0, null);
                    var vehD = new System.Collections.Generic.List<string>(_diagVehTrace);
                    if (_diagDumpAt >= 0) sb.Append(",\"chainDumpDiff\":" + JStr(DiffLines(dumpC, _diagDumpOut, 40)));
                    for (int q = 0; q < Math.Min(vehC.Count, vehD.Count); q++)
                    {
                        if (vehC[q] == vehD[q]) continue;
                        string[] ca = vehC[q].Split('|'), da = vehD[q].Split('|');
                        var dv = new StringBuilder();
                        for (int z = 0; z < Math.Min(ca.Length, da.Length); z++) if (ca[z] != da[z]) dv.Append("C:" + ca[z].Trim() + " /// D:" + da[z].Trim() + " ## ");
                        sb.Append(",\"chainFirstVehicleDiffStep\":" + q + ",\"chainVehicleDiff\":" + JStr(dv.ToString()));
                        if (q > 0) sb.Append(",\"chainPrevStepVehicles\":" + JStr(vehC[q - 1]));
                        break;
                    }
                    sb.Append(",\"chainRestoreOfRestore\":" + JStr(FirstDivergence(tailC, tailD)));
                    sb.Append("}");
                    return sb.ToString();
                }
                catch (Exception ex)
                {
                    WriteLine("[Snapshot] EXCEPTION in branches: " + ex);
                    return "{\"op\":\"DIAG_BRANCHES\",\"error\":" + JStr(ex.ToString()) + "}";
                }
            }

            // ---------------------------------------------------------------- DIAG_CF
            // Offline counterfactual-action probe (research only; NOT used by training).
            // At the current state: snapshot once, then for each candidate first action
            // restore the snapshot, apply the action, continue with WAIT for up to hMax
            // decisions and record the native score gained at several horizons.
            private static long TKey(int x, int y) { return ((long)(x + 5000) << 20) | (long)(y + 5000); }

            // Same definition as python connectivity_potential(): houses road-connected
            // to a same-group destination. Also fills `interesting` with road / house /
            // destination / carpark tiles (used to pick context-relevant candidates).
            private int PotentialFromObs(string obsJson, System.Collections.Generic.HashSet<long> interesting)
            {
                var root = MiniJson.Parse(obsJson) as System.Collections.Generic.Dictionary<string, object>;
                var tiles = root["tiles"] as System.Collections.Generic.List<object>;
                var parent = new System.Collections.Generic.Dictionary<long, long>();
                var info = new System.Collections.Generic.Dictionary<long, System.Collections.Generic.Dictionary<string, object>>();
                var coordOf = new System.Collections.Generic.Dictionary<long, int[]>();
                foreach (object o in tiles)
                {
                    var t = (System.Collections.Generic.Dictionary<string, object>)o;
                    var c = (System.Collections.Generic.List<object>)t["coord"];
                    int x = (int)(double)c[0], y = (int)(double)c[1];
                    long k = TKey(x, y);
                    info[k] = t; coordOf[k] = new int[] { x, y };
                    var road = (System.Collections.Generic.Dictionary<string, object>)t["road"];
                    bool anyRoad = false;
                    foreach (var kv in road) if ((string)kv.Value != "None") anyRoad = true;
                    string ct = (string)t["contentType"];
                    if (anyRoad || ct != "None") { parent[k] = k; if (interesting != null && ct != "Tree") interesting.Add(k); }
                }
                Func<long, long> find = null;
                find = a => { while (parent[a] != a) { parent[a] = parent[parent[a]]; a = parent[a]; } return a; };
                Action<long, long> union = (a, b) => { long ra = find(a), rb = find(b); if (ra != rb) parent[ra] = rb; };
                string[] dn = { "N", "E", "S", "W" }; int[] dx = { 0, 1, 0, -1 }, dy = { 1, 0, -1, 0 };
                foreach (var kv in info)
                {
                    if (!parent.ContainsKey(kv.Key)) continue;
                    var road = (System.Collections.Generic.Dictionary<string, object>)kv.Value["road"];
                    int[] cc = coordOf[kv.Key];
                    for (int d = 0; d < 4; d++)
                    {
                        if ((string)road[dn[d]] == "None") continue;
                        long n = TKey(cc[0] + dx[d], cc[1] + dy[d]);
                        if (parent.ContainsKey(n)) union(kv.Key, n);
                    }
                }
                foreach (var kv in info)
                {
                    if (!parent.ContainsKey(kv.Key)) continue;
                    string ct = (string)kv.Value["contentType"];
                    if (ct != "Destination" && ct != "Carpark") continue;
                    int[] cc = coordOf[kv.Key];
                    for (int d = 0; d < 4; d++)
                    {
                        long n = TKey(cc[0] + dx[d], cc[1] + dy[d]);
                        if (!parent.ContainsKey(n)) continue;
                        string nct = (string)info[n]["contentType"];
                        if ((nct == "Destination" || nct == "Carpark") && (ct == "Destination" || nct == "Destination")) union(kv.Key, n);
                    }
                }
                var destGroups = new System.Collections.Generic.Dictionary<long, System.Collections.Generic.HashSet<int>>();
                foreach (var kv in info)
                {
                    if (!parent.ContainsKey(kv.Key) || (string)kv.Value["contentType"] != "Destination" || kv.Value["groupIndex"] == null) continue;
                    long r = find(kv.Key);
                    if (!destGroups.ContainsKey(r)) destGroups[r] = new System.Collections.Generic.HashSet<int>();
                    destGroups[r].Add((int)(double)kv.Value["groupIndex"]);
                }
                int count = 0;
                foreach (var kv in info)
                {
                    if (!parent.ContainsKey(kv.Key) || (string)kv.Value["contentType"] != "House" || kv.Value["groupIndex"] == null) continue;
                    System.Collections.Generic.HashSet<int> gs;
                    if (destGroups.TryGetValue(find(kv.Key), out gs) && gs.Contains((int)(double)kv.Value["groupIndex"])) count++;
                }
                return count;
            }

            private static bool TryParseAddRoad(string t, out ActionDescriptor a)
            {
                a = ActionDescriptor.Wait();
                t = t.Trim();
                if (!t.StartsWith("ADD_ROAD(") || !t.EndsWith(")")) return false;
                string[] parts = t.Substring(9, t.Length - 10).Split(',');
                if (parts.Length != 3) return false;
                int x = int.Parse(parts[0].Trim()), y = int.Parse(parts[1].Trim());
                char d = parts[2].Trim()[0];
                TileDirection dir = d == 'N' ? TileDirection.North : d == 'E' ? TileDirection.East : d == 'S' ? TileDirection.South : TileDirection.West;
                a = ActionDescriptor.Add(new Vector2Int(x, y), dir);
                return true;
            }

            private class CfCandidate { public string cat; public ActionDescriptor action; }

            private string HandleIpcDiagCounterfactual(System.Collections.Generic.Dictionary<string, object> obj)
            {
                try
                {
                    if (_ipcGame == null) return "{\"op\":\"DIAG_CF\",\"error\":\"no_active_episode\"}";
                    Func<string, int, int> gi = (key, def) => obj != null && obj.ContainsKey(key) ? (int)(double)obj[key] : def;
                    int nPre = gi("n_pre", 60), mainVariant = gi("main_variant", 0), kRand = gi("k_rand", 8), kAdj = gi("k_adj", 12), kRem = gi("k_rem", 4), hMax = gi("h_max", 60), candSeed = gi("cand_seed", 1);
                    var horizons = new System.Collections.Generic.List<int>();
                    if (obj != null && obj.ContainsKey("horizons")) foreach (object h in (System.Collections.Generic.List<object>)obj["horizons"]) horizons.Add((int)(double)h);
                    else horizons.AddRange(new int[] { 1, 3, 5, 10, 20, 40, 60 });
                    horizons.Sort();
                    if (horizons[horizons.Count - 1] > hMax) hMax = horizons[horizons.Count - 1];
                    _diagRestoreMode = 1; _diagUseExtras = true;

                    for (int i = 0; i < nPre; i++)
                    {
                        if (IsTerminal(_ipcGame)) return "{\"op\":\"DIAG_CF\",\"skipped\":\"terminal_before_anchor\",\"step\":" + i + "}";
                        ScriptedDiagStep(_ipcGame, i, mainVariant);
                    }
                    var legal = EnumerateLegalActions(_ipcGame, _ipcActionBounds);
                    bool hasWait = false; foreach (var a in legal) if (a.Kind == ActionKind.Wait) hasWait = true;
                    if (!hasWait) return "{\"op\":\"DIAG_CF\",\"skipped\":\"forced_upgrade_choice\",\"step\":" + nPre + "}";
                    if (IsTerminal(_ipcGame)) return "{\"op\":\"DIAG_CF\",\"skipped\":\"terminal_at_anchor\",\"step\":" + nPre + "}";

                    var interesting = new System.Collections.Generic.HashSet<long>();
                    int phi0 = PotentialFromObs(BuildPolicyObservation(_ipcGame), interesting);
                    double scoreStart = (double)_ipcGame.Simulation.GetModel<ScoreModel>().Score;

                    // --- candidate set
                    var rng = new System.Random(candSeed * 7919 + nPre);
                    var cands = new System.Collections.Generic.List<CfCandidate>();
                    cands.Add(new CfCandidate { cat = "wait", action = ActionDescriptor.Wait() });
                    cands.Add(new CfCandidate { cat = "wait_dup", action = ActionDescriptor.Wait() });
                    if (mainVariant >= 0) cands.Add(new CfCandidate { cat = "main", action = legal[(int)(((long)nPre * 7919L + (long)mainVariant * 104729L + 13L) % legal.Count)] });
                    var adj = new System.Collections.Generic.List<ActionDescriptor>();
                    var rem = new System.Collections.Generic.List<ActionDescriptor>();
                    var any = new System.Collections.Generic.List<ActionDescriptor>();
                    foreach (var a in legal)
                    {
                        if (a.Kind == ActionKind.Wait) continue;
                        any.Add(a);
                        if (a.Kind == ActionKind.Remove) { rem.Add(a); continue; }
                        if (a.Kind != ActionKind.Add) continue;
                        Vector2Int nb = TileUtilities.GetAdjacentCoordinates(a.Coord, a.Direction);
                        if (interesting.Contains(TKey(a.Coord.x, a.Coord.y)) || interesting.Contains(TKey(nb.x, nb.y))) adj.Add(a);
                    }
                    Action<System.Collections.Generic.List<ActionDescriptor>, int, string> pick = (pool, k, cat) =>
                    {
                        for (int i = 0; i < k && pool.Count > 0; i++)
                        {
                            int j = rng.Next(pool.Count);
                            cands.Add(new CfCandidate { cat = cat, action = pool[j] });
                            pool.RemoveAt(j);
                        }
                    };
                    var followups = new System.Collections.Generic.List<ActionDescriptor>();
                    if (obj != null && obj.ContainsKey("extra"))
                    {
                        foreach (object o in (System.Collections.Generic.List<object>)obj["extra"])
                        {
                            ActionDescriptor pa;
                            if (TryParseAddRoad((string)o, out pa)) { followups.Add(pa); cands.Add(new CfCandidate { cat = "oracle", action = pa }); }
                        }
                    }
                    bool useFollowups = obj != null && obj.ContainsKey("followups") && (double)obj["followups"] != 0;
                    pick(adj, kAdj, "adjacent_add");
                    pick(rem, kRem, "remove");
                    pick(any, kRand, "random_legal");

                    // --- snapshot once
                    SnapshotExtras extras = CaptureExtras(_ipcGame);
                    byte[] bytes = ExportSim(_ipcGame);

                    var sb = new StringBuilder("{\"op\":\"DIAG_CF\"");
                    sb.Append(",\"step\":" + nPre + ",\"scoreStart\":" + Inv(scoreStart) + ",\"phi0\":" + phi0 + ",\"legalCount\":" + legal.Count + ",\"adjPool\":" + adj.Count + ",\"bytes\":" + bytes.Length);
                    var hstr = new System.Collections.Generic.List<string>(); foreach (int hh in horizons) hstr.Add(hh.ToString());
                    sb.Append(",\"horizons\":[" + string.Join(",", hstr.ToArray()) + "],\"cands\":[");
                    bool firstC = true;
                    foreach (var c in cands)
                    {
                        TearDownIpcGameForDiag();
                        string note;
                        MotorwaysGame g2 = RestoreGameFromBytes(bytes, out note, extras);
                        _ipcGame = g2;
                        string info;
                        bool accepted = false;
                        try { accepted = ApplyAction(g2, c.action, out info); } catch (Exception ex) { info = "EXC " + ex.Message; }
                        var ds = new System.Collections.Generic.List<string>();
                        int termStep = -1, phi1 = -1, phiEnd = -1;
                        int hi = 0;
                        for (int step = 1; step <= hMax; step++)
                        {
                            if (useFollowups && step >= 2 && step - 2 < followups.Count)
                            {
                                var fa = followups[step - 2];
                                bool same = fa.Kind == c.action.Kind && fa.Coord == c.action.Coord && fa.Direction == c.action.Direction;
                                if (!same) { try { string fi; ApplyAction(g2, fa, out fi); } catch (Exception) { } }
                            }
                            AdvanceSimulation(g2, _ipcDecisionDeltaSeconds);
                            if (step == 1) phi1 = PotentialFromObs(BuildPolicyObservation(g2), null);
                            bool term = IsTerminal(g2);
                            if (term && termStep < 0) termStep = step;
                            if (hi < horizons.Count && step == horizons[hi])
                            {
                                ds.Add(Inv((double)g2.Simulation.GetModel<ScoreModel>().Score - scoreStart));
                                hi++;
                            }
                            if (term) break;
                        }
                        while (hi < horizons.Count) { ds.Add(Inv((double)g2.Simulation.GetModel<ScoreModel>().Score - scoreStart)); hi++; }
                        try { phiEnd = PotentialFromObs(BuildPolicyObservation(g2), null); } catch (Exception) { }
                        if (!firstC) sb.Append(",");
                        firstC = false;
                        sb.Append("{\"cat\":" + JStr(c.cat) + ",\"a\":" + JStr(c.action.ToString()) + ",\"accepted\":" + JBool(accepted) + ",\"dScore\":[" + string.Join(",", ds.ToArray()) + "],\"term\":" + termStep + ",\"phi1\":" + phi1 + ",\"phiEnd\":" + phiEnd + "}");
                    }
                    sb.Append("]}");
                    return sb.ToString();
                }
                catch (Exception ex)
                {
                    WriteLine("[Snapshot] EXCEPTION in counterfactual probe: " + ex);
                    return "{\"op\":\"DIAG_CF\",\"error\":" + JStr(ex.ToString()) + "}";
                }
            }

            // ---------------------------------------------------------------- DIAG_SPAWN
            // Spawn-causality probe (research only). From ONE snapshot, restored branches:
            //   A WAIT (control), A2 WAIT (independent duplicate), B local disconnected road
            //   segment in plausible spawn space, C same-geometry segment far from the city.
            // All branches WAIT afterwards; every new house / destination is logged.
            private System.Collections.Generic.HashSet<string> SpawnKeys(MotorwaysGame g)
            {
                var set = new System.Collections.Generic.HashSet<string>();
                ModelListEnumerator<HouseModel> eh = g.Simulation.GetModels<HouseModel>().GetEnumerator();
                while (eh.MoveNext()) { var c = eh.Current.tileModel.Coordinates; set.Add("H," + eh.Current.GroupIndex + "," + c.x + "," + c.y); }
                ModelListEnumerator<DestinationModel> ed = g.Simulation.GetModels<DestinationModel>().GetEnumerator();
                while (ed.MoveNext()) { var c = ed.Current.TileModels[0].Coordinates; set.Add("D," + ed.Current.GroupIndex + "," + c.x + "," + c.y); }
                return set;
            }

            private string RunSpawnBranch(byte[] bytes, SnapshotExtras extras, string name, System.Collections.Generic.List<ActionDescriptor> edits, int horizon, int[] checkpoints, double interventionSeconds)
            {
                TearDownIpcGameForDiag();
                string note;
                MotorwaysGame g = RestoreGameFromBytes(bytes, out note, extras);
                _ipcGame = g;
                var seen = SpawnKeys(g);
                var spawns = new StringBuilder();
                int nSpawns = 0;
                Action<double> logNew = (tNow) =>
                {
                    var now = SpawnKeys(g);
                    var fresh = new System.Collections.Generic.List<string>();
                    foreach (string k in now) if (!seen.Contains(k)) fresh.Add(k);
                    fresh.Sort(StringComparer.Ordinal);
                    foreach (string k in fresh)
                    {
                        string[] p = k.Split(',');
                        if (nSpawns++ > 0) spawns.Append(",");
                        spawns.Append("[" + Inv(tNow) + ",\"" + p[0] + "\"," + p[1] + "," + p[2] + "," + p[3] + "]");
                        seen.Add(k);
                    }
                };
                var accepted = new StringBuilder();
                int acc = 0;
                if (edits.Count == 0)
                {
                    AdvanceSimulation(g, interventionSeconds);   // control: same elapsed time, no edits
                }
                else
                {
                    foreach (var e in edits)
                    {
                        string info;
                        bool ok = false;
                        try { ok = ApplyAction(g, e, out info); } catch (Exception) { }
                        if (ok) acc++;
                        AdvanceSimulation(g, interventionSeconds / edits.Count);
                    }
                }
                double clock0 = (double)g.Scope.Get<Clock>().Time;
                logNew(0.0);
                var cps = new StringBuilder();
                int termStep = -1;
                for (int step = 1; step <= horizon; step++)
                {
                    AdvanceSimulation(g, _ipcDecisionDeltaSeconds);
                    logNew((double)g.Scope.Get<Clock>().Time - clock0);
                    if (termStep < 0 && IsTerminal(g)) termStep = step;
                    for (int ci = 0; ci < checkpoints.Length; ci++)
                    {
                        if (checkpoints[ci] != step) continue;
                        string prng = "?";
                        try { prng = g.Simulation.GetModel<CityModel>().pseudorandomGenerator.ToString(); } catch (Exception) { }
                        int h = 0, d = 0;
                        ModelListEnumerator<HouseModel> eh = g.Simulation.GetModels<HouseModel>().GetEnumerator(); while (eh.MoveNext()) h++;
                        ModelListEnumerator<DestinationModel> ed = g.Simulation.GetModels<DestinationModel>().GetEnumerator(); while (ed.MoveNext()) d++;
                        if (cps.Length > 0) cps.Append(",");
                        cps.Append("{\"t\":" + step + ",\"houses\":" + h + ",\"dests\":" + d + ",\"prng\":" + JStr(prng) + ",\"score\":" + Inv((double)g.Simulation.GetModel<ScoreModel>().Score) + "}");
                    }
                }
                return "\"" + name + "\":{\"editsAccepted\":" + acc + ",\"terminalStep\":" + termStep + ",\"spawns\":[" + spawns + "],\"checkpoints\":[" + cps + "]}";
            }

            private string HandleIpcDiagSpawn(System.Collections.Generic.Dictionary<string, object> obj)
            {
                try
                {
                    if (_ipcGame == null) return "{\"op\":\"DIAG_SPAWN\",\"error\":\"no_active_episode\"}";
                    Func<string, int, int> gi = (key, def) => obj != null && obj.ContainsKey(key) ? (int)(double)obj[key] : def;
                    int nPre = gi("n_pre", 60), horizon = gi("horizon", 180), segLen = gi("seg_len", 3), candSeed = gi("cand_seed", 1);
                    int nearMin = gi("near_min", 3), nearMax = gi("near_max", 8), farMin = gi("far_min", 14);
                    _diagRestoreMode = 1; _diagUseExtras = true;
                    for (int i = 0; i < nPre; i++) ScriptedDiagStep(_ipcGame, i, -1);     // main line: WAIT

                    // ---- occupied tiles: roads, buildings, carparks (and their 4-neighbours = "touching")
                    var obs = MiniJson.Parse(BuildPolicyObservation(_ipcGame)) as System.Collections.Generic.Dictionary<string, object>;
                    var bld = new System.Collections.Generic.List<int[]>();
                    var net = new System.Collections.Generic.HashSet<long>();
                    foreach (object o in (System.Collections.Generic.List<object>)obs["tiles"])
                    {
                        var t = (System.Collections.Generic.Dictionary<string, object>)o;
                        var c = (System.Collections.Generic.List<object>)t["coord"];
                        int x = (int)(double)c[0], y = (int)(double)c[1];
                        string ct = (string)t["contentType"];
                        bool anyRoad = false;
                        foreach (var kv in (System.Collections.Generic.Dictionary<string, object>)t["road"]) if ((string)kv.Value != "None") anyRoad = true;
                        if (ct == "House" || ct == "Destination") bld.Add(new int[] { x, y });
                        if (anyRoad || ct == "House" || ct == "Destination" || ct == "Carpark") net.Add(TKey(x, y));
                    }
                    Func<int, int, bool> touches = (x, y) => net.Contains(TKey(x, y)) || net.Contains(TKey(x + 1, y)) || net.Contains(TKey(x - 1, y)) || net.Contains(TKey(x, y + 1)) || net.Contains(TKey(x, y - 1));
                    Func<int, int, int> distBld = (x, y) => { int best = 9999; foreach (var b in bld) best = Math.Min(best, Math.Abs(b[0] - x) + Math.Abs(b[1] - y)); return best; };

                    var legal = EnumerateLegalActions(_ipcGame, _ipcActionBounds);
                    var legalAdd = new System.Collections.Generic.HashSet<long>();
                    foreach (var a in legal) if (a.Kind == ActionKind.Add && a.Direction == TileDirection.East) legalAdd.Add(TKey(a.Coord.x, a.Coord.y));
                    var nearSegs = new System.Collections.Generic.List<int[]>();   // x,y,minDist
                    var farSegs = new System.Collections.Generic.List<int[]>();
                    foreach (long k in legalAdd)
                    {
                        int x = (int)((k >> 20) - 5000), y = (int)((k & 0xFFFFF) - 5000);
                        bool ok = true;
                        for (int e = 0; e < segLen && ok; e++) if (!legalAdd.Contains(TKey(x + e, y))) ok = false;
                        if (!ok) continue;
                        int dMin = 9999;
                        for (int tx = 0; tx <= segLen && ok; tx++) { if (touches(x + tx, y)) ok = false; dMin = Math.Min(dMin, distBld(x + tx, y)); }
                        if (!ok) continue;
                        if (dMin >= nearMin && dMin <= nearMax) nearSegs.Add(new int[] { x, y, dMin });
                        farSegs.Add(new int[] { x, y, dMin });
                    }
                    if (nearSegs.Count == 0) return "{\"op\":\"DIAG_SPAWN\",\"skipped\":\"no_local_segment\",\"step\":" + nPre + ",\"legalAdd\":" + legalAdd.Count + "}";
                    farSegs.Sort((p, q) => q[2].CompareTo(p[2]));   // farthest first
                    if (farSegs.Count == 0 || farSegs[0][2] < farMin) { if (farSegs.Count == 0) return "{\"op\":\"DIAG_SPAWN\",\"skipped\":\"no_far_segment\",\"step\":" + nPre + "}"; }
                    var rng = new System.Random(candSeed * 104729 + nPre);
                    int[] bSeg = nearSegs[rng.Next(nearSegs.Count)];
                    // far control: among segments at least farMin away (else the farthest available), random pick
                    var farPool = new System.Collections.Generic.List<int[]>();
                    foreach (var s in farSegs) if (s[2] >= farMin) farPool.Add(s);
                    int[] cSeg = farPool.Count > 0 ? farPool[rng.Next(farPool.Count)] : farSegs[0];

                    Func<int[], System.Collections.Generic.List<ActionDescriptor>> edits = seg =>
                    {
                        var l = new System.Collections.Generic.List<ActionDescriptor>();
                        for (int e = 0; e < segLen; e++) l.Add(ActionDescriptor.Add(new Vector2Int(seg[0] + e, seg[1]), TileDirection.East));
                        return l;
                    };

                    SnapshotExtras extras = CaptureExtras(_ipcGame);
                    byte[] bytes = ExportSim(_ipcGame);
                    int[] cps = { 30, 60, 90, 180 };
                    if (horizon < 180) cps = new int[] { horizon };
                    var empty = new System.Collections.Generic.List<ActionDescriptor>();
                    var sb = new StringBuilder("{\"op\":\"DIAG_SPAWN\"");
                    sb.Append(",\"step\":" + nPre + ",\"horizon\":" + horizon + ",\"nearCandidates\":" + nearSegs.Count + ",\"farCandidates\":" + farPool.Count + ",\"legalAdd\":" + legalAdd.Count + ",\"buildings\":" + bld.Count);
                    sb.Append(",\"B\":{\"x\":" + bSeg[0] + ",\"y\":" + bSeg[1] + ",\"distToBuilding\":" + bSeg[2] + "},\"C\":{\"x\":" + cSeg[0] + ",\"y\":" + cSeg[1] + ",\"distToBuilding\":" + cSeg[2] + "}");
                    sb.Append(",\"branches\":{");
                    sb.Append(RunSpawnBranch(bytes, extras, "A", empty, horizon, cps, 0.3)); sb.Append(",");
                    sb.Append(RunSpawnBranch(bytes, extras, "A2", empty, horizon, cps, 0.3)); sb.Append(",");
                    sb.Append(RunSpawnBranch(bytes, extras, "B", edits(bSeg), horizon, cps, 0.3)); sb.Append(",");
                    sb.Append(RunSpawnBranch(bytes, extras, "C", edits(cSeg), horizon, cps, 0.3));
                    sb.Append("}}");
                    return sb.ToString();
                }
                catch (Exception ex)
                {
                    WriteLine("[Snapshot] EXCEPTION in spawn probe: " + ex);
                    return "{\"op\":\"DIAG_SPAWN\",\"error\":" + JStr(ex.ToString()) + "}";
                }
            }

            private string HandleIpcDiagSnapshot(System.Collections.Generic.Dictionary<string, object> obj)
            {
                var sb = new StringBuilder("{\"op\":\"DIAG_SNAPSHOT\"");
                try
                {
                    if (_ipcGame == null) return "{\"op\":\"DIAG_SNAPSHOT\",\"error\":\"no_active_episode\"}";
                    int nPre = obj != null && obj.ContainsKey("n_pre") ? (int)(double)obj["n_pre"] : 30;
                    int nPost = obj != null && obj.ContainsKey("n_post") ? (int)(double)obj["n_post"] : 20;
                    _diagRestoreMode = obj != null && obj.ContainsKey("restore_mode") ? (int)(double)obj["restore_mode"] : 0;
                    _diagUseExtras = !(obj != null && obj.ContainsKey("use_extras") && (double)obj["use_extras"] == 0);
                    int tag = 0;
                    for (int i = 0; i < nPre; i++) ScriptedDiagStep(_ipcGame, tag++, 0);

                    string fpSnap = StateFingerprint(_ipcGame);
                    string snapObs = BuildPolicyObservation(_ipcGame);
                    var snapDump = DumpModelLines(_ipcGame);
                    SnapshotExtras extras = _diagUseExtras ? CaptureExtras(_ipcGame) : null;
                    sb.Append(",\"behaviourSharesCityPrng\":" + JBool(extras != null && extras.behaviourSharesCityPrng));
                    var sw = System.Diagnostics.Stopwatch.StartNew();
                    byte[] bytes;
                    using (var ms = new MemoryStream())
                    {
                        using (var w = new BinaryWriter(ms))
                        {
                            bool ok = _ipcGame.Simulation.Scope.Export(_ipcGame.Simulation, w);
                            if (!ok) return "{\"op\":\"DIAG_SNAPSHOT\",\"error\":\"export_failed\"}";
                        }
                        bytes = ms.ToArray();
                    }
                    sw.Stop();
                    sb.Append(",\"exportMs\":" + sw.ElapsedMilliseconds + ",\"bytes\":" + bytes.Length + ",\"fpAtSnapshot\":" + JStr(fpSnap));
                    sb.Append(",\"scoreAtSnapshot\":" + Inv((double)_ipcGame.Simulation.GetModel<ScoreModel>().Score));

                    // R1: continue the ORIGINAL game
                    var r1 = new System.Collections.Generic.List<string>();
                    _diagTrace.Clear();
                    for (int i = 0; i < nPost; i++) r1.Add(ScriptedDiagStep(_ipcGame, tag + i, 0));
                    if (nPost > 70) sb.Append(",\"r1Trace\":" + JStr(string.Join(" ## ", _diagTrace.GetRange(70, Math.Min(10, _diagTrace.Count - 70)).ToArray())));
                    sb.Append(",\"r1Last\":" + JStr(r1[r1.Count - 1]));

                    System.Collections.Generic.List<string> firstRestoreList = null;
                    string[] names = { "restore1_same", "restore2_same", "restore3_wait", "restore4_otherVariant" };
                    int[] variants = { 0, 0, -1, 1 };
                    for (int k = 0; k < names.Length; k++)
                    {
                        TearDownIpcGameForDiag();
                        sw.Reset(); sw.Start();
                        string note;
                        MotorwaysGame g2;
                        try { g2 = RestoreGameFromBytes(bytes, out note, extras); }
                        catch (Exception ex) { sb.Append(",\"" + names[k] + "\":" + JStr("restore EXCEPTION " + ex)); continue; }
                        sw.Stop();
                        if (g2 == null) { sb.Append(",\"" + names[k] + "\":" + JStr("restore failed: " + note)); continue; }
                        _ipcGame = g2;
                        string fpRestored = StateFingerprint(g2);
                        string obsDiff = "";
                        string stateDiff = k == 0 ? DiffLines(snapDump, DumpModelLines(g2), 80) : "";
                        if (k == 0)
                        {
                            string ro = BuildPolicyObservation(g2);
                            int n0 = Math.Min(ro.Length, snapObs.Length), d0 = 0;
                            while (d0 < n0 && ro[d0] == snapObs[d0]) d0++;
                            obsDiff = d0 == n0 && ro.Length == snapObs.Length ? "identical" : ("first diff at char " + d0 + ": snap[" + snapObs.Substring(Math.Max(0, d0 - 60), Math.Min(160, snapObs.Length - Math.Max(0, d0 - 60))) + "] restored[" + ro.Substring(Math.Max(0, d0 - 60), Math.Min(160, ro.Length - Math.Max(0, d0 - 60))) + "]");
                        }
                        var rk = new System.Collections.Generic.List<string>();
                        _diagTrace.Clear();
                        for (int i = 0; i < nPost; i++) rk.Add(ScriptedDiagStep(g2, tag + i, variants[k]));
                        if (k == 0 && nPost > 70) sb.Append(",\"restore1Trace\":" + JStr(string.Join(" ## ", _diagTrace.GetRange(70, Math.Min(10, _diagTrace.Count - 70)).ToArray())));
                        if (k == 0) firstRestoreList = rk;
                        string vsFirstRestore = (k == 1 && firstRestoreList != null) ? FirstDivergence(firstRestoreList, rk) : "";
                        string cmp = variants[k] == 0 ? FirstDivergence(r1, rk) : ("score " + g2.Simulation.GetModel<ScoreModel>().Score + " last=" + rk[rk.Count - 1]);
                        sb.Append(",\"" + names[k] + "\":{\"importMs\":" + sw.ElapsedMilliseconds + ",\"fpAtRestoreEqualsSnapshot\":" + JBool(fpRestored == fpSnap) + ",\"fpAtRestore\":" + JStr(fpRestored) + ",\"stateDiff\":" + JStr(stateDiff) + ",\"obsDiffAtRestore\":" + JStr(obsDiff) + ",\"vsFirstRestore\":" + JStr(vsFirstRestore) + ",\"vsOriginal\":" + JStr(cmp) + "}");
                    }
                    sb.Append("}");
                    return sb.ToString();
                }
                catch (Exception ex)
                {
                    WriteLine("[Snapshot] EXCEPTION: " + ex);
                    return "{\"op\":\"DIAG_SNAPSHOT\",\"error\":" + JStr(ex.ToString()) + "}";
                }
            }

            private string HandleIpcHello()
            {
                return "{\"op\":\"HELLO\",\"protocolVersion\":" + JStr(IpcProtocolVersion) +
                    ",\"actionSpaceSize\":" + _ipcActionSpaceSize +
                    ",\"bounds\":{\"xMin\":" + _ipcActionBounds.xMin + ",\"yMin\":" + _ipcActionBounds.yMin + ",\"width\":" + _ipcActionBounds.width + ",\"height\":" + _ipcActionBounds.height + "}" +
                    ",\"decisionDelta\":" + Inv(_ipcDecisionDeltaSeconds) +
                    ",\"defaultMaxDecisions\":" + IpcDefaultMaxDecisions +
                    ",\"persistenceIsolationActive\":" + JBool(_isolationDiagnosticTestPlayer != null) +
                    "}";
            }

            private string HandleIpcReset(System.Collections.Generic.Dictionary<string, object> obj)
            {
                uint seed = obj != null && obj.ContainsKey("seed") ? (uint)(long)(double)obj["seed"] : (uint)new System.Random().Next(1, int.MaxValue);
                int maxDecisions = obj != null && obj.ContainsKey("max_decisions") ? (int)(double)obj["max_decisions"] : IpcDefaultMaxDecisions;
                double requestedDeltaSync = obj != null && obj.ContainsKey("decision_delta") ? (double)obj["decision_delta"] : IpcDecisionDelta;
                _ipcDecisionDeltaSeconds = requestedDeltaSync >= 0.1 ? requestedDeltaSync : IpcDecisionDelta;

                if (_ipcGame != null)
                {
                    try
                    {
                        _ipcGame.StopAudio();
                        _ipcGame.ClearPathfinder();
                        _ipcGame.Scope.ParentScope.Release(_ipcGame);
                    }
                    catch (Exception ex)
                    {
                        WriteLine($"[Phase10] EXCEPTION tearing down previous IPC episode's game: {ex}");
                    }
                    _ipcGame = null;
                }

                // Permanent safety gate (same AssertPersistenceIsolated used by every
                // Phase 8/9A episode) -- checked before constructing anything new.
                bool isolationOk = _isolationDiagnosticTestPlayer == null
                    || AssertPersistenceIsolated(_ipcApp, _isolationDiagnosticTestPlayer, null, "ipc-reset-pre");
                if (!isolationOk)
                {
                    return "{\"op\":\"RESET\",\"error\":\"persistence_isolation_failed\"}";
                }

                try
                {
                    _ipcGame = _ipcApp.Scope.Get<MotorwaysGame>();
                    _ipcGame.SetMapDefinition(_ipcMapDefinition);
                    global::Random.SetSimulationSeed(seed, _ipcApp.Scope);
                    _ipcGame.Start(_ipcCityDefinition, GameMode.Normal, null);
                    _ipcGame.SetPaused(false, Plugins.Analytics.AnalyticsTypes.PauseReason.TransitionIn);
                    _ipcGame.Tick(0f);
                    _ipcGame.Tick(0f);
                    _ipcGame.OnGameStarted();
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase10] EXCEPTION during IPC RESET construction: {ex}");
                    return "{\"op\":\"RESET\",\"error\":" + JStr(ex.Message) + "}";
                }

                _ipcDecisionIndex = 0;
                _ipcMaxDecisions = maxDecisions;
                try { _ipcPrevScore = (double)_ipcGame.Simulation.GetModel<ScoreModel>().Score; }
                catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION reading initial ScoreModel.Score: {ex}"); _ipcPrevScore = 0; }

                string obs;
                string legalJson;
                try
                {
                    obs = BuildPolicyObservation(_ipcGame);
                    legalJson = BuildLegalIndicesJson(EnumerateLegalActions(_ipcGame, _ipcActionBounds));
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase10] EXCEPTION building RESET observation/legal actions: {ex}");
                    return "{\"op\":\"RESET\",\"error\":" + JStr(ex.Message) + "}";
                }

                return "{\"op\":\"RESET\",\"protocolVersion\":" + JStr(IpcProtocolVersion) +
                    ",\"seed\":" + seed +
                    ",\"maxDecisions\":" + maxDecisions +
                    ",\"actionSpaceSize\":" + _ipcActionSpaceSize +
                    ",\"decisionIndex\":0," +
                    "\"observation\":" + obs + "," +
                    "\"legalActionIndices\":" + legalJson +
                    "}";
            }

            // Visible-training RESET (per explicit user request: watch every training
            // episode live, not just a post-hoc replay). Spans multiple Unity frames
            // (screen transition), so unlike every other IPC op it cannot return a
            // response synchronously -- it writes IpcResponsePath itself when done.
            // Reuses AttachGameToFrontend UNCHANGED (same Phase 9A-proven path: stock
            // seed-control, PrepareForMap, transition-in wait, simulation-identity
            // proof, SetGameSuspended(true), clock-ownership idle-frame check). The
            // ONLY new risk this exercises is calling it repeatedly, once per training
            // episode, instead of once per process -- GameContainerScreen.PrepareForMap
            // already has its own "previous game not cleaned up yet" guard
            // (CleanupPreviousGame()) specifically for this case; this is the first
            // live test of that repeated-attach path, verified with a short run before
            // trusting it for real training (see PHASE_10 doc).
            // SCREEN-FREE visible episodes (fundamental redesign). Every previous
            // failure class traced back to one root: driving the stock SCREEN STACK
            // (attach transitions, pop-to-menu, in-place restarts, pause pushes,
            // game-over/upgrade overlays) from code paths it was never designed
            // for. This path never touches it: episodes are constructed exactly
            // like the headless Phase 8/10 path (pure DI -- the one that ran
            // hundreds of episodes without a single lifecycle crash), and
            // visibility comes from US ticking the game with real frame time every
            // frame (sim paused -- the proven clock-ownership regime). The main
            // menu screen stays parked underneath for the process lifetime: its
            // canvas is hidden once, its decorative city stopped, and the
            // screen-stack state machine never moves again. Week-end and game-over
            // SCREENS cannot appear by construction (ScreenStack.IsInGame() is
            // false); the week choice is still granted by the simulation and
            // claimed via the forced action mask, and termination is detected from
            // the MODEL (destination overcrowding timer expiry -- the same native
            // condition that triggers the stock game over), which also unifies
            // headless and visible terminal semantics.
            private IEnumerator HandleIpcResetVisibleCoroutine(long requestId, uint seed, int maxDecisions)
            {
                // Sentinel FIRST -- same JIT-failure tripwire as HandleIpcStepVisibleCoroutine.
                WriteLine($"[Phase10] Visible RESET coroutine started: requestId={requestId} seed={seed} maxDecisions={maxDecisions}.");
                _ipcFreePlay = false; // a new episode always re-establishes trainer clock ownership
                bool isolationOk = _isolationDiagnosticTestPlayer == null
                    || AssertPersistenceIsolated(_ipcApp, _isolationDiagnosticTestPlayer, null, "ipc-reset-visible-pre");
                if (!isolationOk)
                {
                    WriteIpcResponse(requestId, "{\"op\":\"RESET\",\"error\":\"persistence_isolation_failed\"}");
                    yield break;
                }

                // Teardown of the previous episode: the HEADLESS teardown (StopAudio/
                // ClearPathfinder/Scope.Release), preceded by OnGameEnd(Exit) so
                // PlayerActionController.GameEnded clears _gameScope and the next
                // episode's human-input actions register cleanly.
                _ipcVisibleActive = false;
                if (_ipcGame != null)
                {
                    try { if (!_ipcGame.HasGameEnded) _ipcGame.OnGameEnd(GameEndReason.Exit); }
                    catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION in OnGameEnd during teardown: {ex.Message}"); }
                    try
                    {
                        _ipcGame.StopAudio();
                        _ipcGame.ClearPathfinder();
                        _ipcGame.Scope.ParentScope.Release(_ipcGame);
                    }
                    catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION tearing down previous visible episode's game: {ex}"); }
                    _ipcGame = null;
                }
                if (_ipcEpisodeCity != null)
                {
                    try { UnityEngine.Object.Destroy(_ipcEpisodeCity.gameObject); }
                    catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION destroying previous episode city: {ex.Message}"); }
                    _ipcEpisodeCity = null;
                }
                yield return null; // let Destroy() land before instantiating the next city

                CityDefinition episodeCityDefinition = null;
                yield return InstantiateFreshCityDefinitionForEpisode(_ipcMapDefinition, cd => episodeCityDefinition = cd);
                if (episodeCityDefinition == null)
                {
                    WriteLine($"[Phase10] Failed to instantiate a fresh CityDefinition for visible RESET (seed={seed}).");
                    WriteIpcResponse(requestId, "{\"op\":\"RESET\",\"error\":\"city_definition_instantiation_failed\"}");
                    yield break;
                }
                _ipcEpisodeCity = episodeCityDefinition;

                // Pure-DI construction -- identical to the proven headless path, with
                // the game born PAUSED (our stepping is the sole simulated clock).
                try
                {
                    MotorwaysGame g = _ipcApp.Scope.Get<MotorwaysGame>();
                    g.SetMapDefinition(_ipcMapDefinition);
                    global::Random.SetSimulationSeed(seed, _ipcApp.Scope);
                    g.Start(episodeCityDefinition, GameMode.Normal, null);
                    g.SetPaused(true, Plugins.Analytics.AnalyticsTypes.PauseReason.TransitionIn);
                    g.Tick(0f);
                    g.Tick(0f);
                    g.OnGameStarted();
                    g.Simulation.IsPaused = true;
                    // HUD finalization: GameUIScreen is a PER-GAME view (fresh
                    // instance in this game's scope, zero ScreenStack involvement);
                    // its OnTransitionedIn arms the clock/upgrade-bar appear sequence
                    // that normally runs when the stock InGame transition completes.
                    try { g.Scope.Get<GameUIScreen>().OnTransitionedIn(); }
                    catch (Exception exHud) { WriteLine($"[Phase10] EXCEPTION arming HUD: {exHud.Message}"); }

                    // Disable the keyboard game-speed keys (Space = toggle pause, plus
                    // pause/play/fast-forward/slow-down/speed-up). They are ALL one
                    // action type (ChangeGameSpeedAction). In trainer/stream mode they
                    // would fight the controlled clock: a pause/play press schedules a
                    // SetPausedCommand and toggles the view-time pause mid-episode.
                    // Pausing is only ever done explicitly (FREEPLAY_STOP / the HUD).
                    try
                    {
                        // NOT PlayerActionController.UnregisterAction<T>(scope): the stock
                        // implementation has an inner while-loop that never advances when a
                        // matching delegate is owned by a DIFFERENT scope than the filter
                        // (confirmed live: it froze every new instance's main thread on its
                        // first reset). Remove the entries ourselves, bounded, by reflection.
                        int removedSpeedKeys = RemoveActionConstructorsOfType(g.Scope.Get<PlayerActionController>(), typeof(Motorways.Actions.ChangeGameSpeedAction));
                        WriteLine("[Phase10] Keyboard game-speed keys (Space etc.) disabled for this episode (" + removedSpeedKeys + " bindings removed).");
                    }
                    catch (Exception exKeys) { WriteLine($"[Phase10] EXCEPTION disabling speed keys: {exKeys.Message}"); }
                    _ipcGame = g;
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase10] EXCEPTION during screen-free visible RESET construction: {ex}");
                    WriteIpcResponse(requestId, "{\"op\":\"RESET\",\"error\":" + JStr(ex.Message) + "}");
                    yield break;
                }

                EnsureVisibleStage();

                // View-time split: game-level time flows (HUD/pins/animation pacing),
                // simulated time stays frozen outside AdvanceSimulation.
                try
                {
                    object tiObj = null;
                    for (Type t = _ipcGame.GetType(); t != null && tiObj == null; t = t.BaseType)
                    {
                        var f = t.GetField("_timeInterval", BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.DeclaredOnly);
                        if (f != null) tiObj = f.GetValue(_ipcGame);
                    }
                    tiObj?.GetType().GetProperty("IsPaused")?.SetValue(tiObj, false, null);
                }
                catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION clearing view-time pause: {ex}"); }

                _ipcVisibleActive = true; // per-frame real-delta Tick driver on (see Update)

                // Settle: our per-frame Tick now pumps zero-time Steps; wait for the
                // command queue to drain and simulated time to hold still.
                {
                    float settleStart = Time.realtimeSinceStartup;
                    while (_ipcGame.Simulation.HasAnyScheduledCommands && Time.realtimeSinceStartup - settleStart < 5f) yield return null;
                    double prevT = 0; int stable = 0;
                    try { prevT = (double)_ipcGame.Simulation.GetModel<ClockModel>().Time; } catch (Exception) { }
                    for (int f = 0; f < 30 && stable < 3; f++)
                    {
                        yield return null;
                        double nowT = prevT;
                        try { nowT = (double)_ipcGame.Simulation.GetModel<ClockModel>().Time; } catch (Exception) { }
                        stable = nowT == prevT ? stable + 1 : 0;
                        prevT = nowT;
                    }
                    WriteLine($"[Phase10] Screen-free visible episode ready: simTime={prevT:F4}, Simulation.IsPaused={_ipcGame.Simulation.IsPaused}.");
                }

                _ipcLastInitInfo = "null";
                if (_ipcStartMode == "CONNECTED_START")
                {
                    try { _ipcLastInitInfo = InitializeConnectedStart(_ipcGame); }
                    catch (Exception ex) { _ipcLastInitInfo = "{\"mode\":\"CONNECTED_START\",\"error\":" + JStr(ex.Message) + "}"; WriteLine("[Phase11A] EXCEPTION: " + ex); }
                }

                _ipcDecisionIndex = 0;
                _ipcMaxDecisions = maxDecisions;
                try { _ipcPrevScore = (double)_ipcGame.Simulation.GetModel<ScoreModel>().Score; }
                catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION reading initial ScoreModel.Score (visible): {ex}"); _ipcPrevScore = 0; }

                string obs;
                string legalJson;
                try
                {
                    obs = BuildPolicyObservation(_ipcGame);
                    legalJson = BuildLegalIndicesJson(EnumerateLegalActions(_ipcGame, _ipcActionBounds));
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase10] EXCEPTION building visible RESET observation/legal actions: {ex}");
                    WriteIpcResponse(requestId, "{\"op\":\"RESET\",\"error\":" + JStr(ex.Message) + "}");
                    yield break;
                }

                _ipcLastObsJson = obs;
                _ipcLastLegalJson = legalJson;

                string response = "{\"op\":\"RESET\",\"protocolVersion\":" + JStr(IpcProtocolVersion) +
                    ",\"seed\":" + seed +
                    ",\"maxDecisions\":" + maxDecisions +
                    ",\"actionSpaceSize\":" + _ipcActionSpaceSize +
                    ",\"decisionDelta\":" + Inv(_ipcDecisionDeltaSeconds) +
                    ",\"decisionIndex\":0," +
                    "\"startMode\":" + JStr(_ipcStartMode) + "," +
                    "\"initInfo\":" + _ipcLastInitInfo + "," +
                    "\"observation\":" + obs + "," +
                    "\"legalActionIndices\":" + legalJson +
                    "}";
                WriteIpcResponse(requestId, response);
            }

            // Removes every registered player-action constructor whose product type is
            // `actionType`, from both PlayerActionController tables. Bounded (no while
            // loops): a single reverse for-loop per list. Returns how many were removed.
            private int RemoveActionConstructorsOfType(PlayerActionController pac, Type actionType)
            {
                int removed = 0;
                foreach (string fieldName in new[] { "_inputEventFilterToPlayerActionConstructors", "_owningScopeToConstructors" })
                {
                    var f = typeof(PlayerActionController).GetField(fieldName, BindingFlags.NonPublic | BindingFlags.Instance);
                    var dict = f != null ? f.GetValue(pac) as System.Collections.IDictionary : null;
                    if (dict == null) continue;
                    foreach (object val in dict.Values)
                    {
                        var list = val as System.Collections.IList;
                        if (list == null) continue;
                        for (int i = list.Count - 1; i >= 0; i--)
                        {
                            var d = list[i] as Delegate;
                            if (d != null && d.Method.ReturnType == actionType)
                            {
                                list.RemoveAt(i);
                                if (fieldName == "_inputEventFilterToPlayerActionConstructors") removed++;
                            }
                        }
                    }
                }
                try
                {
                    var cleanup = typeof(PlayerActionController).GetMethod("CleanupEmptyDictionaryEntries", BindingFlags.NonPublic | BindingFlags.Instance);
                    if (cleanup != null) cleanup.Invoke(pac, null);
                }
                catch (Exception) { }
                return removed;
            }

            // One-time (idempotent) stage dressing for screen-free visible episodes:
            // stop and hide the main menu's own decorations and point the shared
            // camera at the whole playable area so every agent placement is on
            // screen (user request: placements were landing outside the default
            // zoomed-in view). All best-effort -- failures only affect cosmetics.
            private bool _ipcStageDressed;
            private void EnsureVisibleStage()
            {
                try
                {
                    var theme = _ipcApp.Scope.Get<MotorwaysThemeDatabase>();
                    theme.SetCurrentMapDefinition(_ipcMapDefinition, 0f);
                    theme.SnapCurrentTransition();
                }
                catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION setting theme for visible stage: {ex.Message}"); }


                if (_ipcStageDressed) return;
                try
                {
                    ScreenStack ss = _ipcApp.Scope.Get<ScreenStack>();
                    StartupScreen startup = ss.GetActiveScreen<StartupScreen>();
                    if (startup != null)
                    {
                        try { startup.StopMenuGameAudio(); } catch (Exception) { }
                        try { startup.StopSimulatingMenuGame(); } catch (Exception) { }
                    }
                    // The menu's big WORLD-SPACE backdrop + grid are what the stock
                    // OnTransitionedIn hides when entering a game; without this the
                    // whole view is washed white (user-reported screenshot).
                    MenuPlacementDefinition placement = UnityEngine.Object.FindObjectOfType<MenuPlacementDefinition>();
                    if (placement != null)
                    {
                        try { if (placement.background != null) placement.background.SetActive(false); } catch (Exception) { }
                        try { if (placement.grid != null) placement.grid.enabled = false; } catch (Exception) { }
                    }
                    MainMenuScreen menu = ss.GetActiveScreen<MainMenuScreen>();
                    if (menu != null)
                    {
                        // Public stock call (BaseScalingScreen) -- deactivates the
                        // menu's entire UI canvas object.
                        try { menu.gameObject.SetActive(false); } catch (Exception ex2) { WriteLine($"[Phase10] EXCEPTION hiding menu canvas: {ex2.Message}"); }
                    }
                    WriteLine($"[Phase10] Visible stage dressed: menu city stopped, menu backdrop/grid hidden (placement={(placement != null ? "found" : "NOT FOUND")}), menu canvas deactivated, camera framed on the playable area. The screen stack stays parked at MainMenu for the process lifetime.");
                    _ipcStageDressed = true;
                }
                catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION dressing visible stage: {ex}"); }
            }

            private string HandleIpcStep(System.Collections.Generic.Dictionary<string, object> obj)
            {
                if (_ipcGame == null)
                {
                    return "{\"op\":\"STEP\",\"error\":\"no_active_episode\"}";
                }
                if (obj == null || !obj.ContainsKey("action"))
                {
                    return "{\"op\":\"STEP\",\"error\":\"missing_action\"}";
                }

                int actionIndex;
                try { actionIndex = (int)(double)obj["action"]; }
                catch (Exception ex) { return "{\"op\":\"STEP\",\"error\":" + JStr("bad action: " + ex.Message) + "}"; }

                ActionDescriptor action;
                try { action = ActionIndexToDescriptor(actionIndex, _ipcActionBounds); }
                catch (Exception ex) { return "{\"op\":\"STEP\",\"error\":" + JStr("bad action index " + actionIndex + ": " + ex.Message) + "}"; }

                // Same permanent pre-action safety gate used by every Phase 8/9A
                // episode: if it ever fails, force WAIT rather than execute.
                bool isolationOk = _isolationDiagnosticTestPlayer == null
                    || (_ipcDecisionIndex % 20 != 0)
                    || AssertPersistenceIsolated(_ipcApp, _isolationDiagnosticTestPlayer, _ipcGame, $"ipc-step-pre-decision{_ipcDecisionIndex}");
                if (!isolationOk)
                {
                    WriteLine($"[Phase10] *** ABORTING IPC action at decision {_ipcDecisionIndex}: AssertPersistenceIsolated FAILED. Forcing WAIT instead of {action}. ***");
                    action = ActionDescriptor.Wait();
                }

                // Once the native game has ended (confirmed live in visible mode: the
                // stock GameplayEventHandler can push the GameOver screen mid-episode
                // and OnGameEnd releases game internals), applying actions or stepping
                // the dead simulation throws NREs. A terminal state is absorbing:
                // report it, never step it.
                bool wasTerminal = IsTerminal(_ipcGame);
                bool accepted = false;
                string applyInfo = wasTerminal ? "terminal state (not applied)" : "";
                if (!wasTerminal)
                {
                    try { accepted = ApplyAction(_ipcGame, action, out applyInfo); }
                    catch (Exception ex) { applyInfo = $"EXCEPTION: {ex}"; WriteLine($"[Phase10] EXCEPTION applying IPC action {action}: {ex}"); }
                    try { AdvanceSimulation(_ipcGame, _ipcDecisionDeltaSeconds); }
                    catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION during IPC AdvanceSimulation: {ex}"); }
                }

                // Visible-training view refresh (per user-reported live finding):
                // with GameContainerScreen.SetGameSuspended(true) stopping its own
                // per-frame _game.Tick(deltaTime) call entirely (required for clock
                // ownership -- Step 3's hard invariant), the VIEW layer (ViewClient's
                // road/house GameObjects, theme/colour assignment, HUD refresh) never
                // updates either, since that refresh is bundled into the same Tick
                // call on the stock game. Confirmed live: audio cues fired correctly
                // (event-driven off ISimulation.Step() itself, unaffected), but no
                // roads/houses visibly changed, and one house's demand-colour icon
                // rendered black instead of its destination's colour -- a half-
                // initialized view, not a data problem (BuildPolicyObservation reads
                // the SAME underlying model data and is unaffected either way).
                // Fix: call Tick(0f) -- the SAME zero-delta "refresh without
                // advancing" pattern already used elsewhere in this codebase (e.g.
                // the warm-up Tick(0f) calls after MotorwaysGame.Start()) -- once per
                // decision, ONLY in visible mode. A zero deltaTime cannot push
                // Game.Tick's own real-time accumulator past another Timestep, so
                // this does not touch simulated time or violate clock ownership; it
                // only lets the view/UI layer catch up to the model state our own
                // AdvanceSimulation just changed.
                if (_ipcVisibleActive)
                {
                    // Two calls, not one -- matching the established warm-up pattern
                    // used elsewhere (MotorwaysGame.Start() followed by Tick(0f);
                    // Tick(0f);). Live evidence (user-reported, screenshot-confirmed):
                    // a single Tick(0f) left newly-created road View objects
                    // half-initialized (visible as untextured grey capsule shapes
                    // instead of the proper road sprite) -- consistent with view
                    // creation and its theme/sprite assignment happening across two
                    // separate ticks, not one.
                    try { _ipcGame.Tick(0f); _ipcGame.Tick(0f); }
                    catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION during visible-mode Tick(0f) view refresh: {ex}"); }
                }

                double scoreNow = _ipcPrevScore;
                try { scoreNow = (double)_ipcGame.Simulation.GetModel<ScoreModel>().Score; }
                catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION reading ScoreModel.Score after step: {ex}"); }
                double scoreDelta = scoreNow - _ipcPrevScore;
                _ipcPrevScore = scoreNow;

                bool isTerminalNow = IsTerminal(_ipcGame);
                bool justTerminated = isTerminalNow && !wasTerminal;
                double terminalPenalty = justTerminated ? IpcTerminalPenalty : 0.0;
                double totalReward = scoreDelta + terminalPenalty;

                _ipcDecisionIndex++;
                bool truncated = !isTerminalNow && _ipcDecisionIndex >= _ipcMaxDecisions;

                string obs;
                string legalJson;
                try
                {
                    var swObs = System.Diagnostics.Stopwatch.StartNew();
                    obs = BuildPolicyObservation(_ipcGame);
                    swObs.Stop();
                    var swLegal = System.Diagnostics.Stopwatch.StartNew();
                    var legal = (isTerminalNow || truncated)
                        ? new System.Collections.Generic.List<ActionDescriptor> { ActionDescriptor.Wait() }
                        : EnumerateLegalActions(_ipcGame, _ipcActionBounds);
                    swLegal.Stop();
                    legalJson = BuildLegalIndicesJson(legal);
                    if (_ipcDecisionIndex <= 5 || _ipcDecisionIndex % 50 == 0)
                    {
                        WriteLine($"[Phase10][PROFILE] decision={_ipcDecisionIndex} buildObsMs={swObs.ElapsedMilliseconds} enumerateLegalMs={swLegal.ElapsedMilliseconds} legalCount={legal.Count}");
                    }
                }
                catch (Exception ex)
                {
                    WriteLine($"[Phase10] EXCEPTION building STEP observation/legal actions: {ex}");
                    return "{\"op\":\"STEP\",\"error\":" + JStr(ex.Message) + "}";
                }

                return "{\"op\":\"STEP\"," +
                    "\"observation\":" + obs + "," +
                    "\"legalActionIndices\":" + legalJson + "," +
                    "\"reward\":" + Inv(totalReward) + "," +
                    "\"rewardComponents\":{\"scoreDelta\":" + Inv(scoreDelta) + ",\"terminalPenalty\":" + Inv(terminalPenalty) + "}," +
                    "\"terminated\":" + JBool(isTerminalNow) + "," +
                    "\"truncated\":" + JBool(truncated) + "," +
                    "\"accepted\":" + JBool(accepted) + "," +
                    "\"appliedAction\":" + JStr(action.ToString()) + "," +
                    "\"applyInfo\":" + JStr(applyInfo) + "," +
                    "\"decisionIndex\":" + _ipcDecisionIndex + "," +
                    "\"isolationOk\":" + JBool(isolationOk) +
                    "}";
            }

            // Visible-mode STEP: identical semantics to HandleIpcStep (same action
            // parsing, same AssertPersistenceIsolated gate, same ApplyAction/
            // AdvanceSimulation/BuildPolicyObservation/EnumerateLegalActions calls,
            // same response shape), but spans a few REAL Unity frames afterward so
            // newly-created road/house Views actually finish initializing (see the
            // dispatch comment above for why same-frame Tick(0f) calls were not
            // enough). Writes IpcResponsePath itself when done, like
            // HandleIpcResetVisibleCoroutine.
            // skipLegal: human-sandbox/perf mode. The full legal-action enumeration
            // probes ~1500 candidate edits across the 777-tile map on the MAIN THREAD
            // every decision -- the dominant per-step cost and the cause of visible
            // frame hitches when a human is watching/drawing (user-reported low FPS).
            // With skip_legal the response's legalActionIndices contains only WAIT
            // plus any pending upgrade-choice actions (cheap model reads). NOT for
            // training -- the mask is intentionally incomplete.
            // realtime: VISIBLE_TRAINING pacing. Instead of applying the decision's
            // native steps instantly (AdvanceSimulation burst -- correct but visually
            // choppy: vehicles only move when simulated time moves), unpause and let
            // the game's OWN per-frame clock run them natively, re-pausing the moment
            // simulated time has advanced exactly IpcDecisionDelta. Same step count,
            // same Fix64 math, same determinism per decision -- just spread over
            // ~0.3s of wall time so the engine's interpolation renders smooth motion.
            // Costs ~1x real time per decision; TRAIN_FAST keeps the instant burst.
            private IEnumerator HandleIpcStepVisibleCoroutine(long requestId, int actionIndex, bool skipLegal = false, bool realtime = false)
            {
                // Sentinel FIRST: if this line never appears after a STEP was consumed,
                // the coroutine failed to JIT (missing-BCL-method token somewhere in this
                // body) and died before running -- see the MissingMethodException note in
                // the DIAG block below.
                WriteLine($"[Phase10] Visible STEP coroutine started: requestId={requestId} action={actionIndex} decision={_ipcDecisionIndex}.");
                var swStep = System.Diagnostics.Stopwatch.StartNew();
                long tSentinel = swStep.ElapsedMilliseconds, tIso = 0, tAdv = 0, tBuild = 0;
                if (_ipcGame == null)
                {
                    WriteIpcResponse(requestId, "{\"op\":\"STEP\",\"error\":\"no_active_episode\"}");
                    yield break;
                }

                ActionDescriptor action;
                try { action = ActionIndexToDescriptor(actionIndex, _ipcActionBounds); }
                catch (Exception ex)
                {
                    WriteIpcResponse(requestId, "{\"op\":\"STEP\",\"error\":" + JStr("bad action index " + actionIndex + ": " + ex.Message) + "}");
                    yield break;
                }

                bool isolationOk = _isolationDiagnosticTestPlayer == null
                    || (_ipcDecisionIndex % 20 != 0)
                    || AssertPersistenceIsolated(_ipcApp, _isolationDiagnosticTestPlayer, _ipcGame, $"ipc-step-pre-decision{_ipcDecisionIndex}");
                tIso = swStep.ElapsedMilliseconds;
                if (!isolationOk)
                {
                    WriteLine($"[Phase10] *** ABORTING IPC action at decision {_ipcDecisionIndex}: AssertPersistenceIsolated FAILED. Forcing WAIT instead of {action}. ***");
                    action = ActionDescriptor.Wait();
                }

                // Terminal states are absorbing (see the identical guard in the sync
                // handler): once the native game over fired, never apply or step.
                bool wasTerminal = IsTerminal(_ipcGame);
                bool accepted = false;
                string applyInfo = wasTerminal ? "terminal state (not applied)" : "";
                if (!wasTerminal)
                {
                    try { accepted = ApplyAction(_ipcGame, action, out applyInfo); }
                    catch (Exception ex) { applyInfo = $"EXCEPTION: {ex}"; WriteLine($"[Phase10] EXCEPTION applying IPC action {action}: {ex}"); }
                }

                if (wasTerminal)
                {
                    // no simulation advance on a dead game
                }
                else if (realtime)
                {
                    // Paced variant (see the realtime note on this method): unpause,
                    // let the screen's own per-frame _game.Tick run the native steps,
                    // re-pause once simulated time has advanced by the decision delta.
                    // The gate is checked once per frame AFTER that frame's steps ran,
                    // so a slow frame that spans two native steps can overshoot by one
                    // 0.1s tick -- fine for a watching mode (the response stays
                    // internally consistent); use the instant burst for strict
                    // fixed-delta semantics.
                    double rtStart = 0;
                    try { rtStart = (double)_ipcGame.Simulation.GetModel<ClockModel>().Time; }
                    catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION reading clock for realtime step: {ex}"); }
                    double rtTarget = rtStart + _ipcDecisionDeltaSeconds - 1e-9;
                    _ipcRealtimeWindow = true; // suspend the per-frame pause re-assertion for this window
                    _ipcGame.Simulation.IsPaused = false;
                    float rtWallStart = Time.realtimeSinceStartup;
                    while (Time.realtimeSinceStartup - rtWallStart < 5f)
                    {
                        double tNow = rtStart;
                        try { tNow = (double)_ipcGame.Simulation.GetModel<ClockModel>().Time; }
                        catch (Exception) { break; }
                        if (tNow >= rtTarget) break;
                        yield return null;
                    }
                    _ipcGame.Simulation.IsPaused = true;
                    _ipcRealtimeWindow = false;
                    // Same synchronous week-end suppression as AdvanceSimulation's
                    // (see there) -- the realtime window advances the sim without it.
                    try
                    {
                        UpgradeDatabaseModel upModelRt = _ipcGame.Simulation.GetModel<UpgradeDatabaseModel>();
                        if (upModelRt != null && upModelRt.pendingUpgradeChoices != null
                            && upModelRt.pendingUpgradeChoices.Count > upModelRt.numChoicesMade)
                        {
                            upModelRt.numChoicesMade = upModelRt.pendingUpgradeChoices.Count;
                        }
                    }
                    catch (Exception) { }
                }
                else
                {
                    try { AdvanceSimulation(_ipcGame, _ipcDecisionDeltaSeconds); }
                    catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION during IPC AdvanceSimulation: {ex}"); }
                }

                // NO frame yields in burst mode (throughput): the observation is
                // built from MODEL state only, and views are refreshed independently
                // by the per-frame driver in Update -- the historical reason for
                // yielding here (view starvation under the suspended-screen design)
                // no longer exists. Each decision was costing ~3-5 rendered frames
                // of pure waiting.

                // If the MODEL just claimed an upgrade while the stock week-end
                // GameUpgradeScreen is up (visible mode pushes it via
                // GameplayEventHandler), close it when no choices remain -- the
                // stock screen only closes itself through its own buttons, and the
                // model's SelectUpgradeCommand consumed the choice underneath it.
                if (action.Kind == ActionKind.ChooseUpgrade && accepted)
                {
                    try
                    {
                        // Close the stock week-end screen after ANY model claim while
                        // it is the top screen -- via the EXACT stock close path the
                        // screen's own selection button uses: CloseScreenAfterSelection
                        // (arms the screen's self-pop in its next Tick) plus
                        // GameContainerScreen.SkipNextTransition (zero-duration
                        // re-entry). Calling ScreenStack.PopOneScreen directly (tried
                        // twice) ran the FULL 1.5s animated menu->game re-transition,
                        // and the game's scope was dead by the time it completed --
                        // reproducibly killing training. Stock never runs that
                        // animated re-entry mid-game, so neither do we.
                        ScreenStack ssAfter = _ipcApp.Scope.Get<ScreenStack>();
                        if (ssAfter.HasVisibleScreens() && ssAfter.GetTopVisibleScreen() is GameUpgradeScreen upScreenTop)
                        {
                            upScreenTop.CloseScreenAfterSelection();
                            ssAfter.GetActiveScreen<GameContainerScreen>()?.SkipNextTransition();
                            WriteLine("[Phase10] Closed the stock GameUpgradeScreen via its own CloseScreenAfterSelection + SkipNextTransition (stock selection-button path) after the model's upgrade choice.");
                        }
                    }
                    catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION closing GameUpgradeScreen after model upgrade choice: {ex}"); }
                }

                // One-shot diagnostic (read-only reflection, same pattern used
                // throughout this file): directly inspect the live RoadView objects
                // ViewClient is actually tracking, rather than keep guessing from
                // static source after three failed fix attempts. Logged only for the
                // first ADD_ROAD this episode to avoid spam.
                if (action.Kind == ActionKind.Add && accepted && _ipcDecisionIndex <= 3)
                {
                    try
                    {
                        ViewClient vc = _ipcGame.Scope.Get<ViewClient>();
                        WriteLine($"[Phase10][DIAG] ViewClient concrete type: {vc?.GetType().FullName ?? "NULL"}");
                        // GetPrivateField's simple GetType().GetField() does not see
                        // PRIVATE fields declared on a BASE class when vc is actually
                        // an instance of a subclass (e.g. MotorwaysClient : ViewClient)
                        // -- walk the hierarchy ourselves.
                        object viewsObj = null;
                        for (Type t = vc?.GetType(); t != null && viewsObj == null; t = t.BaseType)
                        {
                            var f = t.GetField("_views", BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.DeclaredOnly);
                            if (f != null) viewsObj = f.GetValue(vc);
                        }
                        var views = viewsObj as System.Collections.IList;
                        var typeCounts = new System.Collections.Generic.Dictionary<string, int>();
                        if (views != null)
                        {
                            foreach (object v in views)
                            {
                                string tn = v?.GetType().Name ?? "null";
                                typeCounts[tn] = typeCounts.TryGetValue(tn, out int c) ? c + 1 : 1;
                            }
                        }
                        // No Linq here, deliberately: System.Linq.Enumerable.OrderByDescending
                        // is MISSING from this game's stripped Mono BCL (confirmed live via
                        // MissingMethodException in output_log.txt). Worse, a missing-method
                        // token anywhere in a coroutine's MoveNext body makes the WHOLE
                        // coroutine fail to JIT on its first MoveNext -- the exception is
                        // raised before any statement runs, bypassing every try/catch inside,
                        // and Unity swallows it into the player log only. That silent death
                        // (with the request already marked consumed) was the entire
                        // "first STEP never processed" hang. Manual sort + StringBuilder only.
                        var sortedCounts = new System.Collections.Generic.List<System.Collections.Generic.KeyValuePair<string, int>>(typeCounts);
                        sortedCounts.Sort((a, b) => b.Value.CompareTo(a.Value));
                        var sbCounts = new StringBuilder();
                        foreach (var kv in sortedCounts)
                        {
                            if (sbCounts.Length > 0) sbCounts.Append(", ");
                            sbCounts.Append(kv.Key).Append('=').Append(kv.Value);
                        }
                        WriteLine($"[Phase10][DIAG] Total views: {(views != null ? views.Count : -1)}. By type: {sbCounts}");

                        // Native tile road state, via the SAME TilemapModel/Tile lookup
                        // EnumerateLegalActions already uses -- cheap, no per-view
                        // reflection, cannot hang. (A more invasive per-TileView
                        // reflective lookup was tried here and caused a live hang --
                        // removed; the rest of this investigation continues via static
                        // decompiled-source reading instead of further live reflection.)
                        TilemapModel tilemap = _ipcGame.Simulation.GetModel<TilemapModel>();
                        Tile editedTile = tilemap.GetTile(action.Coord);
                        WriteLine($"[Phase10][DIAG] Tile at {action.Coord}: {(editedTile != null ? $"roadN={editedTile.GetTwoLaneRoadStateInDirection(TileDirection.North)} roadE={editedTile.GetTwoLaneRoadStateInDirection(TileDirection.East)} roadS={editedTile.GetTwoLaneRoadStateInDirection(TileDirection.South)} roadW={editedTile.GetTwoLaneRoadStateInDirection(TileDirection.West)}" : "NULL")}");
                    }
                    catch (Exception ex)
                    {
                        WriteLine($"[Phase10][DIAG] EXCEPTION inspecting RoadView state: {ex}");
                    }
                }

                tAdv = swStep.ElapsedMilliseconds;
                double scoreNow = _ipcPrevScore;
                try { scoreNow = (double)_ipcGame.Simulation.GetModel<ScoreModel>().Score; }
                catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION reading ScoreModel.Score after step: {ex}"); }
                double scoreDelta = scoreNow - _ipcPrevScore;
                _ipcPrevScore = scoreNow;

                bool isTerminalNow = IsTerminal(_ipcGame);
                bool justTerminated = isTerminalNow && !wasTerminal;
                double terminalPenalty = justTerminated ? IpcTerminalPenalty : 0.0;
                double totalReward = scoreDelta + terminalPenalty;

                _ipcDecisionIndex++;
                bool truncated = !isTerminalNow && _ipcDecisionIndex >= _ipcMaxDecisions;

                string obs;
                string legalJson;
                try
                {
                    var swObs = System.Diagnostics.Stopwatch.StartNew();
                    obs = BuildPolicyObservation(_ipcGame);
                    swObs.Stop();
                    var swLegal = System.Diagnostics.Stopwatch.StartNew();
                    System.Collections.Generic.List<ActionDescriptor> legal;
                    if (isTerminalNow || truncated)
                    {
                        legal = new System.Collections.Generic.List<ActionDescriptor> { ActionDescriptor.Wait() };
                    }
                    else if (skipLegal)
                    {
                        // Cheap model reads only; same FORCED-choice rule as the full
                        // enumeration: pending upgrade choice => options only.
                        legal = new System.Collections.Generic.List<ActionDescriptor>();
                        UpgradeDatabaseModel upgradesLite = _ipcGame.Simulation.GetModel<UpgradeDatabaseModel>();
                        if (upgradesLite != null && upgradesLite.pendingUpgradeChoices != null && upgradesLite.pendingUpgradeChoices.Count > 0)
                        {
                            int optCount = upgradesLite.pendingUpgradeChoices[0].choices != null ? upgradesLite.pendingUpgradeChoices[0].choices.Count : 0;
                            for (int u = 0; u < optCount && u < UpgradeChoiceSlots; u++) legal.Add(ActionDescriptor.ChooseUpgrade(u));
                        }
                        if (legal.Count == 0) legal.Add(ActionDescriptor.Wait());
                    }
                    else
                    {
                        legal = EnumerateLegalActions(_ipcGame, _ipcActionBounds);
                    }
                    swLegal.Stop();
                    legalJson = BuildLegalIndicesJson(legal);
                    if (_ipcDecisionIndex <= 5 || _ipcDecisionIndex % 50 == 0)
                    {
                        WriteLine($"[Phase10][PROFILE][visible] decision={_ipcDecisionIndex} buildObsMs={swObs.ElapsedMilliseconds} enumerateLegalMs={swLegal.ElapsedMilliseconds} skipLegal={skipLegal} legalCount={legal.Count}");
                    }
                }
                catch (Exception ex)
                {
                    // The game can die INSIDE this step through stock flows we don't
                    // control -- native game over (OnGameEnd releases internals), or
                    // screen-stack fallout from stacked GameOver/Upgrade screens
                    // releasing the pooled GameContainerScreen (confirmed live three
                    // times; HasGameEnded stays FALSE when the death is a scope
                    // release rather than a game over, so do NOT gate on it). The
                    // episode cannot continue either way: whenever a cached
                    // observation exists, answer terminated=true with it so the
                    // trainer closes the episode and RESETs -- a build failure must
                    // never kill the training run.
                    if (_ipcLastObsJson != null)
                    {
                        WriteLine($"[Phase10] Post-step observation build failed on a just-terminated game ({ex.GetType().Name}: {ex.Message}) -- responding with the cached previous observation and terminated=true.");
                        obs = _ipcLastObsJson;
                        legalJson = "[0]";
                        isTerminalNow = true;
                        if (!wasTerminal) { terminalPenalty = IpcTerminalPenalty; totalReward = scoreDelta + terminalPenalty; }
                        truncated = false;
                    }
                    else
                    {
                        WriteLine($"[Phase10] EXCEPTION building STEP observation/legal actions: {ex}");
                        WriteIpcResponse(requestId, "{\"op\":\"STEP\",\"error\":" + JStr(ex.Message) + "}");
                        yield break;
                    }
                }

                try
                {
                    double dayNow = 0, hourNow = 0;
                    try { double tSim = (double)_ipcGame.Simulation.GetModel<ClockModel>().Time; hourNow = tSim / (5.0 / 6.0); dayNow = hourNow / 24.0; } catch (Exception) { }
                    int roadsAvail = -1, roadsTotal = -1;
                    try { var upg = _ipcGame.Simulation.GetModel<UpgradeDatabaseModel>(); roadsAvail = upg.GetAvailableUpgradeCount(UpgradeType.Concrete); roadsTotal = upg.GetTotalUpgradeCount(UpgradeType.Concrete); } catch (Exception) { }
                    _overlayEnvLine = $"decision {_ipcDecisionIndex}/{_ipcMaxDecisions}   day {(int)dayNow} h{(int)(hourNow % 24.0)}   score {scoreNow:F0}   roads {roadsAvail}/{roadsTotal}   reward {totalReward:F2}   {(isTerminalNow ? "TERMINAL" : truncated ? "TRUNCATED" : action.ToString())}";
                }
                catch (Exception) { }

                _ipcLastObsJson = obs;
                _ipcLastLegalJson = legalJson;

                string response = "{\"op\":\"STEP\"," +
                    "\"observation\":" + obs + "," +
                    "\"legalActionIndices\":" + legalJson + "," +
                    "\"reward\":" + Inv(totalReward) + "," +
                    "\"rewardComponents\":{\"scoreDelta\":" + Inv(scoreDelta) + ",\"terminalPenalty\":" + Inv(terminalPenalty) + "}," +
                    "\"terminated\":" + JBool(isTerminalNow) + "," +
                    "\"truncated\":" + JBool(truncated) + "," +
                    "\"accepted\":" + JBool(accepted) + "," +
                    "\"appliedAction\":" + JStr(action.ToString()) + "," +
                    "\"applyInfo\":" + JStr(applyInfo) + "," +
                    "\"decisionIndex\":" + _ipcDecisionIndex + "," +
                    "\"isolationOk\":" + JBool(isolationOk) +
                    "}";
                tBuild = swStep.ElapsedMilliseconds;
                WriteIpcResponse(requestId, response);
                long tWrite = swStep.ElapsedMilliseconds;
                if (_ipcDecisionIndex <= 5 || _ipcDecisionIndex % 25 == 0)
                {
                    WriteLine($"[Phase10][PROFILE2] decision={_ipcDecisionIndex} sentinelLog={tSentinel}ms isolation={tIso - tSentinel}ms applyAdvance={tAdv - tIso}ms obsLegalReward={tBuild - tAdv}ms responseWrite={tWrite - tBuild}ms total={tWrite}ms respBytes={response.Length}");
                }
            }

            // IsTerminal that cannot throw even on a torn-down game.
            private bool IsTerminalSafe(MotorwaysGame g)
            {
                try { return g != null && g.HasGameEnded; }
                catch (Exception) { return true; }
            }

            // Read-only diagnostic for the live human-input pipeline: BlockAllInput &
            // friends (BaseScalingScreen.TransitionIn sets BlockAllInput=true and only
            // OnTransitionedIn clears it; BasePopup sets it true while ANY popup is
            // open), plus the popup stack and screen stack, to find why mouse input
            // (draw/zoom) is dead in the attached game.
            // Human free-play: hand the clock back to the game entirely (stock
            // real-time simulation -- smooth cars, native pacing) while NO training
            // episode needs clock ownership. Burst stepping makes vehicle motion
            // inherently choppy (sim time advances 0.3s a few times a second), which
            // is an accepted cosmetic artifact DURING training but wrong for a human
            // playing the sandbox. FREEPLAY unpauses and suspends the per-frame
            // pause re-assertion; FREEPLAY_STOP re-pauses and restores trainer
            // ownership. A later RESET also implicitly ends free play (teardown +
            // fresh attach re-establish the paused regime).
            private bool _ipcFreePlay;
            // Realtime step window (visible pacing) -- distinct from free play so
            // overlay/guards gated on _ipcFreePlay stay active during paced steps
            // (reusing _ipcFreePlay made the overlay blink once per decision).
            private bool _ipcRealtimeWindow;
            private string _ipcStartMode = "NORMAL_START";
            // GAP curriculum (Phase 11A follow-up): number of NATIVE road edits, counted
            // back from the destination end of the initial path, that are deliberately
            // NOT built. 0 = fully connected (CONNECTED_START). With a gap the city
            // starts one edit (or a few) short of a working connection, so native score
            // is reachable only by closing the gap -- training the thing a fully
            // connected start cannot: CONNECTING.
            private int _ipcStartGap = 0;
            private int _ipcStartGapIndex = -1;   // >= 0: omit exactly the path edit at this index (Gap-1 tasks)
            private string _ipcLastInitInfo = "null";
            private bool _ipcOpInFlight;
            private float _ipcOpInFlightSince;

            private string HandleIpcFreePlay(bool enable)
            {
                if (!_ipcVisibleActive || _ipcGame == null)
                {
                    return "{\"op\":\"FREEPLAY\",\"error\":\"no_attached_game\"}";
                }
                try
                {
                    _ipcFreePlay = enable;
                    _ipcGame.Simulation.IsPaused = !enable;
                    WriteLine($"[Phase10] Free play {(enable ? "ENABLED -- stock real-time simulation, clock handed to the game" : "DISABLED -- game re-paused, trainer owns the clock again")}.");
                    return "{\"op\":\"FREEPLAY\",\"enabled\":" + JBool(enable) + "}";
                }
                catch (Exception ex)
                {
                    return "{\"op\":\"FREEPLAY\",\"error\":" + JStr(ex.Message) + "}";
                }
            }

            private string HandleIpcDiagInput()
            {
                var sb = new StringBuilder();
                sb.Append("{\"op\":\"DIAG_INPUT\"");
                try
                {
                    InputState inputState = _ipcApp.Scope.Get<InputState>();
                    sb.Append(",\"blockAllInput\":" + JBool(inputState.BlockAllInput));
                    sb.Append(",\"blockUIInput\":" + JBool(inputState.BlockUIInput));
                    sb.Append(",\"blockGameInput\":" + JBool(inputState.BlockGameInput));
                    sb.Append(",\"blockActions\":" + JBool(inputState.BlockActions));
                }
                catch (Exception ex) { sb.Append(",\"inputStateError\":" + JStr(ex.Message)); }
                try
                {
                    Popups.PopupStack popupStack = _ipcApp.Scope.Get<Popups.PopupStack>();
                    string popupsDesc = "?";
                    var f = popupStack.GetType().GetField("_popupStack", BindingFlags.NonPublic | BindingFlags.Instance);
                    var list = f != null ? f.GetValue(popupStack) as System.Collections.IList : null;
                    if (list != null)
                    {
                        var names = new StringBuilder();
                        foreach (object p in list) { if (names.Length > 0) names.Append(','); names.Append(p?.GetType().Name ?? "null"); }
                        popupsDesc = $"[{list.Count}]:{names}";
                    }
                    sb.Append(",\"hasActivePopups\":" + JBool(popupStack.HasActivePopups));
                    sb.Append(",\"popups\":" + JStr(popupsDesc));
                }
                catch (Exception ex) { sb.Append(",\"popupError\":" + JStr(ex.Message)); }
                try
                {
                    ScreenStack ss = _ipcApp.Scope.Get<ScreenStack>();
                    var top = ss.HasVisibleScreens() ? ss.GetTopVisibleScreen() : null;
                    sb.Append(",\"topVisibleScreen\":" + JStr(top != null ? top.GetType().Name : "none"));
                    sb.Append(",\"topIsTransitioningIn\":" + JBool(top != null && top.IsTransitioningIn()));
                }
                catch (Exception ex) { sb.Append(",\"screenError\":" + JStr(ex.Message)); }
                string result = sb.Append("}").ToString();
                WriteLine($"[Phase10][DIAG_INPUT] {result}");
                return result;
            }

            private string HandleIpcClose()
            {
                if (_ipcVisibleActive)
                {
                    // Frontend-attached game: GameContainerScreen owns its lifecycle.
                    // Manually releasing it here (StopAudio/ClearPathfinder/Scope.Release)
                    // would race with the screen's own CleanupPreviousGame(), which runs
                    // automatically the next time PrepareForMap is called. Leave it for
                    // the screen to clean up, matching Phase 9A's established pattern of
                    // never tearing down an attached game manually.
                    _ipcGame = null;
                }
                else if (_ipcGame != null)
                {
                    try
                    {
                        _ipcGame.StopAudio();
                        _ipcGame.ClearPathfinder();
                        _ipcGame.Scope.ParentScope.Release(_ipcGame);
                    }
                    catch (Exception ex)
                    {
                        WriteLine($"[Phase10] EXCEPTION tearing down IPC episode's game on CLOSE: {ex}");
                    }
                    _ipcGame = null;
                }
                return "{\"op\":\"CLOSE\",\"ok\":true}";
            }

            private string BuildLegalIndicesJson(System.Collections.Generic.List<ActionDescriptor> legal)
            {
                var sb = new StringBuilder();
                sb.Append('[');
                for (int i = 0; i < legal.Count; i++)
                {
                    if (i > 0) sb.Append(',');
                    sb.Append(DescriptorToActionIndex(legal[i]));
                }
                sb.Append(']');
                return sb.ToString();
            }

            // Fixed, deterministic bijection between a single integer action index
            // (what crosses the wire and what Gymnasium's Discrete(n) action space
            // uses) and an ActionDescriptor. Canonical order: 0 = WAIT; then for
            // each tile in `bounds` in row-major (y then x) order, for dir in
            // [East, South] (the same two probe directions EnumerateLegalActions
            // uses), for kind in [Add, Remove]. actionSpaceSize = 1 + width*height*4.
            private static ActionDescriptor ActionIndexToDescriptor(int index, RectInt bounds)
            {
                if (index == 0) return ActionDescriptor.Wait();
                int maxTile = bounds.width * bounds.height;
                int upgradeBase = 1 + maxTile * 4;
                if (index >= upgradeBase)
                {
                    int optionIndex = index - upgradeBase;
                    if (optionIndex < 0 || optionIndex >= UpgradeChoiceSlots) throw new ArgumentOutOfRangeException(nameof(index));
                    return ActionDescriptor.ChooseUpgrade(optionIndex);
                }
                int rest = index - 1;
                int tileIndex = rest / 4;
                int sub = rest % 4;
                int dirIndex = sub / 2;
                int kindIndex = sub % 2;
                if (tileIndex < 0 || tileIndex >= maxTile) throw new ArgumentOutOfRangeException(nameof(index));
                int x = bounds.xMin + (tileIndex % bounds.width);
                int y = bounds.yMin + (tileIndex / bounds.width);
                TileDirection dir = dirIndex == 0 ? TileDirection.East : TileDirection.South;
                Vector2Int coord = new Vector2Int(x, y);
                return kindIndex == 0 ? ActionDescriptor.Add(coord, dir) : ActionDescriptor.Remove(coord, dir);
            }

            private int DescriptorToActionIndex(ActionDescriptor a)
            {
                if (a.Kind == ActionKind.Wait) return 0;
                RectInt bounds = _ipcActionBounds;
                if (a.Kind == ActionKind.ChooseUpgrade)
                {
                    return 1 + bounds.width * bounds.height * 4 + a.UpgradeOptionIndex;
                }
                int tileIndex = (a.Coord.y - bounds.yMin) * bounds.width + (a.Coord.x - bounds.xMin);
                int dirIndex = a.Direction == TileDirection.East ? 0 : 1;
                int kindIndex = a.Kind == ActionKind.Add ? 0 : 1;
                return 1 + tileIndex * 4 + dirIndex * 2 + kindIndex;
            }

            // Minimal hand-rolled JSON parser (no Newtonsoft/System.Text.Json
            // reference exists in this project -- see DoorstopBootstrap.csproj).
            // Supports exactly what the Phase 10 IPC protocol's incoming requests
            // need: objects, arrays, strings, numbers, true/false/null. Returns
            // Dictionary<string,object> / List<object> / string / double / bool / null.
            private static class MiniJson
            {
                public static object Parse(string s)
                {
                    int i = 0;
                    object result = ParseValue(s, ref i);
                    return result;
                }

                private static void SkipWhitespace(string s, ref int i)
                {
                    while (i < s.Length && char.IsWhiteSpace(s[i])) i++;
                }

                private static object ParseValue(string s, ref int i)
                {
                    SkipWhitespace(s, ref i);
                    char c = s[i];
                    if (c == '{') return ParseObject(s, ref i);
                    if (c == '[') return ParseArray(s, ref i);
                    if (c == '"') return ParseString(s, ref i);
                    if (c == 't') { i += 4; return true; }
                    if (c == 'f') { i += 5; return false; }
                    if (c == 'n') { i += 4; return null; }
                    return ParseNumber(s, ref i);
                }

                private static System.Collections.Generic.Dictionary<string, object> ParseObject(string s, ref int i)
                {
                    var dict = new System.Collections.Generic.Dictionary<string, object>();
                    i++; // '{'
                    SkipWhitespace(s, ref i);
                    if (s[i] == '}') { i++; return dict; }
                    while (true)
                    {
                        SkipWhitespace(s, ref i);
                        string key = ParseString(s, ref i);
                        SkipWhitespace(s, ref i);
                        i++; // ':'
                        object value = ParseValue(s, ref i);
                        dict[key] = value;
                        SkipWhitespace(s, ref i);
                        if (s[i] == ',') { i++; continue; }
                        if (s[i] == '}') { i++; break; }
                    }
                    return dict;
                }

                private static System.Collections.Generic.List<object> ParseArray(string s, ref int i)
                {
                    var list = new System.Collections.Generic.List<object>();
                    i++; // '['
                    SkipWhitespace(s, ref i);
                    if (s[i] == ']') { i++; return list; }
                    while (true)
                    {
                        object value = ParseValue(s, ref i);
                        list.Add(value);
                        SkipWhitespace(s, ref i);
                        if (s[i] == ',') { i++; continue; }
                        if (s[i] == ']') { i++; break; }
                    }
                    return list;
                }

                private static string ParseString(string s, ref int i)
                {
                    i++; // opening quote
                    var sb = new StringBuilder();
                    while (s[i] != '"')
                    {
                        if (s[i] == '\\')
                        {
                            i++;
                            char esc = s[i];
                            if (esc == 'n') sb.Append('\n');
                            else if (esc == 't') sb.Append('\t');
                            else if (esc == 'r') sb.Append('\r');
                            else if (esc == 'u')
                            {
                                string hex = s.Substring(i + 1, 4);
                                int code = 0;
                                foreach (char hc in hex)
                                {
                                    int digit = hc >= '0' && hc <= '9' ? hc - '0' : (hc >= 'a' && hc <= 'f' ? hc - 'a' + 10 : hc - 'A' + 10);
                                    code = code * 16 + digit;
                                }
                                sb.Append((char)code);
                                i += 4;
                            }
                            else sb.Append(esc);
                        }
                        else
                        {
                            sb.Append(s[i]);
                        }
                        i++;
                    }
                    i++; // closing quote
                    return sb.ToString();
                }

                private static double ParseNumber(string s, ref int i)
                {
                    int start = i;
                    while (i < s.Length && (char.IsDigit(s[i]) || s[i] == '-' || s[i] == '+' || s[i] == '.' || s[i] == 'e' || s[i] == 'E')) i++;
                    return double.Parse(s.Substring(start, i - start), System.Globalization.CultureInfo.InvariantCulture);
                }
            }

            // Phase 10 Step 5: replay an already-decided, fixed sequence of action
            // indices (produced by python/evaluate.py against a trained PPO
            // checkpoint on a held-out seed) through the SAME proven Phase 9A
            // frontend-attachment path (AttachGameToFrontend, unchanged). This is
            // not a new attachment mechanism -- it is RunVisibleRandomPolicyEpisode
            // with the policy replaced by a precomputed list, which is sufficient
            // because the environment is deterministic given the same seed and
            // action sequence (confirmed in Phase 8's determinism test).
            private IEnumerator RunVisibleFixedActionEpisode(IApp app, CityDefinition cityDefinition, MapDefinition mapDefinition, System.Collections.Generic.List<ActionDescriptor> fixedActions)
            {
                WriteLine($"[Phase10] ===== Visible fixed-action replay: {fixedActions.Count} actions from a trained PPO evaluation episode =====");

                MotorwaysGame attachedGame = null;
                GameContainerScreen attachedScreen = null;
                yield return AttachGameToFrontend(app, cityDefinition, mapDefinition, 2026u,
                    (game, screen) => { attachedGame = game; attachedScreen = screen; });

                if (attachedGame == null)
                {
                    WriteLine("[Phase10] Frontend attachment failed -- aborting the visible replay.");
                    yield break;
                }

                Player testPlayer = _isolationDiagnosticTestPlayer;
                AssertPersistenceIsolated(app, testPlayer, attachedGame, "replay-post-attach");

                for (int decisionIndex = 0; decisionIndex < fixedActions.Count; decisionIndex++)
                {
                    bool isolationOk = AssertPersistenceIsolated(app, testPlayer, attachedGame, $"replay-pre-action-decision{decisionIndex}");
                    ActionDescriptor action = isolationOk ? fixedActions[decisionIndex] : ActionDescriptor.Wait();
                    if (!isolationOk)
                    {
                        WriteLine($"[Phase10] *** ABORTING replay action at decision {decisionIndex}: AssertPersistenceIsolated FAILED. Forcing WAIT. ***");
                    }

                    bool accepted = false;
                    string applyInfo = "";
                    try { accepted = ApplyAction(attachedGame, action, out applyInfo); }
                    catch (Exception ex) { applyInfo = $"EXCEPTION: {ex}"; WriteLine($"[Phase10] EXCEPTION applying replay action {action} at decision {decisionIndex}: {ex}"); }

                    try { AdvanceSimulation(attachedGame, IpcDecisionDelta); }
                    catch (Exception ex) { WriteLine($"[Phase10] EXCEPTION during replay AdvanceSimulation at decision {decisionIndex}: {ex}"); }

                    double simTimeNow = (double)attachedGame.Simulation.GetModel<ClockModel>().Time;
                    double scoreNow = 0;
                    try { scoreNow = (double)attachedGame.Simulation.GetModel<ScoreModel>().Score; } catch { }
                    WriteLine($"[Phase10] replay decision {decisionIndex}: simTime={simTimeNow:F2} score={scoreNow} action={action} accepted={accepted} [{applyInfo}]");

                    for (int f = 0; f < 30; f++) { yield return null; }
                }

                AssertPersistenceIsolated(app, testPlayer, attachedGame, "replay-post-loop");
                WriteLine("[Phase10] Visible fixed-action replay complete. Leaving the frontend attached and suspended.");
            }
        }
    }
}
